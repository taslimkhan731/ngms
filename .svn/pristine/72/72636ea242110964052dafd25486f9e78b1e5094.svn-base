ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);
    ion-card {
        background: #F5FEF9;
        border: 0.957234px solid #A0E6A4;
        border-radius: 8px;
    
        ion-card-header {
          padding-top: 8px;
          padding-bottom: 2px;
          margin-bottom: 15px;
    
          ion-label {
            font-family: 'Exo 2';
            font-style: normal;
            font-weight: 600;
            font-size: 16px;
            line-height: 100%;
            display: flex;
            align-items: center;
            text-align: center;
            color: #0F8D4B;
    
          }
        }
    
        ion-card-content {
          .lbl {
            font-style: normal;
            font-weight: 500;
            font-size: 14.3364px;
            line-height: 17px;
            display: flex;
            align-items: center;
            color: #414042;
            margin-top: 7px;
            margin-bottom: 4px;
          }
    
          ion-radio-group {
            ion-radio {
              height: 15px;
              width: 15px;
              margin-right: 2px;
              --color-checked: #000000;
            }
    
            ion-label {
              margin-right: 10px;
            }
          }
    
          ion-grid {
            --ion-grid-padding: 0px;
    
            ion-col {
              --ion-grid-column-padding: 0px;
    
              ion-input,
              ion-textarea {
                background: #FFFFFF;
                border: 0.892779px solid #A2E6A7;
                box-shadow: inset 1.78556px 1.78556px 2.67834px rgb(86 103 113 / 29%);
                border-radius: 4.46389px;
                --padding-top: 9px;
                --padding-end: 9px;
                --padding-bottom: 5px;
                --padding-start: 9px;
              }
    
              ion-select {
                background: linear-gradient(180deg, #FFFFFF 0%, #E9EEEA 80.21%);
                border: 0.892779px solid #A2E6A7;
                border-radius: 4.46389px;
                --padding-top: 9px;
                --padding-end: 9px;
                --padding-bottom: 5px;
                --padding-start: 9px;
              }
            }
          }
        }
      }
      ion-button {
                background-color: green;
                color: white;
                // -ms-flex-align: center;
                -ms-flex-align: center;
            }
}
ion-toolbar {
    --background: darkgreen;
    color: white;
    letter-spacing: 2px;
    font-size: 16px;


    ion-icon {
        font-size: xx-large;
        color: #FFFFFF;
        padding: 3px;
        border-radius: 32px;
    }
}

.cs-input ion-input {
  border-top-right-radius: 0px !important;
  border-bottom-right-radius: 0px !important;
}

.file-upload-button {
  padding-top: 8px;
  padding-bottom: 8px;
  padding-left: 0;
  padding-right: 0;
  background: #A2E6A7;
  // font-size: 13.5px;
  color: #000000;
  width: 100%;

  input[type="file"] {
    font-size: 100px;
    left: 0;
    opacity: 0;
    position: absolute;
    top: 0;
  }
}