ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

    .content {
        .my-card {
            background: #FFFFFF;
            border: 1px solid #A1D9A3;
            box-shadow: 0px 4px 4px rgb(0 0 0 / 25%);
            border-radius: 4px;
            padding: 10px;
            color: #242121;
            margin: 10px;

            img {
                width: 80vw;
            }

            .my-cardheader {
                padding: 0px;
                margin: 5px 0px;
                font-size: 20px;
                color: green;
                font-weight: 600;
            }

            .my-cardcontent {
                text-align: start;
                padding: 0px;
                .gridClass{
                  ion-icon  {
                    color: green;
                    }
                   
                }

                .booking-btn {
                    --background: linear-gradient(156.81deg, #FFC107 -22.76%, #FF8A00 108.33%);
                    --background-activated: linear-gradient(156.81deg, #FFC107 -28.76%, #FF8A00 112.33%)
                    border-radius: 38px;
                }

                .heart-icon {
                    background: linear-gradient(156.81deg, #FFFFFF -22.76%, #FEF5EA 108.33%);
                    border: 1px solid #FEE2C1;
                    border-radius: 38px;
                    height: 40px;
                    width: 40px;
                    text-align: center;
                    padding-top: 7px;
                    font-size: 20px;
                    color: #ffae05;
                }
            }
        }
    }
}
ion-toolbar {
    --background: darkgreen;
    color: white;
    letter-spacing: 2px;
    font-size: 16px;


    ion-icon {
        font-size: xx-large;
         background: white;
        color: green;
        padding: 3px;
        border-radius: 32px;
    }
}