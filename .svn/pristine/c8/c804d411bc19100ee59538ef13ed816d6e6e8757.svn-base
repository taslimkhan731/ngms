<ion-header>
  <ion-toolbar style="background-color: darkgreen;color: white;letter-spacing: 2px;font-size: 10px !important">
    <ion-buttons slot="start">
      <ion-icon name="chevron-back-outline" (click)="goBack()"></ion-icon>
    </ion-buttons>
    <ion-title>Reason for Cancel</ion-title>
  </ion-toolbar>
</ion-header>
<ion-content>
  <form [formGroup]="form" (ngSubmit)="submit(form.value)">
    <div class="containerr">
      <ion-card>
        <ion-card-content>
          <ion-grid>
            <ion-row>
              <ion-col size="12">
                <ion-label class="label-key "><b>Reason for cancel</b></ion-label>
              </ion-col>
              <ion-col size="12">
                <ion-label class="label-value">
                  <ion-radio-group formControlName="modReason">
                    <ion-radio value='no vacancy' style="height: 16px !important;width: 16px !important;"></ion-radio>
                    <ion-label> No Vacancy </ion-label>
                    <br>
                    <ion-radio value='mismatch of document' style="height: 16px !important;width: 16px !important;">
                    </ion-radio>
                    <ion-label> Mismatch of Document</ion-label>
                    <br>
                    <ng-container *ngIf="dataComingFrom == 'Moderator'">
                      <ion-radio value='already booked' style="height: 16px !important;width: 16px !important;">
                      </ion-radio>
                      <ion-label> Already Booked</ion-label>
                      <br>
                      <ion-radio value='others' style="height: 16px !important;width: 16px !important;"></ion-radio>
                      <ion-label> others</ion-label>
                    </ng-container>
                  </ion-radio-group>
                </ion-label>
              </ion-col>
            </ion-row>
            <ion-row>
              <ion-col size="12">
                <ion-label class="label-key "><b>Remark</b></ion-label>
              </ion-col>
              <ion-col size="12" style="padding-top:0px !important">
                <ion-label class="label-value">
                  <ion-textarea placeholder="Write your remarks here.." formControlName="remarks"
                    style="color: gray;font-weight: 400;margin-top:0px">

                  </ion-textarea>
                </ion-label>
              </ion-col>
            </ion-row>
          </ion-grid>
        </ion-card-content>



      </ion-card>

      <div class="d-flex justify-content-center" style="margin-right: 10px;">
        <!-- <ion-button class="submit-btn"> Back</ion-button> -->
        <ion-button type="submit" class="cancel-btn"> Cancel</ion-button>
      </div>
    </div>
  </form>




</ion-content>