package com.stl.ngms.admin.model;

public class DataTableRequest {
	private int start;
	private int length;
	private int draw;
	private String city;
	private String gHouse;
	private String bookingId;
	private String bookingDate;
	private String purpose;
	private String mobNo;
	private String name;
	private String category;
	private String type;
	private String frmDate;
	private String toDate;
	private String cancelDate;
	private String orderBy;
	private String shiftId;
	private String createdBy;
	private String createdDate;
	
	public String getToDate() {
		return toDate;
	}
	public void setToDate(String toDate) {
		this.toDate = toDate;
	}
	public String getCancelDate() {
		return cancelDate;
	}
	public void setCancelDate(String cancelDate) {
		this.cancelDate = cancelDate;
	}
	public String getOrderBy() {
		return orderBy;
	}
	public void setOrderBy(String orderBy) {
		this.orderBy = orderBy;
	}
	public String getFrmDate() {
		return frmDate;
	}
	public void setFrmDate(String frmDate) {
		this.frmDate = frmDate;
	}
	public String getType() {
		return type;
	}
	public void setType(String type) {
		this.type = type;
	}
	public String getBookingDate() {
		return bookingDate;
	}
	public void setBookingDate(String bookingDate) {
		this.bookingDate = bookingDate;
	}
	public String getgHouse() {
		return gHouse;
	}
	public void setgHouse(String gHouse) {
		this.gHouse = gHouse;
	}
	public String getBookingId() {
		return bookingId;
	}
	public void setBookingId(String bookingId) {
		this.bookingId = bookingId;
	}
	public String getPurpose() {
		return purpose;
	}
	public void setPurpose(String purpose) {
		this.purpose = purpose;
	}
	public String getMobNo() {
		return mobNo;
	}
	public void setMobNo(String mobNo) {
		this.mobNo = mobNo;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public String getCategory() {
		return category;
	}
	public void setCategory(String category) {
		this.category = category;
	}
	public String getCity() {
		return city;
	}
	public void setCity(String city) {
		this.city = city;
	}
	public int getStart() {
		return start;
	}
	public void setStart(int start) {
		this.start = start;
	}
	public int getLength() {
		return length;
	}
	public void setLength(int length) {
		this.length = length;
	}
	public int getDraw() {
		return draw;
	}
	public void setDraw(int draw) {
		this.draw = draw;
	}
	public String getShiftId() {
		return shiftId;
	}
	public void setShiftId(String shiftId) {
		this.shiftId = shiftId;
	}
	public String getCreatedBy() {
		return createdBy;
	}
	public void setCreatedBy(String createdBy) {
		this.createdBy = createdBy;
	}
	public String getCreatedDate() {
		return createdDate;
	}
	public void setCreatedDate(String createdDate) {
		this.createdDate = createdDate;
	}
	@Override
	public String toString() {
		return "DataTableRequest [start=" + start + ", length=" + length + ", draw=" + draw + ", city=" + city
				+ ", gHouse=" + gHouse + ", bookingId=" + bookingId + ", bookingDate=" + bookingDate + ", purpose="
				+ purpose + ", mobNo=" + mobNo + ", name=" + name + ", category=" + category + ", type=" + type
				+ ", frmDate=" + frmDate + ", toDate=" + toDate + ", cancelDate=" + cancelDate + ", orderBy=" + orderBy
				+ ", shiftId=" + shiftId + ", createdBy=" + createdBy + ", createdDate=" + createdDate
				+ ", getToDate()=" + getToDate() + ", getCancelDate()=" + getCancelDate() + ", getOrderBy()="
				+ getOrderBy() + ", getFrmDate()=" + getFrmDate() + ", getType()=" + getType() + ", getBookingDate()="
				+ getBookingDate() + ", getgHouse()=" + getgHouse() + ", getBookingId()=" + getBookingId()
				+ ", getPurpose()=" + getPurpose() + ", getMobNo()=" + getMobNo() + ", getName()=" + getName()
				+ ", getCategory()=" + getCategory() + ", getCity()=" + getCity() + ", getStart()=" + getStart()
				+ ", getLength()=" + getLength() + ", getDraw()=" + getDraw() + ", getShiftId()=" + getShiftId()
				+ ", getCreatedBy()=" + getCreatedBy() + ", getCreatedDate()=" + getCreatedDate() + ", getClass()="
				+ getClass() + ", hashCode()=" + hashCode() + ", toString()=" + super.toString() + "]";
	}
	
	
}
