ion-content {
    .containerr {
        // padding: 2% 2%;

        ion-card {
            background: #FFFFFF;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            padding-bottom: 10px;

            ion-card-content {
                padding: 2px !important;

                // .label-value {
                //     font-family: "Exo 2";
                //     font-weight: 600 !important;
                //     color: black;
                // }

                table {
                    .thead th {
                        border: none !important;
                        border-left: 1px solid white !important;
                        background: linear-gradient(156.81deg, #50CB89 -22.76%, #109851 108.33%) ! important;
                        color: white;
                        padding: 4px 12px;
                    }

                    .tbody {
                        border: 1px solid #bebebe;

                        td {
                            padding: 7px;
                        }
                    }
                }

                input:focus {
                    outline: none;
                }
            }


        }
    }
}
ion-radio-group {
    // ion-radio {
    //   height: 15px;
    //   width: 15px;
    //   margin-right: 2px;
    //   --color-checked: #000000;
    // }
  
    ion-radio {
      --border-radius: 4px;
      --inner-border-radius: 4px;
  
      --color: #ddd;
      --color-checked: #108d4c !important;
      // top: 8px;
      margin-right: 10px !important;
    }
  
    ion-radio.ios::part(container) {
      width: 20px;
      height: 20px;
  
      border: 2px solid #ddd;
      border-radius: 4px;
    }
  
    .radio-checked.ios::part(container) {
      border-color: #108d4c;
    }
  
    ion-label {
      margin-right: 10px;
    }
  }