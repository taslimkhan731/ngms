<!-- <ion-toolbar>
  <ion-buttons slot="start" (click)="goBack()">
    <ion-icon name="chevron-back-outline"></ion-icon>
  </ion-buttons>
  <ion-title class="logo-text">Feedback Details</ion-title>
</ion-toolbar> -->
<ion-header>
  <ion-toolbar>
    <ion-buttons slot="start" (click)="goBack()">
      <ion-icon name="chevron-back-outline"></ion-icon>
    </ion-buttons>
    <ion-title>Feedback Details</ion-title>
    </ion-toolbar>
    </ion-header>
<ion-content>
  <ion-card class="my-card">
    <ion-accordion-group value="first">
      <ion-accordion value="first">
        <ion-item slot="header" style="--background: #e8fee8;">
          <ion-label style="font-family: 'Exo 2' !important; font-style: normal; font-weight: 600; color: #0F8D4B;">Verify
            Details</ion-label>
        </ion-item>
        <div slot="content" class="insideAccordian">
          <ion-row style="padding-left: 6px;" *ngIf="responseData[0]?.status=='Closed';else else_part">
            <ion-col size="12">
              <ion-label class="label-key" style="font-family: 'Exo 2' !important; font-style: normal;">Booking Id</ion-label><br>
              <ion-label class="label-value">{{responseData[0]?.requestId}}</ion-label>
            </ion-col>
            <ion-col size="12">
              <ion-label class="label-key" style="font-family: 'Exo 2' !important; font-style: normal;">Replied Description</ion-label><br>
              <ion-label class="label-value">{{responseData[0]?.repliedSms}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key" style="font-family: 'Exo 2' !important; font-style: normal;">Replied By</ion-label><br>
              <ion-label class="label-value">{{responseData[0]?.repliedByRole}}(
                {{responseData[0]?.repliedByUserId}})</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key" style="font-family: 'Exo 2' !important; font-style: normal;">Replied On</ion-label><br>
              <ion-label class="label-value">{{responseData[0]?.repliedOn}}</ion-label>
            </ion-col>
          </ion-row>
          <ng-template #else_part>
            <ion-row style="padding-left: 6px;">
              <ion-col size="12" style="text-align: center;padding: 20px;">
                <ion-label class="label-value" style="font-family: 'Exo 2' !important; font-style: normal; font-weight: 600;">No Data Available</ion-label>
              </ion-col>
            </ion-row>
          </ng-template>
        </div>
      </ion-accordion>
    </ion-accordion-group>
  </ion-card>
  <ion-card class="my-card">
    <ion-card-content class="contentClass" style=" background: #f7ede8;">
      <ion-row style="padding-left: 6px;">
        <ion-col size="6">
          <ion-label class="label-key">Booking Id</ion-label><br>
          <ion-label class="label-value">{{responseData[0]?.requestId}}</ion-label>
        </ion-col>
        <ion-col size="6">
          <ion-label class="label-key">Feedback Id</ion-label><br>
          <ion-label class="label-value">{{responseData[0]?.feedbackId}}</ion-label>
        </ion-col>
      </ion-row>
      <ion-row style="padding-left: 6px;">
        <ion-col size="6">
          <ion-label class="label-key">Name</ion-label><br>
          <ion-label class="label-value">{{feedbackData?.name}}</ion-label>
        </ion-col>
        <ion-col size="6">
          <ion-label class="label-key">Submitted On</ion-label><br>
          <ion-label class="label-value">{{responseData[0]?.submittedOn}}</ion-label>
        </ion-col>
      </ion-row>
    </ion-card-content>
  </ion-card>
  <ion-card class="my-card">
    <ion-card-content class="contentClass">
      <ion-item>
        <ion-label>Ease of checkIn & checkOut</ion-label>
        <ion-label slot="end"><img height="28px"
            [src]="getImage(responseData[0]?.checkincheckout)">({{getValue(responseData[0]?.checkincheckout)}})</ion-label>
      </ion-item>
      <ion-item>
        <ion-label>Up Keep Of The Room</ion-label>
        <ion-label slot="end"><img height="28px"
            [src]="getImage(responseData[0]?.housekeeping)">({{getValue(responseData[0]?.housekeeping)}})</ion-label>
      </ion-item>
      <ion-item>
        <ion-label>Cleanliness And Hygiene</ion-label>
        <ion-label slot="end"><img height="28px"
            [src]="getImage(responseData[0]?.clean)">({{getValue(responseData[0]?.clean)}})</ion-label>
      </ion-item>
      <ion-item>
        <ion-label>Quality Of Food</ion-label>
        <ion-label slot="end"><img height="28px"
            [src]="getImage(responseData[0]?.food)">({{getValue(responseData[0]?.food)}})</ion-label>
      </ion-item>
      <ion-item lines="none">
        <ion-label>Conduct Of Staff</ion-label>
        <ion-label slot="end"><img height="28px"
            [src]="getImage(responseData[0]?.conduct)">({{getValue(responseData[0]?.conduct)}})</ion-label>
      </ion-item>
    </ion-card-content>
  </ion-card>
  <ion-card class="my-card">
    <ion-card-header style="padding-bottom: 0px !important;">
      <ion-card-title>Comment</ion-card-title>
    </ion-card-header>
    <ion-card-content class="contentClass" style="padding-left: 11px;padding-right: 11px;padding-bottom: 11px;">
      <ion-textarea readonly="true" [value]="responseData[0]?.feedbacksms"></ion-textarea>
    </ion-card-content>
  </ion-card>
</ion-content>