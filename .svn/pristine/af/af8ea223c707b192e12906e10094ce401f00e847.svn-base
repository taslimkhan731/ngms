<ion-toolbar style="background-color: darkgreen;color: white;letter-spacing: 2px;font-size: 10px !important">
  <ion-buttons slot="start">
    <ion-icon name="chevron-back-outline" (click)="goBack()"></ion-icon>
  </ion-buttons>
  <ion-title style="text-transform: capitalize;" *ngIf="type=='ADD'">Add Vehicle</ion-title>
  <ion-title style="text-transform: capitalize;" *ngIf="type=='EDIT'">Edit Vehicle</ion-title>
</ion-toolbar>
<ion-content>
  <form [formGroup]="myform">
    <div class="containerr" *ngIf="type =='ADD'">
      <ion-card>
        <ng-container *ngIf="vehicleData?.arrival == '1'">
          <ion-card-header>
            <ion-label><ion-checkbox style="margin-right:5px" value="arrCheckBox" checked="true"
                (ionChange)="conveyanceCheck($event)" labelPlacement="end"></ion-checkbox>Arrival Details</ion-label>
          </ion-card-header>
          <ion-card-content style="padding: 0px !important;" *ngIf="myform.get('arrCheckBox').value == 1">
            <ng-container>
              <!-- <ion-card style="margin-top:0px !important; border: 0.957234px solid #A0E6A4;">
                <ion-card-content> -->
              <ion-row style="padding-left: 6px;">
                <ion-col size="6"> <ion-label class="label-key">Request Id</ion-label></ion-col>
                <ion-col size="6"><ion-label class="label-value">{{vehicleData?.reqId}}</ion-label></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6"><ion-label class="label-key">Time Of Report</ion-label></ion-col>
                <ion-col size="6"><ion-label
                    class="label-value">{{vehicleData?.arrivalDetails?.stratTime}}</ion-label></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6"><ion-label class="label-key">Place Of Report</ion-label></ion-col>
                <ion-col size="6"><ion-label class="label-value">{{vehicleData?.arrivalDetails?.place}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="text-align: center;">
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#ffffff','text-transform':'capitalize','--background':'#28a745','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                    (click)="selectDriver('arr')">Select Driver/Protocol</ion-button>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle Details </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" placeholder=""
                    formControlName="arrVehDetails"></ion-input></ion-col>
                <div class="text-error text-danger"
                  *ngIf="((myform.controls.arrVehDetails.touched || myform.controls.arrVehDetails.dirty) && myform.controls.arrVehDetails.invalid) || isSubmitBtnClicked == true">
                  <span class="text-danger" *ngIf="myform.controls.arrVehDetails.errors?.required">*required</span>
                </div>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle Number </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="arrVehicleNo"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Protocol Name </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="arrProName"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Protocol Mobile No </ion-label></ion-col>
                <ion-col size="7"><ion-input type="tel" formControlName="arrProNo"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Driver Name </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="arrDriverName"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Driver Mobile No </ion-label></ion-col>
                <ion-col size="7"><ion-input type="tel" formControlName="arrDriverNo"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle Start time </ion-label></ion-col>
                <ion-col size="7"><ion-input type="datetime-local" formControlName="arrStartTime"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle End time </ion-label></ion-col>
                <ion-col size="7"><ion-input type="datetime-local" formControlName="arrEndTime"></ion-input></ion-col>
              </ion-row>

              <!-- </ion-card-content>
              </ion-card> -->
            </ng-container>

          </ion-card-content>
        </ng-container>
        <ng-container *ngIf="vehicleData?.departure == '1'">
          <ion-card-header>
            <ion-label><ion-checkbox style="margin-right:5px" value="depCheckBox" checked="true"
                (ionChange)="conveyanceCheck($event)" labelPlacement="end"></ion-checkbox>Departure Details</ion-label>
          </ion-card-header>
          <ion-card-content *ngIf="myform.get('depCheckBox').value == 1">
            <ng-container>
              <!-- <ion-card style="margin-top:0px !important; border: 0.957234px solid #A0E6A4;">
                <ion-card-content> -->
              <ion-row style="padding-left: 6px;">
                <ion-col size="6"> <ion-label class="label-key">Request Id</ion-label></ion-col>
                <ion-col size="6"><ion-label class="label-value">{{vehicleData?.reqId}}</ion-label></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6"><ion-label class="label-key">Time Of Report</ion-label></ion-col>
                <ion-col size="6"><ion-label
                    class="label-value">{{vehicleData?.departureDetails?.stratTime}}</ion-label></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6"><ion-label class="label-key">Place Of Report</ion-label></ion-col>
                <ion-col size="6"><ion-label class="label-value">{{vehicleData?.departureDetails?.place}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="text-align: center;">
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#ffffff','text-transform':'capitalize','--background':'#28a745','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                    (click)="selectDriver('dep')">Select Driver/Protocol</ion-button>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle Details </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="depVehDetails"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle Number </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="depVehicleNo"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Protocol Name </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="depProName"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Protocol Mobile No </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="depProNo"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Driver Name </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="depDriverName"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Driver Mobile No </ion-label></ion-col>
                <ion-col size="7"><ion-input type="text" formControlName="depDriverNo"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle Start time </ion-label></ion-col>
                <ion-col size="7"><ion-input type="datetime-local" formControlName="depStartTime"></ion-input></ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="5"><ion-label class="label-key">Vehicle End time </ion-label></ion-col>
                <ion-col size="7"><ion-input type="datetime-local" formControlName="depEndTime"></ion-input></ion-col>
              </ion-row>

              <!-- </ion-card-content>
              </ion-card> -->
            </ng-container>

          </ion-card-content>
        </ng-container>
      </ion-card>
      <div class="d-flex justify-content-center" style="margin-right: 10px;">
        <ion-button class="submit-btn" (click)="submitVehicleAllotment(myform.value)">ADD</ion-button>
      </div>
    </div>
    <div class="containerr" *ngIf="type =='EDIT'">
      <ion-card>
        <!-- <ion-radio-group (ionChange)="conveyanceRadio($event)"> -->
        <ng-container *ngFor="let data of dataForEdit">
          <ng-container *ngIf="data.tripStatus == 'A'">
            <div [ngStyle]="{'display': myform.get('depRadio').value == 1 ? 'none' : 'block'}">
              <ion-card-header>
                <ion-label><ion-radio-group (ionChange)="conveyanceRadio($event)">
                  <ion-radio style="margin-right:5px" value="arrRadio" labelPlacement="stacked"
                    alignment="end"></ion-radio></ion-radio-group>
                  Arrival Details
                </ion-label>
              </ion-card-header>
              <ion-card-content>
                <ng-container>
                  <!-- <ion-card style="margin-top:0px !important; border: 0.957234px solid #A0E6A4;">
                  <ion-card-content> -->
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="6"> <ion-label class="label-key">Request Id</ion-label></ion-col>
                    <ion-col size="6"><ion-label class="label-value">{{data?.reqId}}</ion-label></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="6"><ion-label class="label-key">Time Of Report</ion-label></ion-col>
                    <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'A' ? data?.unexceptedTime :
                        data?.reqTime}}</ion-label></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="6"><ion-label class="label-key">Place Of Report</ion-label></ion-col>
                    <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'A' ? data?.unexceptedPlace :
                        data?.place}}</ion-label>
                    </ion-col>
                  </ion-row>
                  <ion-row style="text-align: center;">
                    <ion-col>
                      <ion-button
                        [ngStyle]="{'color':'#ffffff','text-transform':'capitalize','--background':'#28a745','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                        (click)="selectDriver('arr')">Select Driver/Protocol</ion-button>
                    </ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle Details </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrVehDetails"></ion-input></ion-col>
                    <div class="text-error text-danger"
                      *ngIf="((myform.controls.arrVehDetails.touched || myform.controls.arrVehDetails.dirty) && myform.controls.arrVehDetails.invalid) || isSubmitBtnClicked == true">
                      <span class="text-danger" *ngIf="myform.controls.arrVehDetails.errors?.required">*required</span>
                    </div>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle Number </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrVehicleNo"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Protocol Name </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrProName"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Protocol Mobile No </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrProNo"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Driver Name </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrDriverName"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Driver Mobile No </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrDriverNo"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle Start time </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="datetime-local"
                        formControlName="arrStartTime"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle End time </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="datetime-local"
                        formControlName="arrEndTime"></ion-input></ion-col>
                  </ion-row>
                  <!-- <ng-container *ngIf="data.departure=='1'"></ng-container> -->

                  <!-- </ion-card-content>
                </ion-card> -->
                </ng-container>
              </ion-card-content>
              <div [ngStyle]="{'display':this.myform.get('arrRadio').value == 1 ? 'block' : 'none'}"
                style="margin-right: 10px;">
                <div class="d-flex justify-content-center">
                  <ion-button class="submit-btn" *ngIf="data.tripStatus == 'A'"
                    (click)="editVehicleAllotment(myform.value)">Update</ion-button>
                  <ion-button class="submit-btn" *ngIf="data.tripStatus !== 'A'"
                    (click)="submitVehicleAllotment(myform.value)">Add</ion-button>
                </div>
              </div>
            </div>
          </ng-container>
          <ng-container *ngIf="data.tripStatus == 'A' && data.departure == '1' && dataForEdit.length == 1">
            <div [ngStyle]="{'display':this.myform.get('arrRadio').value == 1 ? 'none' : 'block'}">
              <ion-card-header>
                <ion-label>
                  <ion-radio-group (ionChange)="conveyanceRadio($event)">
                    <ion-radio style="margin-right:5px" value="depRadio" labelPlacement="stacked"
                      alignment="end"></ion-radio></ion-radio-group>
                  Departure Details</ion-label>
              </ion-card-header>
              <ion-card-content>
                <ng-container>
                  <!-- <ion-card style="margin-top:0px !important; border: 0.957234px solid #A0E6A4;">
                    <ion-card-content> -->
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="6"> <ion-label class="label-key">Request Id</ion-label></ion-col>
                        <ion-col size="6"><ion-label class="label-value">{{data?.reqId}}</ion-label></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="6"><ion-label class="label-key">Time Of Report</ion-label></ion-col>
                        <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'D' ?
                            data?.unexceptedTime :data?.reqTime}}</ion-label></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="6"><ion-label class="label-key">Place Of Report</ion-label></ion-col>
                        <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'D' ?
                            data?.unexceptedPlace :data?.place}}</ion-label>
                        </ion-col>
                      </ion-row>
                      <ion-row style="text-align: center;">
                        <ion-col>
                          <ion-button
                            [ngStyle]="{'color':'#ffffff','text-transform':'capitalize','--background':'#28a745','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                            (click)="selectDriver('dep')">Select Driver/Protocol</ion-button>
                        </ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle Details </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depVehDetails"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle Number </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depVehicleNo"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Protocol Name </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depProName"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Protocol Mobile No </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depProNo"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Driver Name </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depDriverName"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Driver Mobile No </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depDriverNo"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle Start time </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="datetime-local"
                            formControlName="depStartTime"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle End time </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="datetime-local"
                            formControlName="depEndTime"></ion-input></ion-col>
                      </ion-row>

                    <!-- </ion-card-content>
                  </ion-card> -->
                </ng-container>

              </ion-card-content>

              <div [ngStyle]="{'display':this.myform.get('depRadio').value == 1 ? 'block' : 'none'}"
                style="margin-right: 10px;">
                <div class="d-flex justify-content-center">
                  <ion-button class="submit-btn" *ngIf="data.tripStatus == 'D'"
                    (click)="editVehicleAllotment(myform.value)">Update</ion-button>
                  <ion-button class="submit-btn" *ngIf="data.tripStatus !== 'D'"
                    (click)="submitVehicleAllotment(myform.value)">Add</ion-button>
                </div>
              </div>
            </div>
          </ng-container>
          <ng-container *ngIf="data.tripStatus == 'D' && data.arrival == '1' && dataForEdit.length == 1">
            <div [ngStyle]="{'display': myform.get('depRadio').value == 1 ? 'none' : 'block'}">
              <ion-card-header>
                <ion-label><ion-radio-group (ionChange)="conveyanceRadio($event)">
                  <ion-radio style="margin-right:5px" value="arrRadio" labelPlacement="stacked"
                    alignment="end"></ion-radio></ion-radio-group>
                  Arrival Details
                </ion-label>
              </ion-card-header>
              <ion-card-content>
                <ng-container>
                  <!-- <ion-card style="margin-top:0px !important; border: 0.957234px solid #A0E6A4;">
                  <ion-card-content> -->
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="6"> <ion-label class="label-key">Request Id</ion-label></ion-col>
                    <ion-col size="6"><ion-label class="label-value">{{data?.reqId}}</ion-label></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="6"><ion-label class="label-key">Time Of Report</ion-label></ion-col>
                    <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'A' ? data?.unexceptedTime :
                        data?.reqTime}}</ion-label></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="6"><ion-label class="label-key">Place Of Report</ion-label></ion-col>
                    <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'A' ? data?.unexceptedPlace :
                        data?.place}}</ion-label>
                    </ion-col>
                  </ion-row>
                  <ion-row style="text-align: center;">
                    <ion-col>
                      <ion-button
                        [ngStyle]="{'color':'#ffffff','text-transform':'capitalize','--background':'#28a745','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                        (click)="selectDriver('arr')">Select Driver/Protocol</ion-button>
                    </ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle Details </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrVehDetails"></ion-input></ion-col>
                    <div class="text-error text-danger"
                      *ngIf="((myform.controls.arrVehDetails.touched || myform.controls.arrVehDetails.dirty) && myform.controls.arrVehDetails.invalid) || isSubmitBtnClicked == true">
                      <span class="text-danger" *ngIf="myform.controls.arrVehDetails.errors?.required">*required</span>
                    </div>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle Number </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrVehicleNo"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Protocol Name </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrProName"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Protocol Mobile No </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrProNo"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Driver Name </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrDriverName"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Driver Mobile No </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="text" formControlName="arrDriverNo"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle Start time </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="datetime-local"
                        formControlName="arrStartTime"></ion-input></ion-col>
                  </ion-row>
                  <ion-row style="padding-left: 6px;">
                    <ion-col size="5"><ion-label class="label-key">Vehicle End time </ion-label></ion-col>
                    <ion-col size="7"><ion-input type="datetime-local"
                        formControlName="arrEndTime"></ion-input></ion-col>
                  </ion-row>
                  <!-- <ng-container *ngIf="data.departure=='1'"></ng-container> -->

                  <!-- </ion-card-content>
                </ion-card> -->
                </ng-container>
              </ion-card-content>
              <div [ngStyle]="{'display':this.myform.get('arrRadio').value == 1 ? 'block' : 'none'}"
                style="margin-right: 10px;">
                <div class="d-flex justify-content-center">
                  <ion-button class="submit-btn" *ngIf="data.tripStatus == 'A'"
                    (click)="editVehicleAllotment(myform.value)">Update</ion-button>
                  <ion-button class="submit-btn" *ngIf="data.tripStatus !== 'A'"
                    (click)="submitVehicleAllotment(myform.value)">Add</ion-button>
                </div>
              </div>
            </div>
          </ng-container>
          <ng-container *ngIf="data.tripStatus == 'D'">
            <div [ngStyle]="{'display':this.myform.get('arrRadio').value == 1 ? 'none' : 'block'}">
              <ion-card-header>
                <ion-label>
                  <ion-radio-group (ionChange)="conveyanceRadio($event)">
                    <ion-radio style="margin-right:5px" value="depRadio" labelPlacement="stacked"
                      alignment="end"></ion-radio></ion-radio-group>
                  Departure Details</ion-label>
              </ion-card-header>
              <ion-card-content>
                <ng-container>
                  <!-- <ion-card style="margin-top:0px !important; border: 0.957234px solid #A0E6A4;">
                    <ion-card-content> -->
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="6"> <ion-label class="label-key">Request Id</ion-label></ion-col>
                        <ion-col size="6"><ion-label class="label-value">{{data?.reqId}}</ion-label></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="6"><ion-label class="label-key">Time Of Report</ion-label></ion-col>
                        <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'D' ?
                            data?.unexceptedTime :data?.reqTime}}</ion-label></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="6"><ion-label class="label-key">Place Of Report</ion-label></ion-col>
                        <ion-col size="6"><ion-label class="label-value">{{data.tripStatus !== 'D' ?
                            data?.unexceptedPlace :data?.place}}</ion-label>
                        </ion-col>
                      </ion-row>
                      <ion-row style="text-align: center;">
                        <ion-col>
                          <ion-button
                            [ngStyle]="{'color':'#ffffff','text-transform':'capitalize','--background':'#28a745','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                            (click)="selectDriver('dep')">Select Driver/Protocol</ion-button>
                        </ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle Details </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depVehDetails"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle Number </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depVehicleNo"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Protocol Name </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depProName"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Protocol Mobile No </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depProNo"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Driver Name </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depDriverName"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Driver Mobile No </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="text" formControlName="depDriverNo"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle Start time </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="datetime-local"
                            formControlName="depStartTime"></ion-input></ion-col>
                      </ion-row>
                      <ion-row style="padding-left: 6px;">
                        <ion-col size="5"><ion-label class="label-key">Vehicle End time </ion-label></ion-col>
                        <ion-col size="7"><ion-input type="datetime-local"
                            formControlName="depEndTime"></ion-input></ion-col>
                      </ion-row>
<!-- 
                    </ion-card-content>
                  </ion-card> -->
                </ng-container>

              </ion-card-content>

              <div [ngStyle]="{'display':this.myform.get('depRadio').value == 1 ? 'block' : 'none'}"
                style="margin-right: 10px;">
                <div class="d-flex justify-content-center">
                  <ion-button class="submit-btn" *ngIf="data.tripStatus == 'D'"
                    (click)="editVehicleAllotment(myform.value)">Update</ion-button>
                  <ion-button class="submit-btn" *ngIf="data.tripStatus !== 'D'"
                    (click)="submitVehicleAllotment(myform.value)">Add</ion-button>
                </div>
              </div>
            </div>
          </ng-container>
        </ng-container>
        <!-- </ion-radio-group> -->

      </ion-card>
      <!-- <div class="d-flex justify-content-center" style="margin-right: 10px;">
        <ion-button class="submit-btn" (click)="editVehicleAllotment(myform.value)">Update</ion-button>
        <ion-button class="submit-btn" (click)="submitVehicleAllotment(myform.value)">Add</ion-button>
      </div> -->
    </div>
  </form>
</ion-content>