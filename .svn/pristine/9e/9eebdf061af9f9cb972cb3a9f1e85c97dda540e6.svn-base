<ion-split-pane contentId="main-content">
	<ion-menu contentId="main-content">
		<ion-content>
			<ion-refresher slot="fixed" (ionRefresh)="refreshing($event)">
				<ion-refresher-content></ion-refresher-content>
			</ion-refresher>
			<ion-menu-toggle>
				<ion-item class="profile mt-2" (click)="getProfile()">
					<ion-thumbnail>
						<ion-img src="../../assets/icon/user.png" style="border-radius: 23px;"></ion-img>
					</ion-thumbnail>
					<ion-label style="padding-left:20px ;font-size:17px">{{userName}}</ion-label>
					<ion-icon name="chevron-forward" float="right"></ion-icon>
				</ion-item>
			</ion-menu-toggle>
			<ng-container *ngFor="let menu of menus; let i = index">
				<ion-menu-toggle *ngIf="!menu.submenus?.length" auto-hide="false">
					<!-- <ion-item class="List" routerDirection="root" lines="inset" detail="false" (click)="getUrl(menu)"
						routerLinkActive="menu.title == selectedMenu" [class.selected]="menu.title == selectedMenu"> -->
					<ion-item class="List" routerDirection="root" lines="inset" detail="false" [routerLink]="menu?.url"
						routerLinkActive="selected">
						<ion-icon slot="start" [ios]="menu.icon + '-outline'" [md]="menu.icon + '-sharp'">
						</ion-icon>
						<ion-label>{{ menu.title }} </ion-label>
					</ion-item>
				</ion-menu-toggle>

				<ion-accordion-group *ngIf="menu.submenus?.length">
					<ion-accordion value="menu.title" *ngIf="menu.submenus?.length" style="background-color: green;">
						<ion-item slot="header" class="List" lines="none">
							<ion-icon slot="start" [ios]="menu.icon + '-outline'" [md]="menu.icon + '-sharp'">
							</ion-icon>
							<ion-label>{{menu.title}}</ion-label>
						</ion-item>
						<div class="ion-padding" slot="content" style="background-color: green;">
							<ion-menu-toggle auto-hide="true" *ngFor="let submenu of menu.submenus; let i = index"
								style="background-color: green;">
								<!-- <ion-item class="" routerDirection="root" lines="none" detail="false"
									(click)="getUrl(submenu)" routerLinkActive="submenu.title == selectedMenu"
									[class.selected]="submenu.title == selectedMenu"> -->
								<ion-item class="" routerDirection="root" lines="none" detail="false"
									[routerLink]="submenu?.url" routerLinkActive="selected">
									<ion-icon slot="start" [ios]="submenu.icon + '-outline'"
										[md]="submenu.icon + '-sharp'"></ion-icon>
									<ion-label>{{ submenu.title }} </ion-label>
								</ion-item>
							</ion-menu-toggle>
						</div>
					</ion-accordion>
				</ion-accordion-group>
			</ng-container>
			<ion-menu-toggle auto-hide="false">
				<ion-item lines="full" (click)="logout()">
					<ion-icon slot="start" [ios]="'log-out-outline'" [md]="'log-out-sharp'"></ion-icon>
					<ion-label>Logout</ion-label>
				</ion-item>
			</ion-menu-toggle>
		</ion-content>
	</ion-menu>
	<ion-router-outlet id="main-content" class="router-outlet"></ion-router-outlet>
</ion-split-pane>