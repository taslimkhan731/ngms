ion-content {
    --background: #fff;

    .content {
        .filter {
            background-color: #43a843;
            border-radius: 5px;

            .date {
                position: relative;
                top: 11px;
                color: white;
                display: flex;
                justify-content: center;
                font-size: 16px;
                font-weight: 100 !important;
            }

            ion-button {
                --background: green;
            }
        }

        ion-card {
            ion-card-title {

                .heading {
                    color: black;
                    font-weight: 600 !important;
                }

                .list-icon {
                    border-radius: 5px;
                    display: flex;
                    justify-content: center;
                    position: relative;
                    top: -5px;

                    ion-icon {
                        font-size: 30px;
                    }
                }
            }

            ion-card-content {
                .label {
                    display: flex;
                    justify-content: right;
                    font-size: 16px;
                    margin-top: 3px;
                }
            }
        }

        .card-1 {
            border: 1px solid rgba(54, 152, 183, 1);
            background: linear-gradient(180deg, #E1FCFC 0%, #F7FFF0 100%);
            box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);

            ion-card-title {
                border-bottom: 1px solid rgba(54, 152, 183, 1);

                .list-icon {
                    border: 2px solid rgba(54, 152, 183, 1);

                    ion-icon {
                        color: rgba(54, 152, 183, 1);
                    }
                }

            }

            ion-card-content {
                .value {
                    border: 1px solid rgba(54, 152, 183, 1);
                    border-radius: 5px;
                    background-color: #BDFFFB;
                    height: 29px;
                    color: rgba(11, 99, 126, 1);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    font-size: 16px;
                }
            }
        }

        .card-2 {
            border: 1px solid rgba(74, 185, 126, 1);
            background: linear-gradient(180deg, #E1FCE8 0%, #F7FFF0 100%);
            box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);

            ion-card-title {
                border-bottom: 1px solid rgba(74, 185, 126, 1);

                .list-icon {
                    border: 2px solid rgba(74, 185, 126, 1);

                    ion-icon {
                        color: rgba(74, 185, 126, 1);
                    }
                }

            }

            ion-card-content {
                .value {
                    border: 1px solid rgba(74, 185, 126, 1);
                    border-radius: 5px;
                    background-color: #A1F9CA;
                    height: 29px;
                    color: rgba(7, 80, 10, 1);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    font-size: 16px;
                }
            }
        }

        .card-3 {
            border: 1px solid rgba(204, 207, 129, 1);
            background: linear-gradient(180deg, #FBFCE1 0%, #FAFFF7 100%);
            box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);

            ion-card-title {
                border-bottom: 1px solid rgba(204, 207, 129, 1);

                .list-icon {
                    border: 2px solid rgba(204, 207, 129, 1);

                    ion-icon {
                        color: rgba(204, 207, 129, 1);
                    }
                }

            }

            ion-card-content {
                .value {
                    border: 1px solid rgba(204, 207, 129, 1);
                    border-radius: 5px;
                    background-color: #DBFFA1;
                    height: 29px;
                    color: rgba(71, 109, 8, 1);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    font-size: 16px;
                }
            }
        }

        .card-4 {
            border: 1px solid rgba(249, 129, 151, 1);
            background: linear-gradient(180deg, #FFEBEB 0%, #FFEBEB 0.01%, #FFFAF5 100%);
            box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);

            ion-card-title {
                border-bottom: 1px solid rgba(249, 129, 151, 1);

                .list-icon {
                    border: 2px solid rgba(249, 129, 151, 1);

                    ion-icon {
                        color: rgba(249, 129, 151, 1);
                    }
                }

            }

            ion-card-content {
                .value {
                    border: 1px solid rgba(249, 129, 151, 1);
                    border-radius: 5px;
                    background-color: #FFD7E0;
                    height: 29px;
                    color: rgb(184, 69, 90);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    font-size: 16px;
                }
            }
        }

        ion-modal {
            .filter-div {
                margin-top: 5px;

                .ion-label {
                    position: relative;
                    left: 13px;
                    font-size: 18px;
                }
            }
        }


        // ion-popover {
        //     --width: 85%;
        //     position: absolute;
        //     top: 5px;
        //     right: -14px;
        // }
    }
}