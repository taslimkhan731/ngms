<ion-header>
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button auto-hide="false"></ion-menu-button>
    </ion-buttons>
    <ion-title style="font-size: 115%;">{{selectedValue=='Receipt' ? 'Generate Receipt' :'Receipt List'}}
    </ion-title>
    <ion-button slot="end" id="filtermodal-modal" (click)="openFilterModal()">
      <ion-icon name="filter-outline"></ion-icon>&nbsp;Filter
    </ion-button>
  </ion-toolbar>
</ion-header>
<ion-content>
  <ion-refresher slot="fixed" (ionRefresh)="filterHandleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>
  <div class="content">
    <div>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select placeholder="Select City" [(ngModel)]="selectCity" interface="action-sheet"
          (ionChange)="getGuestHouseList($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.cityId
            *ngFor="let item of getAllCityList">{{item.cityName}}</ion-select-option>
        </ion-select>
      </ion-item>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select Guest House" [(ngModel)]="selectGH"
          (ionChange)="getBhawanName($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.id *ngFor="let item of guestHouseList">{{item.name}}</ion-select-option>
        </ion-select>
      </ion-item>
    </div>
    <!-- <div class="mt-1 filterCls">
        <ion-row>
          <ion-col size="6" class=" mt-2" class="lebel">
            Data Entry List
          </ion-col>
          <ion-col size="6" class="ion-text-end ">
            <ion-button ><ion-icon name="reload-circle-sharp"></ion-icon></ion-button>
            <ion-button (click)="presentPopover($event)"><ion-icon name="search-circle-sharp"></ion-icon></ion-button>
          </ion-col>
        </ion-row>
      </div> -->
    <div class="cardHeight">
      <div *ngIf="selectedValue=='Receipt'">
        <ng-container *ngIf="recieptData.length">
        <ion-card *ngFor="let data of recieptData " class="mt-1">
          <ion-card-content>
            <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">Bill ID</ion-label><br>
                <ion-label class="label-value">{{data.billId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Bill No</ion-label><br>
                <ion-label class="label-value">{{data.billNo}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Generated By</ion-label><br>
                <ion-label class="label-value">{{data.createdBy}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Bill Date</ion-label><br>
                <ion-label class="label-value">{{data.date}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Booking ID</ion-label><br>
                <ion-label class="label-value">{{data.bookingId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Category</ion-label><br>
                <ion-label class="label-value">{{data.category}}</ion-label>
              </ion-col>
              <ion-col size="12">
                <ion-label class="label-key">Name</ion-label><br>
                <ion-label class="label-value">{{data.name}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Stayed From</ion-label><br>
                <ion-label class="label-value">{{data.fromDate}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Stayed To</ion-label><br>
                <ion-label class="label-value">{{data.toDate}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Room</ion-label><br>
                <ion-label class="label-value">{{data.roomNo}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Amount</ion-label><br>
                <ion-label class="label-value">{{data.total}}</ion-label>
              </ion-col>
            </ion-row>
            <div>
              <ion-grid>
                <ion-row>
                  <ion-col size="6">
                    <ion-button
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','--background-activated':'#E1EDFF','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}"
                      (click)="getbutton('View',data)">
                      View
                    </ion-button>
                  </ion-col>
                  <ion-col size="6">
                    <ion-button
                      [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','--background-activated':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}"
                      (click)="getbutton('Delete',data)">
                      Cancel
                    </ion-button>
                  </ion-col>
                </ion-row>
              </ion-grid>
            </div>
          </ion-card-content>
        </ion-card>
        <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
          <ion-icon name="chevron-up-outline"></ion-icon>
        </div>

        <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Receipt')" [threshold]="250">
          <ion-infinite-scroll-content loadingSpinner="bubbles"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
        </ion-infinite-scroll>
      </ng-container>
      <div *ngIf="!recieptData?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </div>
      </div>
      <div *ngIf="selectedValue=='Receipt List'">
        <ng-container *ngIf="recieptList.length">
          <ion-card *ngFor="let data of recieptList " class="mt-1">
          <ion-card-content>
            <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">Receipt ID</ion-label><br>
                <ion-label class="label-value">{{data.recId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Receipt Date</ion-label><br>
                <ion-label class="label-value">{{data.rectDate}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Bill ID</ion-label><br>
                <ion-label class="label-value">{{data.billId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Booking ID</ion-label><br>
                <ion-label class="label-value">{{data.bookingId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Category</ion-label><br>
                <ion-label class="label-value">{{data.category}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Name</ion-label><br>
                <ion-label class="label-value">{{data.name}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Stayed From</ion-label><br>
                <ion-label class="label-value">{{data.fromDate}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Stayed To</ion-label><br>
                <ion-label class="label-value">{{data.toDate}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Room</ion-label><br>
                <ion-label class="label-value">{{data.roomNo}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Total Amount</ion-label><br>
                <ion-label class="label-value">{{data.total}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Paid Amount</ion-label><br>
                <ion-label class="label-value">{{data.paidAmount}}</ion-label>
              </ion-col>
            </ion-row>
            <div>
              <ion-grid>
                <ion-row>
                  <ion-col size="12">
                    <ion-button
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','--background-activated':'#E1EDFF','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}"
                      (click)="getbutton('viewReceipt',data)">
                      View
                    </ion-button>
                  </ion-col>
                </ion-row>
              </ion-grid>
            </div>
          </ion-card-content>
        </ion-card>
        <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
          <ion-icon name="chevron-up-outline"></ion-icon>
        </div>

        <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Receipt List')" [threshold]="250">
          <ion-infinite-scroll-content loadingSpinner="bubbles"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
        </ion-infinite-scroll>
      </ng-container>
      <div *ngIf="!recieptList?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </div>
      </div>
    </div>
  </div>

  <ion-modal #filtermodal>
    <ng-template>
      <ion-header>
        <ion-toolbar>
          <ion-buttons slot="start">
            <ion-button (click)="cancel()">
              <ion-icon style="color: #ffffff;" name="arrow-back"></ion-icon>
            </ion-button>
          </ion-buttons>
          <ion-title>Search</ion-title>
        </ion-toolbar>
      </ion-header>
      <ion-content class="ion-padding">
        <form [formGroup]="filterForm" (ngSubmit)="submitFilterForm(filterForm.value)">
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Booking ID</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Booking ID" formControlName="bookingId" (keyup)="transformText($event)"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">From Date</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="date" formControlName="fromDate"></ion-input>
            </ion-item>
          </div>
          
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Category</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-select interface="action-sheet" placeholder="Select Category"
                [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}" formControlName="category">
                <ion-select-option [value]=list.purposeId
                  *ngFor="let list of categoryList">{{list.purposeName}}</ion-select-option>
              </ion-select>
            </ion-item>
          </div>
          

          
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Mobile Number</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" inputmode="numeric" maxlength="10" placeholder="Mobile Number" formControlName="mobNo"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Guest Name</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Guest Name" formControlName="name"></ion-input>
            </ion-item>
          </div>
          <ion-button type="submit" expand="block" style="margin: 20px 0px 0px 6px !important;
          width: 96% !important; --background: green !important; --background-activated: green !important;">Submit</ion-button>
        </form>
      </ion-content>
    </ng-template>
  </ion-modal>
</ion-content>
<div class="btnCss text-center ">
  <ion-button class="" *ngFor="let btn of splitBtnClass" class="actionBtn"
    [class.selected]="selectedValue == btn.btnName" (click)="getButtonName(btn)">
    {{btn.btnName}}</ion-button>
</div>