<ion-content class="background-img">
    <!-- <div class="background-img"></div> -->
    <div class="content">
        <ion-grid class="header-logo">
            <ion-row>
                <ion-col style="text-align: center;">
                    <img src="../../../assets/beforelogin/Logo.svg" class="mt-3" width="40%" height="46%">
                    <h3>e-bhawan</h3>
                    <p>Home Department, Government of Odisha</p>
                </ion-col>
            </ion-row>
        </ion-grid>
        <form [formGroup]="registrationForm" (ngSubmit)="getRegistrationData(registrationForm.value)">
            <ion-card class="my-card">
                <ion-card-header class="my-cardheader">
                    <ion-card-title class="my-cardtitle">Registration</ion-card-title>
                </ion-card-header>

                <ion-card-content class="my-cardcontent">
                    <div class="card-field">
                        <ion-label class="label required" style="margin-top:0px !important">Name</ion-label>
                        <ion-input placeholder="Enter Your Name" type="text" clearInput="true" (keyup)="transformText($event)"
                            formControlName="name"></ion-input>
                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.name.touched || registrationForm.controls.name.dirty) && registrationForm.controls.name.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger" *ngIf="registrationForm.controls.name.errors?.required">This
                                field is
                                mandatory</span>
                            <span class="text-danger" *ngIf="registrationForm.controls.name.errors?.invalidName">Enter
                                valid name</span>
                        </div>

                        <ion-label class="label ">Email</ion-label>
                        <ion-input placeholder="abc@gmail.com" type="email" clearInput="true"
                            formControlName="email"></ion-input>
                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.email.touched || registrationForm.controls.email.dirty) && registrationForm.controls.email.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger" *ngIf="registrationForm.controls.email.errors?.required">This
                                field
                                is mandatory</span>
                            <span class="text-danger"
                                *ngIf="registrationForm.controls.email.errors?.invalidEmail">Enter
                                valid email id</span>
                        </div>
                        <ion-label class="label required ">Mobile No</ion-label>
                        <ion-input placeholder="Enter Mobile Number" type="text" clearInput="true" maxlength="10"
                            formControlName="mobile"></ion-input>
                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.mobile.touched || registrationForm.controls.mobile.dirty) && registrationForm.controls.mobile.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger" *ngIf="registrationForm.controls.mobile.errors?.required">This
                                field
                                is mandatory</span>
                            <span class="text-danger"
                                *ngIf="registrationForm.controls.mobile.errors?.invalidMobileNumber">Enter valid mobile
                                number</span>
                        </div>
                        <ion-label class="label required">DOB</ion-label>
                        <input type="date" [max]="maxDate" [min]="minDate" formControlName="dob" (change)="getDate($event)" #dateInput style="position:absolute;top:100%">

                        <ion-row class="ion-align-items-center cs-input">
                            <ion-col size="10" style="padding:0px !important" (click)="openDatepicker()">
                                <ion-input type="text" placeholder="Click icon in right side to select date"
                                    [value]="registrationForm.get('dob').value" readonly></ion-input>
                            </ion-col>
                            
                            <ion-col size="2" style="padding: 0px !important;">
                                <button type="button" class="datetime-button" (click)="openDatepicker()"><ion-icon style="font-size: 21px !important;" name="calendar"
                                        slot="end"></ion-icon>
                                    <!-- <ion-datetime-button datetime="datetime"
                                        (ionChange)="getDate($event)"></ion-datetime-button> -->
                                </button>
                            </ion-col>
                        </ion-row>
                        <!-- <ion-modal [keepContentsMounted]="true">
                            <ng-template>
                                <ion-datetime id="datetime" [max]="currentDate" presentation="date" locale="default" [showDefaultButtons]="true" (ionChange)="getDate($event)"></ion-datetime>
                            </ng-template>
                        </ion-modal> -->
                        <!-- <ion-input type="date" [max]="currentDate" placeholder="Enter Date of birth" clearInput="true" (ionChange)="getDate($event)">
                        </ion-input> -->
                        <!-- <ion-icon name="calendar" slot="end"></ion-icon> -->


                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.dob.touched || registrationForm.controls.dob.dirty) && registrationForm.controls.dob.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger" *ngIf="registrationForm.controls.dob.errors?.required">This field
                                is
                                mandatory</span>
                        </div>
                        <ion-label class="label required ">Gender</ion-label>
                        <ion-select interface="action-sheet" placeholder="Select" formControlName="guestGender">
                            <ion-select-option value="M">Male</ion-select-option>
                            <ion-select-option value="F">Female</ion-select-option>
                            <ion-select-option value="O">Others</ion-select-option>
                        </ion-select>
                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.guestGender.touched || registrationForm.controls.guestGender.dirty) && registrationForm.controls.guestGender.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger"
                                *ngIf="registrationForm.controls.guestGender.errors?.required">This
                                field is mandatory</span>
                        </div>

                        <ion-label class="label required">Address</ion-label>
                        <ion-input placeholder="Enter Address" type="text" clearInput="true"
                            formControlName="resAddr"></ion-input>
                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.resAddr.touched || registrationForm.controls.resAddr.dirty) && registrationForm.controls.resAddr.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger" *ngIf="registrationForm.controls.resAddr.errors?.required">This
                                field
                                is mandatory</span>
                        </div>

                        <div class="cd">
                            <ion-grid>
                                <ion-row>
                                    <ion-col size="9">
                                        <img [src]="captchaURL" class="captchaImg" alt="Captcha Text">
                                    </ion-col>
                                    <ion-col size="3" class="mx-auto">
                                        <ion-button (click)="getCaptcha()" class="refresh">
                                            <ion-icon name="reload-outline" class="refresh" (click)="getCaptcha()"
                                                class="refresh"></ion-icon>
                                        </ion-button>
                                    </ion-col>
                                </ion-row>
                            </ion-grid>
                        </div>
                        <ion-label class="label">Enter Captcha</ion-label>
                        <ion-input type="text" clearInput="true" placeholder="Enter Captcha"
                            formControlName="captcha"></ion-input>
                        <div class="text-error text-danger"
                            *ngIf="((registrationForm.controls.captcha.touched || registrationForm.controls.captcha.dirty) && registrationForm.controls.captcha.invalid) || isSubmitBtnClicked == true">
                            <span class="text-danger" *ngIf="registrationForm.controls.captcha.errors?.required">This
                                field
                                is mandatory</span>
                        </div>
                    </div>

                    <ion-button type="submit" expand="block">Sign up</ion-button>

                    <ion-label class="label" style="margin-top: 10px;font-size: 14.33px;"
                        (click)="goToLogin('login')">Already have an account?
                        &nbsp;<a>Login</a></ion-label>
                </ion-card-content>
            </ion-card>
        </form>
    </div>
</ion-content>