@charset "ISO-8859-1";

body {
	overflow-x: hidden;
	background: #F3F3F3;
}

section.header2 {
	background-color: #fff;
	padding: 6px 105px 6px 105px;
	border-bottom: 3px solid #B0EFCE;
	box-shadow: 0px 1px 7px rgba(0, 0, 0, 0.13);
}

nav {
	padding-top: 0px !important;
	padding-bottom: 0px !important;
	/* padding-left: 5px !important;
padding-right: 5px !important; */
}

.navbar-toggler {
	margin-bottom: 6px;
}

.logo-part {
	float: left;
	position: relative;
}

.logo-part .logo-container {
	position: absolute;
	top: -3px;
	left: -41px;
	height: 66px;
	width: 69px;
}

.logo-part p {
	font-size: 1.5em;
	margin: .7em 0 .3em 0;
	display: inline-block;
}

.logoo-part p {
	padding: 0 6px;
	margin: 0;
}

.logoo-part img {
	max-width: 59px;
	float: left;
	margin: 0 10px 0 0;
}

.logoo-part .text-1 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 700;
	font-size: 23px;
	line-height: 28px;
	letter-spacing: 0.01em;
	text-transform: uppercase;
	color: #0DA653;
}

.logoo-part .text-2 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 500;
	font-size: 15px;
	line-height: 18px;
	letter-spacing: 0.055em;
	text-transform: uppercase;
	color: #0FA958;
}

.logoo-part .text-3 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 500;
	font-size: 13px;
	line-height: 139.5%;
	text-transform: uppercase;
	color: #000000;
}

.logo-text {
	margin-bottom: 6px;
}

.logo-text p {
	padding: 0 6px;
	margin: 0;
}

.logo-text .text-4 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 600;
	font-size: 13px;
	line-height: 17px;
	display: flex;
	align-items: center;
	text-align: center;
	margin-top: 25%;
	margin-left: -78%;
	/* margin-left: 22%; */
	color: #000000;
}

.logo-text .text-5 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 500;
	font-size: 13px;
	line-height: 17px;
	display: flex;
	align-items: center;
	text-align: center;
	margin-left: -80%;
	/* margin-left: 24%; */
	color: #000000;
}

nav .navbar-nav li a {
	margin-left: 5px;
	margin-right: 5px;
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 500;
	font-size: 16px;
	line-height: 19px;
	text-transform: capitalize;
	display: flex;
	align-items: baseline;
	color: #000000 !important;
}

nav .navbar-nav li a .fa {
	padding-right: 3px;
	color: #0FA958;
	font-size: 20px;
}

nav .navbar-nav .active {
	border-bottom: 3px solid #0FA958;
}

section.header2 .navbar-container {
	margin: 0 0 0 0;
	padding: 0 0 0 0;
}

.nav-align {
	/* margin: auto */
	margin: auto auto -6px auto;
}

section.header2 .navbar-container .navbar {
	padding: 0 0 0 0;
}

section.header2 .navbar-container .navbar .left-btn, section.header2 .navbar-container .navbar .right-btn
	{
	padding: 0px 5px;
	font-size: 22px;
	font-weight: 900;
	color: #fff;
	border-radius: 6px;
	margin: 0px 1px;
}

section.header2 .navbar-container .navbar .navbar-toggler {
	color: white;
}

section.header2 .navbar-container .navbar .collapse {
	overflow: hidden;
	scroll-behavior: smooth;
	margin: 0px 1% 0 14%;
}

.login {
	/* background-image: url("../../../assets/beforeLandingImages/login/login-bg.jpg"); */
	height: calc(100vh - 90px - 37px);
	overflow-y: auto;
}

.login .card-container {
	margin: auto 20%;
}

.login .card-container .left-card-container-bg {
	background-image: url("../assets/images/login-bg.png");
	background-repeat: no-repeat;
	background-size: cover;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
	height: 100%;
	box-shadow: 0px 4px 7px rgb(0 0 0/ 15%);
}

.login .card-container .left-card-container-bg .desc1 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 700;
	font-size: 24px;
	line-height: 29px;
	letter-spacing: 0.145em;
	text-transform: uppercase;
	color: #FFFFFF;
}

.login .card-container .left-card-container-bg .desc2 {
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 500;
	font-size: 12px;
	line-height: 14px;
	/* align-items: center; */
	text-transform: capitalize;
	color: #FFFF39;
	/* padding-top: 6px; */
}

.login .card-container .left-card-container-bg .left-card-container-inner-bg
	{
	/* height: 47%;
        margin: 73px 20px 2px 42px;
        width: 72%;
        background-image: url("http://sgov.stlindia.com/website/ngms/images/vector-1.png");
        background-repeat: no-repeat;
        background-size: cover; */
	height: 272px;
	width: 311px;
	margin: 21px auto;
	background-image: url(../img/left-card-img.png);
	background-repeat: no-repeat;
	background-size: cover;
}

.login .card-container .left-card-container-bg .top-logo {
	margin-top: 5%;
}

.login .card-container .right-card-container-bg {
	background: #fff !important;
	border: 0.5px solid #cddbe4;
	box-sizing: border-box;
	box-shadow: 0px 4px 7px rgba(0, 0, 0, 0.15);
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
	padding: 15px 45px;
	/* padding: 15px 30px; */
	height: 100%;
}

.login .card-container .right-card-container-bg .login-text {
	font-family: 'Roboto';
	font-style: normal;
	font-weight: 500;
	font-size: 24px;
	line-height: 28px;
	display: flex;
	align-items: center;
	color: #000;
}

.login .card-container .right-card-container-bg .form-group {
	margin-bottom: 0 !important;
}

.login .card-container .right-card-container-bg label {
	margin-top: 1px !important;
	margin-bottom: 0px !important;
}

.login .card-container .right-card-container-bg .forgot {
	font-family: 'Roboto';
	font-style: normal;
	font-weight: 400;
	font-size: 14px;
	line-height: 15px;
	display: flex;
	align-items: center;
	color: #22B263;
}

.captcha {
	background: #E3E3E3;
	border: 1px solid #BCBEC0;
	border-radius: 5px;
	text-align: center;
	font-weight: bold;
	padding: 3px 6px;
}

.reg-captcha-input {
	background: #FFFFFF;
	border: 1px solid #BCBEC0;
	box-shadow: inset 2px 2px 3px rgba(86, 103, 113, 0.29);
	border-radius: 5px;
	width: 50%;
}

/*
	.login-captcha-input {
		background: #FFFFFF;
		border: 1px solid #BCBEC0;
		box-shadow: inset 2px 2px 3px rgba(86, 103, 113, 0.29);
		border-radius: 5px;
		width: 60%;
	}
	*/
.login .card-container .right-card-container-bg .signin-btn {
	background: linear-gradient(180deg, #0FA958 0%, #0F8D4B 100%);
	border-radius: 10px;
	width: 100%;
	/* font-family: 'Roboto'; */
	font-style: normal;
	font-weight: 500;
	font-size: 18px;
	line-height: 21px;
	align-items: center;
	color: #fff;
	text-align: center;
	padding: 10px 10px;
	margin-top: 0px;
}

.login-header {
	padding-top: 10%;
	padding-bottom: 7%;
	/* font-family: 'Roboto'; */
	font-style: normal;
	font-weight: 600;
	font-size: 36px;
	line-height: 28px;
	display: flex;
	align-items: center;
	color: #000000;
}

.reg-container {
	height: 255px;
	overflow-y: scroll;
	overflow-x: hidden;
	padding: 0px 10px 0 0px;
}

::-webkit-scrollbar {
	/* // margin-top: 20px; */
	width: 5px;
}

/* Track */
::-webkit-scrollbar-track {
	background: #f1f1f1;
}

/* Handle */
::-webkit-scrollbar-thumb {
	background: #B4B4B4;
}

/* Handle on hover */
::-webkit-scrollbar-thumb:hover {
	background: #555;
}

.reg-header {
	padding-top: 5%;
	padding-bottom: 2%;
	/* padding-left: 6%; */
	/* font-family: 'Roboto'; */
	font-style: normal;
	font-weight: 600;
	font-size: 24px;
	line-height: 28px;
	display: flex;
	align-items: center;
	color: #000000;
}

.login .card-container .right-card-container-bg .register-link {
	color: #7D7D7D;
	padding-top: 5px;
	padding-bottom: 15px;
	/* font-family: 'Roboto'; */
	font-style: normal;
	font-weight: 400;
	font-size: 14px;
	line-height: 16px;
	display: flex;
	align-items: center;
}

.login .card-container .right-card-container-bg .register-link .reg {
	/* font-family: 'Roboto'; */
	font-style: normal;
	font-weight: 600;
	font-size: 14px;
	line-height: 16px;
	display: flex;
	align-items: center;
	color: #22B263;
}

.fa-refresh {
	font-size: 16px;
	font-weight: bolder;
	margin-left: 0px;
	cursor: pointer;
}

.form-control {
	background: #FFFFFF;
	border: 1px solid #BCBEC0;
	box-shadow: inset 2px 2px 3px rgba(86, 103, 113, 0.20);
	border-radius: 6px;
	margin-top: 3px;
	margin-bottom: 3px;
}

.form-control:focus {
	border: 1px solid #6ea1e5;
	box-shadow: 0px 0px 5px #6ea1e5;
}

textarea {
  resize: none;
}

.txta {

  overflow: hidden;

}
@media screen and (max-width:576px) {
	.navbar-toggler {
		padding: 1px 4px;
	}
	.login .card-container .left-card-container-bg {
		height: auto;
		width: 100%;
		padding: 10px 15px !important;
		position: relative;
		border-bottom-left-radius: 0px !important;
		border-top-right-radius: 10px !important;
	}
	.login .card-container .left-card-container-bg .left-card-container-inner-bg
		{
		margin: 0px;
		height: auto;
		width: 100%;
		position: relative;
		background-size: 100% 100%;
	}
	.login .card-container {
		margin: 2% 5% !important;
	}
	.login .card-container .right-card-container-bg {
		border-top-left-radius: 0px !important;
		border-top-right-radius: 0px !important;
		border-bottom-left-radius: 10px !important;
		border-bottom-right-radius: 10px !important;
	}
}

@media screen and (max-width: 993px) {
	section.header2 {
		padding: 6px 0px 6px 0px !important;
		margin-bottom: 0px !important;
	}
	.np-part {
		display: none;
	}
	.login {
		height: auto;
		width: 100%;
		margin-bottom: 35px;
		padding: 10px 15px 24px 15px !important;
		position: relative;
		background-size: 100% 100%;
	}
	.login .card-container {
		margin: 2% 5% !important;
	}
	.login-captcha-input {
		/*width: 50% !important;*/
		padding-left: 15px !important;
	}
	.captcha-refresh {
		padding-right: 15px !important;
	}
	.reg-captcha-input {
		width: 43% !important;
	}
	.login .card-container .left-card-container-bg {
		/* height: auto; */
		width: 100%;
		padding: 10px 15px !important;
		position: relative;
	}
	.login .card-container .left-card-container-bg .desc1 {
		font-weight: 400;
		font-size: 18px;
		line-height: 18px;
		padding-top: 0%;
	}
	.login .card-container .left-card-container-bg .left-card-container-inner-bg
		{
		/* margin: 0px; */
		height: 40%;
		width: 67%;
		position: relative;
		background-size: 100% 100%;
	}
	.login .card-container .right-card-container-bg {
		border-top-left-radius: 0px !important;
		border-top-right-radius: 10px !important;
		border-bottom-left-radius: 0px !important;
		border-bottom-right-radius: 10px !important;
		padding: 15px 10px;
	}
}

@media screen and (max-width:768px) {
	.login .card-container .left-card-container-bg {
		height: auto;
		width: 100%;
		padding: 10px 15px !important;
		position: relative;
		border-bottom-left-radius: 0px !important;
		border-top-right-radius: 10px !important;
	}
	.login .card-container .right-card-container-bg {
		border-top-left-radius: 0px !important;
		border-top-right-radius: 0px !important;
		border-bottom-left-radius: 10px !important;
		border-bottom-right-radius: 10px !important;
		padding: 15px 23px !important;
	}
}

@media screen and (max-width:1047px) {
	.nav-align {
		margin: auto auto -6px auto;
		/* margin: auto 10px auto 35px !important; */
	}
	nav .navbar-nav li a {
		margin-left: 5px;
		margin-right: -8px !important;
		font-size: 14px !important;
	}
	.header2 {
		padding: 6px 0px 6px 0px !important;
	}
}

@media screen and (max-width:1200px) {
	nav .navbar-nav li a {
		font-size: 14px !important;
	}
	.navbar {
		margin: 0px -42px;
	}
	nav .navbar-nav li a .fa {
		padding-right: 3px;
		color: #0FA958;
		font-size: 18px !important;
	}
	.nav-align {
		margin: auto auto -6px auto;
	}
	section.header2 {
		padding: 0px 20px 0px 20px !important;
	}
	.login .card-container .left-card-container-bg {
		/* height: auto; */
		width: 100%;
		padding: 10px 15px !important;
		position: relative;
	}
	.login .card-container .left-card-container-bg .desc1 {
		font-weight: 400;
		font-size: 18px;
		line-height: 18px;
		padding-top: 0%;
	}
	.login .card-container .left-card-container-bg .left-card-container-inner-bg
		{
		/* margin: 0px; */
		height: 50%;
		width: 94%;
		margin-top: 16%;
		position: relative;
		background-size: 100% 100%;
	}
	.login-captcha-input {
		/*width: 50% !important;*/
		padding-left: 15px !important;
	}
	.captcha-refresh {
		padding-right: 15px !important;
	}
	.reg-captcha-input {
		width: 43% !important;
	}
	.login .card-container {
		margin: 1.5% 16%;
	}
	.login .card-container .right-card-container-bg {
		border-top-left-radius: 0px !important;
		border-top-right-radius: 10px !important;
		border-bottom-left-radius: 0px !important;
		border-bottom-right-radius: 10px !important;
		padding: 15px 23px !important;
	}
}

@media screen and (max-width:1325px) {
	.nav-align {
		margin: auto auto -6px auto;
	}
	section.header2 {
		padding: 6px 56px 6px 56px !important;
	}
	.reg-header {
		padding-top: 3% !important;
	}
	.login .card-container {
		margin: 1% 20%;
	}
}

.small {
	color: red;
}

.footer {
	bottom: 0px;
	position: fixed;
	background-color: #000;
	width: 100%;
	padding: 10px;
	font-family: 'Exo 2';
	font-style: normal;
	font-weight: 400;
	font-size: 14px;
	line-height: 17px;
	/* identical to box height */
	letter-spacing: 0.135em;
	color: #FFFFFF;
	z-index: 2;
}

.footer .fa {
	padding-right: 5px;
}

/* ui-datepicker CSS  */

.ui-datepicker {
	width: 14em !important;
}

.ui-datepicker td span, .ui-datepicker td a {
	padding: 0.1em !important;
	text-align: center !important;
}

.ui-datepicker table {
	width: 100%;
	font-size: .71em !important;
}

.ui-datepicker th {
	padding: 0.3em 0.1em !important;
}

.ui-datepicker .ui-datepicker-header {
	padding: 0.1em 0 !important;
}

.ui-widget-content .ui-state-highlight {
	border: 1px solid #429d37 !important;
	background: #49ae58 !important;
	color: #fff5f5 !important;
}

.ui-state-default {
	border: 1px solid #ece6e6 !important;
	background: #b3deab !important;
	color:#121111 !important;
}

.ui-widget-header {
	background: #9b9f9b !important;
}