<ion-content >
  <!-- <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button></ion-menu-button>
    </ion-buttons>
    <ion-title class="logo-text">Conveyance List</ion-title>
    <ion-buttons slot="end">
      <ion-icon name="notifications-outline"></ion-icon>
    </ion-buttons>
  </ion-toolbar> -->
  <ion-header>
    <ion-toolbar>
      <ion-buttons slot="start">
        <ion-menu-button></ion-menu-button>
      </ion-buttons>
      <ion-title>Conveyance List</ion-title>
      </ion-toolbar>
      </ion-header>
  <div *ngIf=" guestHouseList?.length">
    <ion-card *ngFor="let data of guestHouseList">
      <ion-card-header>
        <ion-card-title>{{data.ghName}}</ion-card-title>
      </ion-card-header>
      <ion-card-content>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6" >
            <ion-label class="label-key">Booking Id</ion-label><br>
            <ion-label class="label-value">{{data.bookingId}}</ion-label>
          </ion-col>
          <ion-col size="6" >
            <ion-label class="label-key">Arrival Date</ion-label><br>
            <ion-label class="label-value">{{data.fromDate}}</ion-label>
          </ion-col>
        </ion-row>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6" >
            <ion-label class="label-key">Departure</ion-label><br>
            <ion-label class="label-value">{{data.toDate}}</ion-label>
          </ion-col>
          <ion-col size="6" >
            <ion-label class="label-key">Conveyance</ion-label><br>
            <ion-label class="label-value">{{data.conveyance}}</ion-label>
          </ion-col>
        </ion-row>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6" >
            <ion-label class="label-key">Status</ion-label><br>
            <ion-label class="label-value">{{data.statusDesc}}</ion-label>
          </ion-col>
        </ion-row>
        <div>
          <ion-grid>
            <ion-row>
              <ion-col size="3">
                <ion-button
                  [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('View',data)">
                  <!-- <ion-icon slot="start" name="eye-outline" style="font-size: 20px"></ion-icon> -->
                  View
                </ion-button>
              </ion-col>
              <ion-col size="3">
                <ion-button [disabled]="data.edit===false"
                  [ngStyle]="{'color':'#0AA0A0','--background':'#DAFEFE','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Edit',data)">
                  <!-- <ion-icon name="pencil-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Edit
                </ion-button>
              </ion-col>
              <ion-col size="3">
                <ion-button [disabled]="data.bill===false"
                  [ngStyle]="{'color':'rgb(85 4 254)','--background':'#b799e2','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('bill',data)">
                  <!-- <ion-icon name="pencil-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Bill
                </ion-button>
              </ion-col>
              <ion-col size="3">
                <ion-button [disabled]="data.extend ==false"
                  [ngStyle]="{'color':'#FF7B01','--background':'#FFF2CC','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Extend',data)">
                  <!-- <ion-icon name="print-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Extend
                </ion-button>
              </ion-col>

              <ion-col size="4">
                <ion-button [disabled]="data.download ==false"
                  [ngStyle]="{'color':'#FF7B01','--background':'#FFF2CC','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Download',data)">
                  <!-- <ion-icon name="download-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Download
                </ion-button>
              </ion-col>
              <ion-col size="4">
                <ion-button [disabled]="data.delete ==false"
                  [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Delete',data)">
                  <!-- <ion-icon name="trash-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Delete
                </ion-button>
              </ion-col>
              <ion-col size="4">
                <ion-button [disabled]="data.cancel ==false"
                  [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Cancel',data)">
                  <!-- <ion-icon name="close-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Cancel
                </ion-button>
              </ion-col>
              <ion-col size="6">
                <ion-button [disabled]="data.feedBack ==false"
                  [ngStyle]="{'color':'#A4A8F3','--background':'#DAFEFE','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Feedback',data)">
                  <!-- <ion-icon name="mail-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Feedback
                </ion-button>
              </ion-col>
              <ion-col size="6">
                <ion-button [disabled]="data.paymentReceipt ==false"
                  [ngStyle]="{'color':'#BA18C5','--background':'#F8E7FA','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Payment Receipt',data)">
                  <!-- <ion-icon name="mail-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                  Payment Receipt
                </ion-button>
              </ion-col>
            </ion-row>
          </ion-grid>
        </div>
      </ion-card-content>
    </ion-card>
  </div>
  <ion-item *ngIf="! guestHouseList?.length" lines="none">
    <ion-label class="textCss">No Data Exist</ion-label>
  </ion-item>
</ion-content>
