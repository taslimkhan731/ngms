.dashboard-wrapper {
	padding-left: 4rem;
	padding-right: 4rem;
}
.title-body-container {
	padding-top: 3rem !important;
}
.nav-topbar {
    width: 100%;
    height: 20px;
    background-color: #ffe082;
    position: absolute;
    z-index: 1;
}
.mini-card {
	background-color: #b2ebf2;
	/* height: 33vh; */
	border-radius: .5rem;
	margin-bottom: .75rem;
}

.mini-card-header {
	text-align: center;
	padding: .25rem 0;
}

.mini-card-img {
	width: 95%;
	border: 4px solid #000;
	margin: 0 auto;
}

.mini-card-img img {
	max-width: 100%;
}

.mini-card-divider {
	height: 1px;
	background-color: #fffe00;
	margin: 0.6rem 0;
}

.rht-opt, .lft-opt {
	width: 50%;
	float: left;
	text-align: center;
}

.lft-opt {
	border-left: 1px solid yellow;
}

.opt-name {
	font-size: 16px;
	font-weight: 500;
}

.opt-value {
	font-size: 30px;
}

.h-card {
	position: relative;
	padding: .5rem .75rem;
	background-color: #FFF;
	box-shadow: 1px 1px 2px 0px #9c9c9c;
	border-radius: .25rem;
	margin-bottom: 0.5rem;
}

.h-card-img {
	padding: 0 1rem;
}

.h-card-img img {
	max-width: 100%;
}

.h-card-content {
	position: relative;
	padding: 0 .5rem;
}

.h-card-content .hc-title {
	color: #1e88e5;
	font-size: 20px;
	font-weight: 500;
	letter-spacing: 1px;
}

.h-card-content .hc-sub-title {
	font-size: 16px;
}

.hc-btn {
	position: absolute;
	right: 0;
	bottom: 0;
	text-transform: capitalize;
	padding: 2px 13px;
	text-decoration: none;
	font-size:14px;
}

#cardBookingContainer {
	display: block;
}

.city-filter {
	font-size: 18px;
}
@media screen and (max-width: 480px) {
 
  .title-body-container {
    padding-top: 2rem !important;
}
.navmod .nav-item.cmenu .ic-text {
    text-align: center;
    display: contents;
    font-size: 15px;
    font-weight: bold;
    color: solid black;
    color: black;
}
.navmod .nav-item.cmenu .dropdown-toggle::after {
	position: static;
}
}
@media screen and (max-width: 760px) {
	#cardBookingContainer {
		/* display: none; */
	}
	.dashboard-wrapper {
		padding-left: 0;
		padding-right: 0;
	}
	.h-card {
		padding: .5rem .125rem;
	}
	.h-card-img {
		padding: 0 .5rem;
	}
	.h-card-content .hc-title {
		font-size: 4vw;
	}
	.h-card-content .hc-sub-title {
		font-size: 3vw;
	}
	.hc-btn {
		padding: 0.15rem 0.75rem;
		font-size: 3vw;
		right: 2vw;
		bottom: -5px;
	}
	.city-filter {
		font-size: 4vw;
		letter-spacing: 2px;
	}
}

	@-webkit-keyframes blinker {
	  from {opacity: 1.0;color: #f30aec;}
	  to {opacity: 0.0;color: #40402a;}
	}
	.blink{
		text-decoration: blink;
		-webkit-animation-name: blinker;
		-webkit-animation-duration: 0.9s;
		-webkit-animation-iteration-count:infinite;
		-webkit-animation-timing-function:ease-in-out;
		-webkit-animation-direction: alternate;
	}