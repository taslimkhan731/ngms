ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);
    ion-toolbar {
        --background: darkgreen;
        color: white;
        letter-spacing: 2px;
        font-size: 16px;
    
    
        ion-icon {
            font-size: xx-large;
             background: white;
            color: green;
            padding: 3px;
            border-radius: 32px;
        }
    }

    ion-item{
        ion-label{
            font-size: 16px;
            margin: 1px 0px 10px 0px;
        }
    }

    .text-danger {
        margin-left: 8px;
    }
    .submitBtn{
        background-color: #0F8D4B;
    }
}