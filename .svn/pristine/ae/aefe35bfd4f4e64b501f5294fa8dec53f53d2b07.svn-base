ion-toolbar {
    ion-title {
      position: relative;
      top: -2px;
      padding-left: 0px;
    }
  #filtermodal-modal{
    --background: green;
  }
    ion-button {
     
      font-size: 14px;
      position: relative;
      right: 10px;
  
      ion-icon {
        font-size: 21px;
      }
     
    }
   
  
  }
  
ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

    ion-toolbar {
        --background: darkgreen;
        color: white;
        letter-spacing: 2px;
        font-size: 16px;


        ion-icon {
            font-size: xx-large;
            background: white;
            color: green;
            padding: 3px;
            border-radius: 32px;
        }

    }

    .content {
        padding: 2px;

        .filterCls {
            margin: 0px 9px 0 11px;
            border-radius: 2px;
            background-color: #067e06;
            color: white;
            font-size: 95%;

            .lebel {
                padding: 14px
            }

            ion-button {
                --background: white;
                color: rgb(4 114 4);
                border-radius: 4px;
                height: 32px;

                ion-icon {
                    // font-size: xx-large;
                    // border-radius: 4px;
                    font-size: xx-large;
                    background: white;
                    color: green;
                    padding: 3px;
                    border-radius: 32px;
                }
            }
        }

        .cardHeight {
            height: calc(91vh - 110px - 52.29px);
            overflow: scroll;

            .user_Name {
                margin: 5%;
                color: green;
            }

            .guestCls {
                padding: 0%;
                border: 1px solid green;
                margin: 1% 5%;
                border-radius: 4px;


            }

            ion-card {
                background: #FFFFFF;
                box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
                border-radius: 10px;
                padding-bottom: 10px;
                margin-top: 10px;
                margin-bottom: 10px;
                background: #F5FEF9;

                ion-card-header {
                    padding-top: 8px;
                    padding-bottom: 2px;
                    margin-bottom: 15px;

                    ion-label {
                        font-family: 'Exo 2';
                        font-style: normal;
                        font-weight: 600;
                        font-size: 16px;
                        line-height: 100%;
                        display: flex;
                        align-items: center;
                        text-align: center;
                        color: #0F8D4B;

                        ion-icon {
                            margin-right: 10px;
                            color: #0F8D4B;
                            font-weight: 600;
                            font-size: 20px;
                            // position: relative;
                        }
                    }

                    ion-label::before {
                        content: "";
                        position: absolute;
                        bottom: -6px;
                        height: 3px;
                        width: 87px;
                        background: #0FA958;
                        display: block;
                        z-index: 2;
                    }

                    ion-card-title {
                        font-family: 'Exo 2';
                        font-style: normal;
                        font-weight: 600;
                        font-size: 18px;
                        line-height: 22px;
                        /* identical to box height */
                        text-transform: uppercase;
                        color: #108444;
                    }
                }

                ion-card-content {
                    padding: 2px;

                    .guestClass {
                        border: 1px solid green;
                        margin: 4px;
                        border-radius: 9px;
                        padding: 11px;
                    }

                    .label-value {
                        // font-family: "Exo 2";
                        font-weight: 600 !important;
                        color: black;
                    }
                }

            }
        }


    }

    .btnCss {
        position: fixed;
        bottom: 0;
        height: 60.29px;
        background-color: #F5FFFA;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;

        .scroll-container {
            // border: 2px solid silver;
            display: flex;
            align-items: center;
            overflow: hidden;
        }
    }
    .actionBtn {
        color: white;
        --background: rgb(7 192 96);
        font-size: 14px;
        // width: 22%;
        text-transform: initial;
    }
    .selected {
        color: white;
        --background: linear-gradient(#1b804a 90%, #226624 90%);
        font-size: 70%;
        // width: 24%;
        text-transform: initial;
    }
}

::ng-deep .mycomponent-wider-popover {
    --width: 95%;
    --max-width: 400px;
}