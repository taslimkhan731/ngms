package com.stl.ngms.admin.model;

import java.util.Date;

public class NocModel {
    private Long nocId;
    private String reqId;
    private String cancelId;
    private String fromDate;
    private String toDate;
    private Double perDayCharge;
    private Double nocCharge;
    private Date createdDate;
    private Date approvedDate;

    public Long getNocId() {
        return nocId;
    }

    public void setNocId(Long nocId) {
        this.nocId = nocId;
    }

    public String getReqId() {
        return reqId;
    }

    public void setReqId(String reqId) {
        this.reqId = reqId;
    }

    public String getCancelId() {
        return cancelId;
    }

    public void setCancelId(String cancelId) {
        this.cancelId = cancelId;
    }

    public String getFromDate() {
        return fromDate;
    }

    public void setFromDate(String fromDate) {
        this.fromDate = fromDate;
    }

    public String getToDate() {
        return toDate;
    }

    public void setToDate(String toDate) {
        this.toDate = toDate;
    }

    public Double getPerDayCharge() {
        return perDayCharge;
    }

    public void setPerDayCharge(Double perDayCharge) {
        this.perDayCharge = perDayCharge;
    }

    public Double getNocCharge() {
        return nocCharge;
    }

    public void setNocCharge(Double nocCharge) {
        this.nocCharge = nocCharge;
    }

    public Date getCreatedDate() {
        return createdDate;
    }

    public void setCreatedDate(Date createdDate) {
        this.createdDate = createdDate;
    }

    public Date getApprovedDate() {
        return approvedDate;
    }

    public void setApprovedDate(Date approvedDate) {
        this.approvedDate = approvedDate;
    }

    @Override
    public String toString() {
        return "NocModel{" +
                "nocId=" + nocId +
                ", reqId='" + reqId + '\'' +
                ", cancelId='" + cancelId + '\'' +
                ", fromDate=" + fromDate +
                ", toDate=" + toDate +
                ", perDayCharge=" + perDayCharge +
                ", nocCharge=" + nocCharge +
                ", createdDate=" + createdDate +
                ", approvedDate=" + approvedDate +
                '}';
    }
}
