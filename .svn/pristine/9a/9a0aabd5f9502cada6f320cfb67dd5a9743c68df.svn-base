.top-bar {
    background-color: rgb(221, 221, 221);
    height: 30px;
    margin-right: 0px;
}

.left-small-tabs {
    padding-left: 20%;
    font-size: 13px;
    padding-top: 3px;
}

.small-tabs {
    padding-left: 3%;
    border-right: 1px solid #4e4c4c;
    padding-right: 1%;
}

.logo-1 {
    padding-top: 18px;
    padding-left: 100px;
}

.logo-2 {
    width: 130px;
    margin-left: 45%;
}

.logo-3 {
    width: 130px;
    padding-top: 15px;
}

.menu-bar {
    background-image: url("./../images/Menu.png");
    content: " ";
    /* position: absolute; */
    height: 45px;
    /* background-color: #F5CE52;
    transform-origin: top left;
    transform: skew(30deg, 0deg); */
    padding: 10px 20px 10px 10px;
    display: block;
    margin-left: 49%;
    z-index: 10;
}


/* .menu-bar ul {
    transform-origin: top left;
    transform: skew(-30deg, 0deg);
} */

.menu-bar li {
    display: inline;
    transform: none;
    font-family: serif;
    font-weight: 600;
    font-size: 14px;
    padding-right: 32px;
    /* text-shadow: -2px 0px 3px #a09797; */
    cursor: pointer;
}


/* .carousel-inner img {
    width: 100%;
    height: 100%;
} */

.slider-container {
    margin-top: -19px;
}

.mid-heading {
    padding-top: 15px;
    text-align: center;
    font-weight: 600;
    font-size: 30px;
    font-family: serif;
}

.u-line1 {
    height: 2px;
    width: 300px;
    background-color: #4e4c4c;
}

.u-line2 {
    height: 2px;
    width: 245px;
    background-color: #4e4c4c;
}

.ln-1 {
    padding-left: 40%;
}

.ln-2 {
    padding-left: 42%;
}

.card-img1 {
    width: 100%;
    height: 200px;
    border-radius: 0px;
}

.card .crd-bdy {
    padding: 0px 5px 0px 5px;
}

.card-content {
    background-color: #445c88;
    padding: 8px !important;
    height: 166px;
}

.inner-content {
    width: 100%;
    border: 1px solid gold;
    padding: 10px;
    color: white;
    height: 146px;
}

.inner-head label {
    font-weight: 600;
    font-size: 17px;
    font-family: auto;
}

.footer-container {
    background-color: #102145;
    margin-top: 30px;
    color: white;
}

.foot-div1 {
    padding-top: 60px;
    padding-left: 145px !important;
}

.foot-div1 p {
    font-size: 13px;
    font-weight: 600;
    width: 190px;
}

.foot-div1 img {
    width: 120px;
}

.foot-div2 {
    padding-top: 15px;
    padding-left: 80px !important;
}

.foot-div2 label {
    font-family: poppins;
    font-size: 20px;
    font-weight: 600;
}

.ul {
    height: 2px;
    width: 122px;
    margin-left: -14px;
    background-color: #fff;
}

.foot-div2 ul {
    padding-left: 0;
    padding-top: 15px;
    font-size: 13px;
    line-height: 1.7rem;
    cursor: pointer;
}

.foot-div2 li {
    cursor: pointer;
    font-weight: 600;
}

.logo-container1 {
    background-color: #172033;
    padding-top: 10px;
    padding-bottom: 10px;
}

.logo-container {
    margin-left: 5% !important;
}

.logo-container img {
    border-left: 1px solid #9c9b9b;
    padding-left: 24px;
    height: 25px;
}

.main-logo {
    margin-right: 0% !important;
}

.logo-container2 {
    background-color: #000000;
    padding-top: 10px;
    padding-bottom: 10px;
}

.main-logo-conatiner {
    margin-left: 1% !important;
}

.border-none {
    border-left: none !important;
}

.logo-container2 img {
    border-left: 1px solid #9c9b9b;
    padding-left: 20px;
    width: 150px;
    height: 36px;
}
ul.login-panel {
    list-style: none;
    margin-left: 15%;
}
ul.login-panel li {
    float: left;
    padding-right: 10px;
    padding-top: 2px;
    border-right: 1px solid #a8ab92bd;
}
ul.login-panel li:last-child {
	border-right:none;
}
ul.login-panel li >a {
    text-decoration: none;
    color: #000;
    font-size: 15px;
    padding-left: 10px;
    font-weight: 500;
   
}
ul.login-panel li a > img {
    width: 15px;
}