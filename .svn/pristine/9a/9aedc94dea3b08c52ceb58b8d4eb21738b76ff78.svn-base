ion-content {
  --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

  .content {
    .filterCls {
      margin: 0px 9px 0 11px;
      border-radius: 2px;
      background-color: #067e06;
      color: white;
      font-size: 95%;

      .lebel {
        padding: 14px
      }

      ion-button {
        --background: white;
        color: rgb(4 114 4);
        border-radius: 4px;
        height: 32px;

        ion-icon {
          font-size: xx-large;
          background: white;
          color: green;
          padding: 3px;
          border-radius: 32px;
        }
      }
    }

    ion-card {
      background: #FFFFFF;
      box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
      border-radius: 10px;

      ion-card-header {
        padding-left: 11px;
        padding-right: 11px;

        ion-card-title {
          // font-family: 'Helvetica';
          font-style: normal;
          font-weight: 600;
          font-size: 18px;
          line-height: 22px;
          text-transform: uppercase;
          color: #000000;
        }
      }

      ion-card-content {
        padding: 2px;

        .label-value {
          // font-family: "Helvetica";
          font-weight: 600 !important;
          color: black;
        }
      }

      .btn {
        box-shadow: 1px 2px 2px 2px rgb(0 0 0 / 25%);
        text-transform: capitalize;
        font-size: 12px;
        margin: 2px;
        padding: 2px;

        ion-icon {
          padding-right: 5px;
        }
      }
    }
  }
}

::ng-deep .mycomponent-wider-popover {
  --width: 95%;
  --max-width: 400px;
}

ion-item {
  --background: linear-gradient(180deg, #ebf5ea, );
  height: 100%;

  .textCss {
    text-align: center;
    font-size: larger;
    // margin-top: 39vh;

  }
}

