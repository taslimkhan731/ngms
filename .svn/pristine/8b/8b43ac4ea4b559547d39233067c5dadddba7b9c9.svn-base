.custom-popover-backdrop {
    /* Set the desired background color and opacity */
    background-color: rgba(0, 0, 0, 0.7);
    /* Here, 0.5 represents 50% opacity */
}

.header {
    text-align: left;
    padding: 10px;
    color: #0F8D4B;
    height: 50px;
    background: #d7fae4;

    ion-icon {
        float: right;
        font-size: 24px;
        font-weight: 600;
    }
}