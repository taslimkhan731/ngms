ion-toolbar {
    ion-title {
      position: relative;
      top: -2px;
      padding-left: 0px;
    }
  #filtermodal-modal{
    --background: green;
    --background-activated: green;
  }
    ion-button {
     
      font-size: 14px;
      position: relative;
      right: 10px;
  
      ion-icon {
        font-size: 21px;
      }
     
    }
   
  
  }
  
ion-content {
    // --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

    .content {
        padding: 2px;

        .filterCls {
            margin: 0px 9px 0 11px;
            border-radius: 2px;
            background-color: #067e06;
            color: white;

            // font-size: 95%;
            .lebel {
                padding: 14px
            }

            ion-icon {
                // font-size: xx-large;
                // border-radius: 4px;
                font-size: xx-large;
                background: white;
                color: green;
                // padding: 3px;
                border-radius: 32px;
                margin: 4px;
            }
        }

        .cardHeight {
            height: calc(91vh - 100% - 52.29px);
            overflow: scroll;
        }

        ion-card {
            background: #FFFFFF;
            border: 1px solid #108444;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            margin-top: 0;
            margin-bottom: 10px;
            background: #F5FEF9;

            ion-card-header {
                padding-top: 8px;
                padding-left: 5px;
                padding-bottom: 2px;
                margin-bottom: 15px;

                ion-label {
                    font-family: 'Exo 2';
                    font-style: normal;
                    font-weight: 600;
                    font-size: 16px;
                    line-height: 100%;
                    display: flex;
                    align-items: center;
                    text-align: center;
                    color: #0F8D4B;

                    ion-icon {
                        margin-right: 10px;
                        color: #0F8D4B;
                        font-weight: 600;
                        font-size: 20px;
                        // position: relative;
                    }
                }

                ion-label::before {
                    content: "";
                    position: absolute;
                    bottom: -6px;
                    height: 3px;
                    width: 87px;
                    background: #0FA958;
                    display: block;
                    z-index: 0;
                }
            }


            ion-card-content {
                padding: 2px;

                // .label-value {
                //     font-family: "Exo 2";
                //     font-weight: 600 !important;
                //     color: black;
                // }


                table {
                    thead th {
                        border: none !important;
                        border-left: 1px solid white !important;
                        background: rgb(50, 179, 111) ! important;
                        color: white;
                        padding: 0.3rem !important;
                        text-align: center;
                        font-size: 13px;

                    }

                    thead th:first-child {
                        border-top-left-radius: 5px;
                    }

                    thead th:last-child {
                        border-top-right-radius: 5px;
                    }

                    tbody {
                        border: 1px solid #bebebe;

                        td {
                            // padding: 10px;
                            border-right: 0.5px solid #97E3BB;
                            vertical-align: middle !important;
                            padding: 0.3rem !important;
                            font-size: 13px;

                            ion-icon {
                                padding: 4px 5px;
                                background: #297700;
                                color: #fff;
                                border-radius: 5px;
                                font-size: 20px;
                                font-weight: 800;
                            }
                        }
                    }
                }
            }
        }
    }

    .btnCss {
        position: fixed;
        bottom: 0;
        height: 60.29px;
        background-color: #F5FFFA;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;

        .scroll-container {
            // border: 2px solid silver;
            display: flex;
            align-items: center;
            overflow: hidden;
        }
    }

    ion-toolbar {
        --background: darkgreen;
        color: white;
        letter-spacing: 2px;
        font-size: 16px;

        ion-icon {
            font-size: xx-large;
            background: white;
            color: green;
            padding: 3px;
            border-radius: 32px;
        }
    }
}

.actionBtn {
    color: white;
    --background: rgb(7 192 96);
    font-size: 70%;
    // width: 22%;
    text-transform: initial;
}

.selected {
    color: white;
    --background: linear-gradient(#1b804a 90%, #226624 90%);
    font-size: 70%;
    // width: 24%;
    text-transform: initial;
}

::ng-deep .mycomponent-wider-popover {
    --width: 95%;
    --max-width: 400px;
}

ion-item {
    --background: linear-gradient(180deg, #ebf5ea, );
    height: 100%;

    .textCss {
        text-align: center;
        font-size: larger;
        // margin-top: 39vh;

    }
}
::ng-deep .action-sheet-selected.sc-ion-action-sheet-ios {
    color: #000000 !important;
}

::ng-deep .action-sheet-button.sc-ion-action-sheet-ios {
    color: #000000 !important;
}

::ng-deep .action-sheet-cancel.sc-ion-action-sheet-ios {
    color: red !important;
}