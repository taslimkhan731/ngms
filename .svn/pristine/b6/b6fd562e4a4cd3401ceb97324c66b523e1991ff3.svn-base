package com.stl.ngms.common.model;

public class FeedbackRequestModel {
	private String feedbackId;
	private String requestId;
	private String name;
	private String mobile;
	private String food;
	private String housekeeping;
	private String checkincheckout;
	private String conduct;
	private String clean;
	private String overall;
	private String feedbacksms;
	private String status;
	private String submittedOn;
	private String repliedOn;
	private String repliedSms;
	private String gh_name;
	private String block_name;
	private String captcha;
	public String getCaptcha() {
		return captcha;
	}
	public void setCaptcha(String captcha) {
		this.captcha = captcha;
	}
	public String getOverall() {
		return overall;
	}
	public void setOverall(String overall) {
		this.overall = overall;
	}
	public String getFeedbackId() {
		return feedbackId;
	}
	public void setFeedbackId(String feedbackId) {
		this.feedbackId = feedbackId;
	}
	public String getRequestId() {
		return requestId;
	}
	public void setRequestId(String requestId) {
		this.requestId = requestId;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public String getMobile() {
		return mobile;
	}
	public void setMobile(String mobile) {
		this.mobile = mobile;
	}
	public String getFood() {
		return food;
	}
	public void setFood(String food) {
		this.food = food;
	}
	public String getHousekeeping() {
		return housekeeping;
	}
	public void setHousekeeping(String housekeeping) {
		this.housekeeping = housekeeping;
	}
	public String getCheckincheckout() {
		return checkincheckout;
	}
	public void setCheckincheckout(String checkincheckout) {
		this.checkincheckout = checkincheckout;
	}
	public String getConduct() {
		return conduct;
	}
	public void setConduct(String conduct) {
		this.conduct = conduct;
	}
	public String getClean() {
		return clean;
	}
	public void setClean(String clean) {
		this.clean = clean;
	}
	public String getFeedbacksms() {
		return feedbacksms;
	}
	public void setFeedbacksms(String feedbacksms) {
		this.feedbacksms = feedbacksms;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getSubmittedOn() {
		return submittedOn;
	}
	public void setSubmittedOn(String submittedOn) {
		this.submittedOn = submittedOn;
	}
	public String getRepliedOn() {
		return repliedOn;
	}
	public void setRepliedOn(String repliedOn) {
		this.repliedOn = repliedOn;
	}
	public String getRepliedSms() {
		return repliedSms;
	}
	public void setRepliedSms(String repliedSms) {
		this.repliedSms = repliedSms;
	}
	public String getGh_name() {
		return gh_name;
	}
	public void setGh_name(String gh_name) {
		this.gh_name = gh_name;
	}
	public String getBlock_name() {
		return block_name;
	}
	public void setBlock_name(String block_name) {
		this.block_name = block_name;
	}
	@Override
	public String toString() {
		return "FeedbackRequestModel [feedbackId=" + feedbackId + ", requestId=" + requestId + ", name=" + name
				+ ", mobile=" + mobile + ", food=" + food + ", housekeeping=" + housekeeping + ", checkincheckout="
				+ checkincheckout + ", conduct=" + conduct + ", clean=" + clean + ", overall=" + overall
				+ ", feedbacksms=" + feedbacksms + ", status=" + status + ", submittedOn=" + submittedOn
				+ ", repliedOn=" + repliedOn + ", repliedSms=" + repliedSms + ", gh_name=" + gh_name + ", block_name="
				+ block_name + "]";
	}
	

}
