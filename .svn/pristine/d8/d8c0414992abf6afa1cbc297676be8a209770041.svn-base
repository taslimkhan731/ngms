<ion-toolbar>
  <ion-buttons slot="start">
    <ion-menu-button auto-hide="false"></ion-menu-button>
  </ion-buttons>
  <ion-title class="logo-text">{{headingName}}</ion-title>
  <ng-container *ngIf="selectedValue !== 'Cancel'">
  <ion-button slot="end" id="filtermodal-modal" (click)="openFilterModal()">
    <ion-icon name="filter-outline"></ion-icon>&nbsp;Filter
  </ion-button>
  </ng-container>
  <!-- <ion-buttons slot="end">
    <ion-icon name="notifications-outline"></ion-icon>
  </ion-buttons> -->
</ion-toolbar>
<ion-content [scrollEvents]="true" (ionScroll)="getScrollPos($event)">
  <ion-refresher slot="fixed" (ionRefresh)="filterHandleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>
  <!-- <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher> -->
  <div class="content">
    <div>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select City" [(ngModel)]="selectCity"
          (ionChange)="getGuestHouseList($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.cityId
          *ngFor="let item of getAllCityList">{{item.cityName}}</ion-select-option>
        </ion-select>
      </ion-item>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select Guest House" [(ngModel)]="selectGH"
          (ionChange)="getBhawanName($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.id *ngFor="let item of guestHouseList">{{item.name}}</ion-select-option>
        </ion-select>
      </ion-item>
    </div>
    <div *ngIf="selectedValue=='Moderator'">
      <div *ngIf="applicationEntry?.length">
        <div class="cardHeight">
          <ion-card *ngFor="let data of applicationEntry " class="mt-1">
            <ion-card-header>
              <ion-card-title>{{data.ghName}},{{data.cityName}}</ion-card-title>
            </ion-card-header>
            <ion-card-content>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Date</ion-label><br>
                  <ion-label class="label-value">{{data.bookingDt}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Name</ion-label><br>
                  <ion-label class="label-value">{{data.name}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Category</ion-label><br>
                  <ion-label class="label-value">{{data.catgId}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data.toDate}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Purpose</ion-label><br>
                  <ion-label class="label-value">{{data.purpose}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Mobile No.</ion-label><br>
                  <ion-label class="label-value">{{data.mobile}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Room Type</ion-label><br>
                  <ion-label class="label-value">{{data.roomOrBed}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Type</ion-label><br>
                  <ion-label class="label-value">{{data.typeOfRoom}}</ion-label>
                </ion-col>
                <!-- <ion-col size="6">
                  <ion-label class="label-key">Status</ion-label><br>
                  <ion-label class="label-value">{{data.statusDesc}}</ion-label>
                </ion-col> -->
              </ion-row>
              <ion-grid>
                <ion-row>
                  <ion-col> <ion-button (click)="openModal(data,'save')"
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Save
                    </ion-button>
                  </ion-col>
                  <ion-col> <ion-button (click)="openModal(data,'edit')"
                      [ngStyle]="{'color':'#0AA0A0','--background':'#DAFEFE','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Edit
                    </ion-button>
                  </ion-col>
                  <ion-col> <ion-button (click)="openModal(data,'CAN')"
                      [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Cancel
                    </ion-button>
                  </ion-col>
                </ion-row>
              </ion-grid>
            </ion-card-content>
          </ion-card>
          <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Moderator')" [threshold]="250">
            <ion-infinite-scroll-content  loadingSpinner="bubbles"  *ngIf="infiniteScrollEnabled"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll>
        </div>
      </div>
      <ng-container *ngIf="!applicationEntry?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </ng-container>
      <!-- <ion-item *ngIf="! applicationEntry?.length" lines="none">
        <ion-label class="textCss">No Data Exist</ion-label>
      </ion-item> -->
    </div>
    <div *ngIf="selectedValue=='Edit'">
      <div *ngIf="applicationEntry?.length">
        <div class="cardHeight">
          <ion-card *ngFor="let data of applicationEntry " class="mt-1">
            <ion-card-content>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Name</ion-label><br>
                  <ion-label class="label-value">{{data.name}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data.toDate}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Purpose</ion-label><br>
                  <ion-label class="label-value">{{data.purpose}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Type</ion-label><br>
                  <ion-label class="label-value">{{data.typeOfRoom}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Mobile No.</ion-label><br>
                  <ion-label class="label-value">{{data.mobile}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Email ID</ion-label><br>
                  <ion-label class="label-value">{{data.email ? data.email : 'NA'}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-grid>
                <ion-row>
                  <ion-col size="6"> <ion-button (click)="openModal(data,'updateMod')"
                      [ngStyle]="{'color':'#0AA0A0','--background':'#DAFEFE','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Edit
                    </ion-button>
                  </ion-col>
                  <ion-col size="6"> <ion-button (click)="getEditModButton('Delete',data)"
                      [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Delete
                    </ion-button>
                  </ion-col>
                </ion-row>
              </ion-grid>
            </ion-card-content>
          </ion-card>
          <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Moderator')" [threshold]="250">
            <ion-infinite-scroll-content  loadingSpinner="bubbles"  *ngIf="infiniteScrollEnabled"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll>
        </div>
      </div>
  
      <ng-container *ngIf="! applicationEntry?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </ng-container>
      <!-- <ion-item *ngIf="! applicationEntry?.length" lines="none">
        <ion-label class="textCss">No Data Exist</ion-label>
      </ion-item> -->
    </div>
    <div *ngIf="selectedValue=='Cancel'">

      <div *ngIf="cancellationList?.length">
        <div class="cardHeight">
          <ion-card *ngFor="let data of cancellationList " class="mt-1">
            <ion-card-content>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Date</ion-label><br>
                  <ion-label class="label-value">{{data.bookingDt}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Name</ion-label><br>
                  <ion-label class="label-value">{{data.name}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Designation</ion-label><br>
                  <ion-label class="label-value">{{data.desg}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data.toDate}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Mobile No.</ion-label><br>
                  <ion-label class="label-value">{{data.mobile}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Email Id</ion-label><br>
                  <ion-label class="label-value">{{data.email ? data.email : 'NA'}}</ion-label>
                </ion-col>
              </ion-row><ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Status</ion-label><br>
                  <ion-label class="label-value">{{data.statusDesc}}</ion-label>
                </ion-col>

              </ion-row>
              <div class="text-center mb-2">
                <ng-container *ngIf="data.status == 'RCAN' ;else partialCan">
                  <ion-button (click)="getCancelResButton(data,'CAN')"
                    [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '94%'}">
                    Cancel
                  </ion-button>
                </ng-container>
                <ng-template #partialCan>
                  <ion-button (click)="getCancelResButton(data,'PCAN')"
                    [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '94%'}">
                    Partial Cancel
                  </ion-button>
                </ng-template>
              </div>
            </ion-card-content>
          </ion-card>
          <!-- <ion-infinite-scroll (ionInfinite)="onIonInfinite($event)" [threshold]="250">
            <ion-infinite-scroll-content  loadingSpinner="bubbles"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll> -->
        </div>
      </div>
      <ng-container *ngIf="! cancellationList?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </ng-container>
      <!-- <ion-item *ngIf="! cancellationList?.length" lines="none">
        <ion-label class="textCss">No Data Exist</ion-label>
      </ion-item> -->
    </div>
    <div *ngIf="selectedValue=='Modify'">

      <div *ngIf="modifyList?.length">
        <div class="cardHeight">
          <ion-card *ngFor="let data of modifyList " class="mt-1">
            <ion-card-content>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data?.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Date</ion-label><br>
                  <ion-label class="label-value">{{data?.bookingDt}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Guest Details</ion-label><br>
                  <ion-label class="label-value">
                    <ng-container
                      *ngIf="data?.designation != '' && data?.department != ''; else onlyName">{{data?.name}},{{data?.designation}},{{data?.department}}</ng-container>
                    <ng-template #onlyName>{{data?.name}}</ng-template>
                  </ion-label>
                </ion-col>

                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data?.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data?.toDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Purpose</ion-label><br>
                  <ion-label class="label-value">{{data?.purpose}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Type</ion-label><br>
                  <ion-label class="label-value">{{data?.type}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Status</ion-label><br>
                  <ion-label class="label-value">{{data?.statusDesc}}</ion-label>
                </ion-col>
              </ion-row>
              <div class="text-center mb-2 mx-2">
                <ion-button (click)="modifyAllotment(data,'Modify')"
                  [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}">
                  Modify Allotment
                </ion-button>
              </div>
            </ion-card-content>
          </ion-card>
          <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Modify')" [threshold]="250">
            <ion-infinite-scroll-content  loadingSpinner="bubbles"  *ngIf="infiniteScrollEnabled"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll>
        </div>
      </div>
      <ng-container *ngIf="! modifyList?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </ng-container>
      <!-- <ion-item *ngIf="! modifyList?.length" lines="none">
        <ion-label class="textCss">No Data Exist</ion-label>
      </ion-item> -->
    </div>
    <div *ngIf="selectedValue=='Conference'">

      <div *ngIf="confList?.length">
        <div class="cardHeight">
          <ion-card *ngFor="let data of confList " class="mt-1">
            <ion-card-content>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Name</ion-label><br>
                  <ion-label class="label-value">{{data.name}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row>
                <ion-col size="6">
                  <ion-label class="label-key">Booking Date</ion-label><br>
                  <ion-label class="label-value">{{data.bookingDt}}</ion-label>
                </ion-col>

                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data.toDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Category</ion-label><br>
                  <ion-label class="label-value">{{data.category}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Mobile No</ion-label><br>
                  <ion-label class="label-value">{{data.mobile}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Room Type</ion-label><br>
                  <ion-label class="label-value">{{data.typeOfRoom}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-grid>
                <ion-row>
                  <ion-col>
                    <ion-button (click)="openModal(data,'confSave')"
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','--background-activated':'#E1EDFF','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Save
                    </ion-button>
                  </ion-col>
                  <ion-col>
                    <ion-button (click)="openModal(data,'confBill')"
                      [ngStyle]="{'color':'#0AA0A0','--background':'#DAFEFE','--background-activated':'#DAFEFE','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Bill
                    </ion-button>
                  </ion-col>
                  <ion-col>
                    <ion-button (click)="openModal(data,'confReceipt')"
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','--background-activated':'#E1EDFF','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Reciept
                    </ion-button>
                  </ion-col>
                </ion-row>
              </ion-grid>
            </ion-card-content>
          </ion-card>
          <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Conference')" [threshold]="250">
            <ion-infinite-scroll-content  loadingSpinner="bubbles"  *ngIf="infiniteScrollEnabled"
            loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll>
         
        </div>
      </div>
      <!-- <ion-item *ngIf="!confList?.length" lines="none">
        <ion-label class="textCss">No Data Exist</ion-label>
      </ion-item> -->
      <ng-container *ngIf="! confList?.length">
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </ng-container>
    </div>
    <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
      <ion-icon name="chevron-up-outline"></ion-icon>
    </div>
  </div>
  <div class="btnCss text-center">
    <div class="scroll-container" style="overflow: auto">
      <ion-button *ngFor="let btn of splitBtnClass" class="actionBtn" [class.selected]="selectedValue == btn.btnName"
        (click)="getButtonName(btn)">
        {{btn.btnName}}</ion-button>
    </div>
  </div>

  <ion-modal #filtermodal trigger="filtermodal-modal">
    <ng-template>
      <ion-header>
        <ion-toolbar>
          <ion-buttons slot="start">
            <ion-button (click)="cancel()">
              <ion-icon name="arrow-back"></ion-icon>
            </ion-button>
          </ion-buttons>
          <ion-title>Search</ion-title>
        </ion-toolbar>
      </ion-header>
      <ion-content class="ion-padding">
        <form [formGroup]="filterForm" (ngSubmit)="submitFilterForm(filterForm.value)">
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Booking ID</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" (keyup)="transformText($event)" placeholder="Booking ID" formControlName="bookingId"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Booking Date</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="date" formControlName="bookingDate"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Category</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-select interface="action-sheet" placeholder="Select Category"
                [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}" formControlName="category">
                <ion-select-option [value]=list.purposeId
                  *ngFor="let list of categoryList">{{list.purposeName}}</ion-select-option>
              </ion-select>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Purpose</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-select interface="action-sheet" placeholder="Select Purpose"
                [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}" formControlName="purpose">
                <ion-select-option value='1'>Official</ion-select-option>
                <ion-select-option value='2'>Private</ion-select-option>
                <ion-select-option value='3'>Patient</ion-select-option>
                <ion-select-option value='4'>Student</ion-select-option>
              </ion-select>
            </ion-item>
          </div>

          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Room Type</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-select interface="action-sheet" placeholder="Select Room Type"
                [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}" formControlName="roomType">
                <ion-select-option value='R'>Room</ion-select-option>
                <ion-select-option value='C'>Conveyance</ion-select-option>
                <ion-select-option value='RC'>Room with Conveyance</ion-select-option>
                
              </ion-select>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Mobile Number</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="Number" placeholder="Mobile Number" formControlName="mobNo"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Guest Name</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Guest Name" formControlName="name"></ion-input>
            </ion-item>
          </div>
          <ion-button type="submit" expand="block" style="margin: 20px 0px 0px 6px !important;
          width: 96% !important; --background: green !important;">Submit</ion-button>
        </form>
      </ion-content>
    </ng-template>
  </ion-modal>
</ion-content>