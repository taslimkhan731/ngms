ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);
        .my-card {
            background: #FFFFFF;
            border: 1px solid #A1D9A3;
            box-shadow: 0px 4px 4px rgb(0 0 0 / 25%);
            border-radius: 4px;
            padding: 10px;

          

            .my-cardheader {
                padding: 0px;
                margin: 5px 0px;
                font-size: 20px;
                color: green;
                font-weight: 600;
            }
            .contentClass{
                font-size: 15px;
                align-self: stretch;
                padding: 7px;
                color: green;
                background-color: #f0f9f4;
            }
            // ion-button{
            //     background-color: green;
            //     color: white;
            //     // -ms-flex-align: center;
            //     -ms-flex-align: center;
            //   }
        }
       
   
    ion-toolbar {
        --background: darkgreen;
        color: white;
        letter-spacing: 2px;
        font-size: 16px;
    
    
        ion-icon {
            font-size: xx-large;
             background: white;
            color: green;
            padding: 3px;
            border-radius: 32px;
        }
    }

    ion-item{
        ion-label{
            font-size: 22px;
            margin: 1px 0px 10px 0px;
        }
    }

    .view-btn {
        --background: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
        --background-activated: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
        border: 1px solid #549f08;
        color: #FFFFFF !important;
        padding: 0 !important;
        font-size: .875rem;
        line-height: 1.5;
        border-radius: 0.2rem;
    }
    
}