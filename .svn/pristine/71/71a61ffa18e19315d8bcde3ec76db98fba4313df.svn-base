<ion-toolbar>
  <ion-buttons slot="start" routerLink="/after-login/pages/orgadmin/GH-menu/feedback" class="toolbarr">
    <ion-icon name="chevron-back-outline"></ion-icon>
  </ion-buttons>
  <ion-title class="logo-text">Feedback Report</ion-title>
</ion-toolbar>
<ion-content>
  <div class="content">
    <ng-container *ngFor="let data of replyDetails">
      <ion-card *ngIf="data.status === 'Closed'" style="padding: 0px !important;">
        <ion-card-content style="padding: 0px !important;">
          <ion-accordion-group>
            <ion-accordion value="first">
              <ion-item slot="header" style="background:#def4df;">
                <ion-label style="color: darkgreen;"><b>Reply Details</b></ion-label>
              </ion-item>
              <div class="ion-padding" slot="content">
                <ion-row>
                  <ion-col size="6">
                    <ion-label class="label-key">Booking Id</ion-label><br>
                    <ion-label class="label-value">{{data.requestId}}</ion-label>
                  </ion-col>
                  <ion-col size="6">
                    <ion-label class="label-key">Replied On</ion-label><br>
                    <ion-label class="label-value">{{data.repliedOn}}</ion-label>
                  </ion-col>
                </ion-row>
                <ion-row>
                  <ion-col size="12">
                    <ion-label class="label-key">Replied By</ion-label><br>
                    <ion-label class="label-value">{{data.repliedByRole}}</ion-label>
                  </ion-col>
                </ion-row>
                <ion-row>
                  <ion-col size="12">
                    <ion-label class="label-key">Replied Description</ion-label><br>
                    <ion-label class="label-value">{{data.repliedSms}}</ion-label>
                  </ion-col>
                </ion-row>
              </div>
            </ion-accordion>
          </ion-accordion-group>
        </ion-card-content>
      </ion-card>
    </ng-container>
    <ng-container *ngFor="let data of replyDetails">
      <ion-card *ngIf="data.status === 'Opened' || data.status === 'Viewed' || data.status === 'Closed'"
        style="background: #f6ede8;">
        <ion-card-content>
          <ion-row style="padding-left: 6px;">
            <ion-col size="6">
              <ion-label class="label-key">Booking Id</ion-label><br>
              <ion-label class="label-value">{{data.requestId}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key">Feedback Id</ion-label><br>
              <ion-label class="label-value">{{data.feedbackId}}</ion-label>
            </ion-col>
          </ion-row>
          <ion-row style="padding-left: 6px;">
            <ion-col size="6">
              <ion-label class="label-key">Name</ion-label><br>
              <ion-label class="label-value">{{guestName}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key">Submitted On</ion-label><br>
              <ion-label class="label-value">{{data.submittedOn}}</ion-label>
            </ion-col>
          </ion-row>
        </ion-card-content>
      </ion-card>
    </ng-container>
    <ion-card class="card-class">
      <ion-card-content style="padding: 7px;" class="radio-group-disable">
        <!-- div -1 -->
        <div style="margin-top: 13px;">
          <ion-label class="label-value">Easy of check-in and check-out :</ion-label>
          <ion-radio-group [value]='checkincheckout'>
            <ion-row>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile.png" height="42px" />
                <div class="emoji-label mt-2">Excellent</div>
                &nbsp;&nbsp;<ion-radio value="5" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile (1).png" height="42px" />
                <div class="emoji-label mt-2">Good</div>
                &nbsp;&nbsp;<ion-radio value="4" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/scared.png" height="42px" />
                <div class="emoji-label mt-2">Average</div>
                &nbsp;&nbsp;<ion-radio value="3" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/sad (1).png" height="42px" />
                <div class="emoji-label mt-2"> Poor</div>
                &nbsp;&nbsp;<ion-radio value="2" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/angry.png" height="42px" />
                <div class="emoji-label mt-2">Very Poor</div>
                &nbsp;&nbsp;<ion-radio value="1" [disabled]="true" ></ion-radio>
              </ion-col>
            </ion-row>
          </ion-radio-group>
        </div>
        <!-- div -2 -->
        <div style="margin-top: 13px;">
          <ion-label class="label-value">Up Keep Of The Room:</ion-label>
          <ion-radio-group [value]='houseKeeping'>
            <ion-row>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile.png" height="42px" />
                <div class="emoji-label mt-2">Excellent</div>
                &nbsp;&nbsp;<ion-radio value="5" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile (1).png" height="42px" />
                <div class="emoji-label mt-2">Good</div>
                &nbsp;&nbsp;<ion-radio value="4" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/scared.png" height="42px" />
                <div class="emoji-label mt-2">Average</div>
                &nbsp;&nbsp;<ion-radio value="3" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/sad (1).png" height="42px" />
                <div class="emoji-label mt-2"> Poor</div>
                &nbsp;&nbsp;<ion-radio value="2" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/angry.png" height="42px" />
                <div class="emoji-label mt-2">Very Poor</div>
                &nbsp;&nbsp;<ion-radio value="1" [disabled]="true" ></ion-radio>
              </ion-col>
            </ion-row>
          </ion-radio-group>
        </div>
        <!-- div-3 -->
        <div style="margin-top: 13px;">
          <ion-label class="label-value">Claenliness And Hygiene:</ion-label>
          <ion-radio-group [value]='clean'>
            <ion-row>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile.png" height="42px" />
                <div class="emoji-label mt-2">Excellent</div>
                &nbsp;&nbsp;<ion-radio value="5" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile (1).png" height="42px" />
                <div class="emoji-label mt-2">Good</div>
                &nbsp;&nbsp;<ion-radio value="4" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/scared.png" height="42px" />
                <div class="emoji-label mt-2">Average</div>
                &nbsp;&nbsp;<ion-radio value="3" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/sad (1).png" height="42px" />
                <div class="emoji-label mt-2"> Poor</div>
                &nbsp;&nbsp;<ion-radio value="2" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/angry.png" height="42px" />
                <div class="emoji-label mt-2">Very Poor</div>
                &nbsp;&nbsp;<ion-radio value="1" [disabled]="true" ></ion-radio>
              </ion-col>
            </ion-row>
          </ion-radio-group>
        </div>
        <!-- div-4 -->
        <div style="margin-top: 13px;">
          <ion-label class="label-value">Quality Of Food:</ion-label>
          <ion-radio-group [value]='foodQuality'>
            <ion-row>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile.png" height="42px" />
                <div class="emoji-label mt-2">Excellent</div>
                &nbsp;&nbsp;<ion-radio value="5" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile (1).png" height="42px" />
                <div class="emoji-label mt-2">Good</div>
                &nbsp;&nbsp;<ion-radio value="4" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/scared.png" height="42px" />
                <div class="emoji-label mt-2">Average</div>
                &nbsp;&nbsp;<ion-radio value="3" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/sad (1).png" height="42px" />
                <div class="emoji-label mt-2"> Poor</div>
                &nbsp;&nbsp;<ion-radio value="2" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/angry.png" height="42px" />
                <div class="emoji-label mt-2">Very Poor</div>
                &nbsp;&nbsp;<ion-radio value="1" [disabled]="true" ></ion-radio>
              </ion-col>
            </ion-row>
          </ion-radio-group>
        </div>
        <!-- div-5 -->
        <div style="margin-top: 13px;">
          <ion-label class="label-value">Conduct Of Staff:</ion-label>
          <ion-radio-group [value]='conductStaff'>
            <ion-row>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile.png" height="42px" />
                <div class="emoji-label mt-2">Excellent</div>
                &nbsp;&nbsp;<ion-radio value="5" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/smile (1).png" height="42px" />
                <div class="emoji-label mt-2">Good</div>
                &nbsp;&nbsp;<ion-radio value="4" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/scared.png" height="42px" />
                <div class="emoji-label mt-2">Average</div>
                &nbsp;&nbsp;<ion-radio value="3" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/sad (1).png" height="42px" />
                <div class="emoji-label mt-2"> Poor</div>
                &nbsp;&nbsp;<ion-radio value="2" [disabled]="true" ></ion-radio>
              </ion-col>
              <ion-col size="2">
                <img src="../../../assets/afterlogin/angry.png" height="42px" />
                <div class="emoji-label mt-2">Very Poor</div>
                &nbsp;&nbsp;<ion-radio value="1" [disabled]="true" ></ion-radio>
              </ion-col>
            </ion-row>
          </ion-radio-group>
        </div>
        <br>
        <ion-label class="feedbackLbl" position="stacked" >Comments, if any</ion-label><br>
        <textarea class="textarea" cols="30" rows="3" [(ngModel)]="feedback" [disabled] = "true"></textarea>
      </ion-card-content>
    </ion-card>


    <ng-container *ngFor="let data of replyDetails">
      <ion-row style="padding-left: 6px; margin-right: 4px;"
        *ngIf="data.status === 'Opened' || data.status === 'Viewed'">

        <ion-col>
          <ion-button expand="block" style="--background:darkgreen" (click)="showFeedback()"> Reply</ion-button>
        </ion-col>
      </ion-row>
    </ng-container>
  </div>
</ion-content>