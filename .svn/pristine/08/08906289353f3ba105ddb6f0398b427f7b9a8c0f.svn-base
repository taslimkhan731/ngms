ion-toolbar {
    --background:#000000 !important;
    ion-icon {
        font-size: 30px !important;
        padding: 10px;
        color: #ffffff;
    }
}
ion-content {
    --background:#000000 !important;

    .data-container {
        display: flex;
        align-items: center;
        height: 80%;
        padding: 0px;
    }
}