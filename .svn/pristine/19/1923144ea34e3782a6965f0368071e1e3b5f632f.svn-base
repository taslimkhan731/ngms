<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
	pageEncoding="ISO-8859-1"%>
<!DOCTYPE html>
<html>
<head>
<style>
#addDocument {
	width: 60% !important;
}

#dataEntryDataTable {
	display: inline-table;
}
</style>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1">
<script type="text/javascript"
	src="./customJS/MasterSetup/documentUpload.js"></script>
</head>
<body>
	<div class="container-fluid">
		<div class="row">
			<div class="col-xs-12 col-sm-12 col-md-4 admin-col-right">
				<div class="card">
					<div class="card-header">
						<i class="fa fa-plus pr-2"></i>Document Upload
					</div>
					<div class="card-body c-body">
						<form action="#" class="documentUploadForm"
							id="documentUploadForm" method="post" accept-charset="utf-8">
							<div class="form-group">
								<label>Document Type: <small class="small">*</small></label> <select
									class="form-control" name="homeDocType" id="homeDocType">
									<option value="">---Select type---</option>
									<option value="Regulation">Regulation</option>
									<option value="Tariff">Tariff</option>
									<option value="Services">Services</option>
									<option value="Faq">Faq</option>
								</select>
							</div>
							<div class="form-group">
								<label>Upload Document(only PDF - 2mb) <small
									class="small">*</small></label>
								<div class="custom-file">
									<label for="homeDoc" class="custom-file-label" id="homeDocName">Choose
										File</label> <input type="file" class="custom-file-input" id="homeDoc"
										name="homeDoc">
								</div>
							</div>
							<div class="form-action">
								<div class="col-md-12 d-flex justify-content-center">
									<button class="btn btn-add btn-block" type="button"
										id="addDocument">
										<i class="fa fa-pencil-square-o" aria-hidden="true"></i> Add
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>

			<div class="col-xs-12 col-sm-12 col-md-8 admin-col-left">
				<div class="card">
					<div class="card-header">Document Upload Details</div>
					<div class="card-body">
						<div class="">
							<table class="table tbl table-responsive" id="dataEntryDataTable"
								width="100%">
								<thead class="">
									<tr class="">
										<th class="datatable-nosort text-center">Sl. No.</th>
										<th class="datatable-nosort text-center">Document Type</th>
										<th class="datatable-nosort text-center">Document Name</th>
										<th class="datatable-nosort text-center">Action</th>
									</tr>
								</thead>
								<tbody class="text-nowrap text-center">
									<tr>
										<td>1</td>
										<td>Regulation</td>
										<td>Regulation.pdf</td>
										<td><button type="button" title="Edit"
												class="btn btn-sm btn-edit">
												<i class="fa fa-pencil" aria-hidden="true"></i>
											</button></td>
									</tr>
									<tr>
										<td>2</td>
										<td>Tariff</td>
										<td>Tariff.pdf</td>
										<td><button type="button" title="Edit"
												class="btn btn-sm btn-edit">
												<i class="fa fa-pencil" aria-hidden="true"></i>
											</button></td>
									</tr>
									<tr>
										<td>3</td>
										<td>Services</td>
										<td>Services.pdf</td>
										<td><button type="button" title="Edit"
												class="btn btn-sm btn-edit">
												<i class="fa fa-pencil" aria-hidden="true"></i>
											</button></td>
									</tr>
									<tr>
										<td>4</td>
										<td>Faq</td>
										<td>Faq.pdf</td>
										<td><button type="button" title="Edit"
												class="btn btn-sm btn-edit">
												<i class="fa fa-pencil" aria-hidden="true"></i>
											</button></td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</body>
</html>