ion-toolbar {
    ion-title {
      position: relative;
      top: -2px;
      padding-left: 0px;
    }
  #filtermodal-modal{
    --background: green;
    --background-activated: green;
  }
    ion-button {
     
      font-size: 14px;
      position: relative;
      right: 10px;
  
      ion-icon {
        font-size: 21px;
      }
     
    }
   
  
  }
  
ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

    ion-toolbar {
        --background: darkgreen;
        color: white;
        letter-spacing: 2px;
        font-size: 16px;


        ion-icon {
            font-size: xx-large;
            background: white;
            color: green;
            padding: 3px;
            border-radius: 32px;
        }

    }

    .content {
        padding: 2px;

        .filterCls {
            margin: 0px 9px 0 11px;
            border-radius: 2px;
            background-color: #067e06;
            color: white;
            font-size: 95%;

            .lebel {
                padding: 14px
            }

            ion-button {
                --background: white;
                color: rgb(4 114 4);
                border-radius: 4px;
                height: 32px;

                ion-icon {
                    // font-size: xx-large;
                    // border-radius: 4px;
                    font-size: xx-large;
                    background: white;
                    color: green;
                    padding: 3px;
                    border-radius: 32px;
                }
            }
        }

        .card-number {
            .lable-class {
                // font-family: "Helvetica";
                font-weight: 600 !important;
                color: black;
                font-size: 10px;
                padding: 5px;
            }

            .column-class {
                background: linear-gradient(180deg, #BEF6C2, #3ABD44);
                border-radius: 4px;
                box-shadow: 0px 0px 0px 0px green;
                height: 9vh;
                padding: 9px;
            }

            .label-key {
                font-family: 'Exo 2';
                font-size: 20px;
                font-weight: 600;
                line-height: 20px;
                letter-spacing: 0em;
                color: black;

            }
        }


        .cardHeight {
            // height: 63vh;
            height: calc(92vh - 100% - 83.29px);
            overflow-y: scroll;

            ion-card {
                background: #FFFFFF;
                box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
                border-radius: 10px;
                // margin: 13px 16px;

                ion-card-header {
                    padding-left: 11px;
                    padding-right: 11px;

                    ion-card-title {
                        // font-family: 'Helvetica';
                        font-style: normal;
                        font-weight: 600;
                        font-size: 18px;
                        line-height: 22px;
                        text-transform: uppercase;
                        color: #000000;
                    }
                }

                ion-card-content {
                    padding: 2px;

                    .label-value {
                        // font-family: "Helvetica";
                        font-weight: 600 !important;
                        color: black;
                    }
                }

                .btn {
                    box-shadow: 1px 2px 2px 2px rgb(0 0 0 / 25%);
                    text-transform: capitalize;
                    font-size: 12px;
                    margin: 2px;
                    padding: 2px;

                    ion-icon {
                        padding-right: 5px;
                    }
                }
            }
        }


    }

    .btnCss {
        height: 83.29px;
        background-color: #F5FFFA;
        position: fixed;
        width: 100%;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;


        .scroll-container {
            // border: 2px solid silver;
            display: flex;
            align-items: center;
            overflow: hidden;
        }
    }
}

::ng-deep .mycomponent-wider-popover {
    --width: 95%;
    --max-width: 400px;
}

ion-item {
    --background: linear-gradient(180deg, #ebf5ea, );
    height: 100%;

    .textCss {
        text-align: center;
        font-size: larger;
        // margin-top: 39vh;

    }
}

::ng-deep .action-sheet-selected.sc-ion-action-sheet-ios {
    color: #000000 !important;
}

::ng-deep .action-sheet-button.sc-ion-action-sheet-ios {
    color: #000000 !important;
}

::ng-deep .action-sheet-cancel.sc-ion-action-sheet-ios {
    color: red !important;
}

