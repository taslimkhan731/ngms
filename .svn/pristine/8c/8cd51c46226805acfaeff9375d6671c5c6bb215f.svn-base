<!-- <ion-toolbar>
  <ion-buttons slot="start">
    <ion-menu-button></ion-menu-button>
  </ion-buttons>
  <ion-title class="logo-text">{{headerToolbar}}</ion-title>
</ion-toolbar> -->
<ion-header>
  <ion-toolbar >     
     <ion-buttons slot="start">
      <ion-menu-button></ion-menu-button>
    </ion-buttons>
    <ion-title> {{headerToolbar}}</ion-title>
    </ion-toolbar>
    </ion-header>
    <ion-content [scrollEvents]="true" (ionScroll)="getScrollPos($event)">
      <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
        <ion-refresher-content></ion-refresher-content>
      </ion-refresher>
      <div *ngIf="guestHouseList?.length">
        <ion-card *ngFor="let data of guestHouseList">
          <ion-card-header>
            <ion-card-title>{{data.ghName}}</ion-card-title>
          </ion-card-header>
          <ion-card-content>
            <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">Booking Id</ion-label><br>
                <ion-label class="label-value">{{data.bookingId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Booking Date</ion-label><br>
                <ion-label class="label-value">{{data.bookingDt}}</ion-label>
              </ion-col>
            </ion-row>
            <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">From Date</ion-label><br>
                <ion-label class="label-value">{{data.fromDate ?  data.fromDate : 'NA'}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">To Date</ion-label><br>
                <ion-label class="label-value">{{data.toDate ?  data.toDate : 'NA'}}</ion-label>
              </ion-col>
            </ion-row>
            <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">During Stay Conveyance</ion-label><br>
                <ion-label class="label-value">{{data.duringStay}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Purpose</ion-label><br>
                <ion-label class="label-value">{{data.purpose}}</ion-label>
              </ion-col>
            </ion-row>
            <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">Booking Type</ion-label><br>
                <ion-label class="label-value">{{data.bookingType}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Status</ion-label><br>
                <ion-label class="label-value">{{data.statusDesc}}</ion-label>
              </ion-col>
            </ion-row>
            <!-- <ion-row style="padding-left: 6px;">
              <ion-col size="6">
                <ion-label class="label-key">Status</ion-label><br>
                <ion-label class="label-value">{{data.statusDesc}}</ion-label>
              </ion-col>
            </ion-row> -->
            <div class="buttons">
              <ion-grid>
                <ion-row>
                  <ng-container *ngIf="data.bookingType == 'Conveyance' else showOthers">
                    <ng-container *ngIf="data.status == 'REQ' else onlyView">
                      <ion-col>
                        <ion-button
                          [ngStyle]="{'color':'#FFFFFF','--background':'#083c8a','--background-activated':'#083c8a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('View',data)">
                          <!-- <ion-icon slot="start" name="eye-outline" style="font-size: 20px"></ion-icon> -->
                          View
                        </ion-button>
                      </ion-col>
                      <ion-col>
                        <ion-button [disabled]="data.edit===false"
                          [ngStyle]="{'color':'#FFFFFF','--background':'#0a8787','--background-activated':'#0a7385','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('Edit',data)">
                          <!-- <ion-icon name="pencil-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                          Edit
                        </ion-button>
                      </ion-col>
                      <ion-col>
                        <ion-button [disabled]="data.delete ==false"
                          [ngStyle]="{'color':'#FFFFFF','--background':'#c32232','--background-activated':'#c34232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('Delete',data)">
                          <!-- <ion-icon name="trash-outline" style="font-size: 20px"></ion-icon>&nbsp; -->
                          Delete
                        </ion-button>
                      </ion-col>
                    </ng-container>
                    <ng-template #onlyView>
                      <ion-col>
                        <ion-button
                          [ngStyle]="{'color':'#FFFFFF','--background':'#083c8a','--background-activated':'#083c8a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('View',data)">
                          <!-- <ion-icon slot="start" name="eye-outline" style="font-size: 20px"></ion-icon> -->
                          View
                        </ion-button>
                      </ion-col>
                    </ng-template>
                  </ng-container>
                  <ng-template #showOthers>
                    <ion-col>
                      <ion-button
                        [ngStyle]="{'color':'#FFFFFF','--background':'#083c8a','--background-activated':'#083c8a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('View',data)">
                        View
                      </ion-button>
                    </ion-col>
                    <ng-container *ngIf="data.status == 'REQ'">
                      <ion-col>
                        <ion-button [disabled]="data.edit===false"
                          [ngStyle]="{'color':'#FFFFFF','--background':'#0a8787','--background-activated':'#0a7385','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('Edit',data)">
                          Edit
                        </ion-button>
                      </ion-col>
                      <ion-col>
                        <ion-button [disabled]="data.delete ==false"
                          [ngStyle]="{'color':'#FFFFFF','--background':'#c32232','--background-activated':'#c34232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('Delete',data)">
                          Delete
                        </ion-button>
                      </ion-col>
                    </ng-container>
                    <ng-container *ngIf="data.status == 'PRO'">
                      <ng-container *ngIf="data.twentyFourCancel > 0">
                        <ion-col>
                          <ion-button [disabled]="data.cancel ==false"
                            [ngStyle]="{'color':'#FFFFFF','--background':'#9e1523','--background-activated':'#c34232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                            (click)="getbutton('Cancel',data)">
                            Cancel
                          </ion-button>
                        </ion-col>
                      </ng-container>
                    </ng-container>
                    <ng-container *ngIf="data.status == 'CIN' || data.status == 'PCIN'">
                      <ng-container *ngIf="data.partialCancel > 0">
                        <ion-col>
                          <ion-button [disabled]="data.cancel ==false"
                            [ngStyle]="{'color':'#FFFFFF','--background':'#9e1523','--background-activated':'#c34232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                            (click)="getbutton('Cancel',data)">
                            Cancel
                          </ion-button>
                        </ion-col>
                      </ng-container>
                      <ion-col *ngIf="data.canStatus == null">
                        <ion-button [disabled]="data.extend ==false"
                          [ngStyle]="{'color':'#FFFFFF','--background':'#307821','--background-activated':'#306831','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('Extend',data)">
                          Extend
                        </ion-button>
                      </ion-col>
                    </ng-container>
                    <ng-container *ngIf="data.status == 'COUT' || data.status == 'BILL' || data.status == 'RECT'">
                      <ion-col *ngIf="data.feedbackId == null">
                        <ion-button
                          [ngStyle]="{'color':'#FFFFFF','--background':'#208888','--background-activated':'#208898','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('Feedback',data)">
                          Feedback
                        </ion-button>
                      </ion-col>
                      <ion-col *ngIf="data.status == 'BILL'">
                        <ion-button
                          [ngStyle]="{'color':'#FFFFFF','--background':'#6d35bc','--background-activated':'#6d35bd','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                          (click)="getbutton('bill',data)">
                          Bill
                        </ion-button>
                      </ion-col>
                      <ng-container *ngIf="data.status == 'RECT'">
                        <ion-col>
                          <ion-button
                            [ngStyle]="{'color':'#FFFFFF','--background':'#6d35bc','--background-activated':'#6d35bd','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                            (click)="getbutton('bill',data)">
                            Bill
                          </ion-button>
                        </ion-col>
                        <ion-col>
                          <ion-button
                            [ngStyle]="{'color':'#FFFFFF','--background':'#2c41af','--background-activated':'#2c41bd','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                            (click)="getbutton('Payment Receipt',data)">
                            Payment Receipt
                          </ion-button>
                        </ion-col>
                      </ng-container>
                    </ng-container>
                    <ion-col *ngIf="data.noc =='UNPAID'">
                      <ion-button 
                        [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','--background-activated':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('NOC',data)">
                        NOC
                      </ion-button>
                    </ion-col>
                    <ion-col *ngIf="data.noc =='PAID'">
                      <ion-button 
                        [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','--background-activated':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('NOC',data)">
                        NOC
                      </ion-button>
                    </ion-col>
                    <ion-col *ngIf="data.duesStatus =='PAID'">
                      <ion-button 
                        [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','--background-activated':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('DUES',data)">
                        Dues Receipt
                      </ion-button>
                    </ion-col>
                    <ion-col>
                      <ion-button
                        [ngStyle]="{'color':'#FFFFFF','--background':'#d96619','--background-activated':'#d96628','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Download',data)">
                        Download
                      </ion-button>
                    </ion-col>
                  </ng-template>
                  <!-- <ng-template #showOthers>
                    <ion-col size="3">
                      <ion-button
                        [ngStyle]="{'color':'#FFFFFF','--background':'#083c8a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('View',data)">
                        View
                      </ion-button>
                    </ion-col>
                    <ion-col size="3">
                      <ion-button [disabled]="data.edit===false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#0a8787','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Edit',data)">
                        Edit
                      </ion-button>
                    </ion-col>
                    <ion-col size="3">
                      <ion-button [disabled]="data.bill===false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#6d35bc','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('bill',data)">
                        Bill
                      </ion-button>
                    </ion-col>
                    <ion-col size="3">
                      <ion-button [disabled]="data.extend ==false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#307821','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Extend',data)">
                        Extend
                      </ion-button>
                    </ion-col>
    
                    <ion-col size="4">
                      <ion-button
                        [ngStyle]="{'color':'#FFFFFF','--background':'#d96619','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Download',data)">
                        Download
                      </ion-button>
                    </ion-col>
                    <ion-col size="4">
                      <ion-button [disabled]="data.delete ==false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#c32232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Delete',data)">
                        Delete
                      </ion-button>
                    </ion-col>
                    <ion-col size="4">
                      <ion-button [disabled]="data.cancel ==false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#9e1523','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Cancel',data)">
                        Cancel
                      </ion-button>
                    </ion-col>
                    <ion-col size="6">
                      <ion-button [disabled]="data.feedBack ==false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#208888','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Feedback',data)">
                        Feedback
                      </ion-button>
                    </ion-col>
                    <ion-col size="6">
                      <ion-button [disabled]="data.paymentReceipt ==false"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#2c41af','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('Payment Receipt',data)">
                        Payment Receipt
                      </ion-button>
                    </ion-col>
                    <ion-col size="6">
                      <ion-button *ngIf="data.noc =='UNPAID'"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('NOC',data)">
                        NOC
                      </ion-button>
                    </ion-col>
                    <ion-col size="6">
                      <ion-button *ngIf="data.noc =='PAID'"
                        [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton('NOC',data)">
                        NOC
                      </ion-button>
                    </ion-col>
                  </ng-template> -->
                  <!-- <ion-col size="6">
                    <ion-button
                      [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                      (click)="getbutton('Cancel Reservation',data)">
                      Cancel Reservation
                    </ion-button>
                  </ion-col> -->
                  <!-- <ion-col size="6">
                    <ion-button
                      [ngStyle]="{'color':'#FFFFFF','--background':'#2caf3e','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                      (click)="getbutton('Partial Cancel',data)">
                      Partial Cancel
                    </ion-button>
                  </ion-col> -->
                  <!-- <ion-col size="6">
                    <ion-button [disabled]="data.noc ==false"
                      [ngStyle]="{'color':'#FFFFFF','--background':'#0b614a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                      (click)="getbutton('Payment Receipt',data)">
                      NOC Receipt
                    </ion-button>
                  </ion-col> -->
                </ion-row>
              </ion-grid>
            </div>
          </ion-card-content>
        </ion-card>
        <ion-infinite-scroll (ionInfinite)="onIonInfinite($event)">
          <ion-infinite-scroll-content
          loadingSpinner="bubbles"
        loadingText="Loading more data..."></ion-infinite-scroll-content>
        </ion-infinite-scroll>
        <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
          <ion-icon name="chevron-up-outline"></ion-icon>
        </div>
      </div>
      <ng-container *ngIf="! guestHouseList?.length" lines="none">
        <!-- <ion-label class="textCss">No Data Exist</ion-label> -->
        <div class="img-wrapper">
          <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
          <p>No Data Available</p>
        </div>
      </ng-container>
    </ion-content>