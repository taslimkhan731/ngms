.card {
    background: #F5FEF9;
    padding-top: 10px;
  }

  .icon-css {
    background: rgba(215, 244, 217, 0.54);
    border: 1px solid rgba(24, 162, 89, 0.23);
    border-radius: 29px;
    color: #0F8D4B;
    padding: 5px 5px;
    font-size: 32px;
  }

  ion-card {
    background: #FFFFFF;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
    border-radius: 10px;
    border: 1px solid #d6d6d6;
    margin: 10px;
    // margin: 13px 16px;

    ion-card-header {
      padding-left: 11px;
      padding-right: 11px;

      ion-card-title {
        font-family: "Exo 2";
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 22px;
        text-transform: uppercase;
        color: #000000;
      }
    }

    ion-card-content {
      padding: 2px;

      .label-value {
        // font-family: "Helvetica";
        font-weight: 600 !important;
        color: black;
      }

      .buttons ion-col {
        padding-top: 0px;
        padding-bottom: 0px;
      }
    }

    .btn {
      box-shadow: 1px 2px 2px 2px rgb(0 0 0 / 25%);
      text-transform: capitalize;
      font-size: 12px;
      margin: 2px;
      padding: 2px;

      ion-icon {
        padding-right: 5px;
      }
    }
  }

  ::-webkit-scrollbar {
    /* // margin-top: 20px; */
    width: 5px;
  }

  /* Track */
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  /* Handle */
  ::-webkit-scrollbar-thumb {
    background: #89C59B;
  }

  /* Handle on hover */
  ::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  ion-toolbar {
    --background: darkgreen;
    color: white;
    letter-spacing: 2px;
    font-size: 16px;

    ion-icon {
      font-size: xx-large;
      background: white;
      color: green;
      padding: 3px;
      border-radius: 32px;
    }

  }
  .back-to-top-btn {
    background: #000000;
    position: fixed;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    left: 50%;
    transform: translateX(-50%);
    bottom: 65px;
    z-index: 999;
}
ion-item{
  --background: linear-gradient(180deg, #ebf5ea,);
  height: 100%;
  .textCss {
      text-align: center;
      font-size: larger;
      // margin-top: 39vh;
    
   }
}

[aria-disabled="true"] {
  color: rgb(0 0 0) !important;
  opacity: 0.4;
}
::ng-deep .native-input[disabled].sc-ion-input-ios , ::ng-deep .native-textarea[disabled].sc-ion-textarea-ios{
  opacity: 0.9 !important;
}

