<ion-content>
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button auto-hide="false"></ion-menu-button>
    </ion-buttons>
    <ion-title class="logo-text">Vehicle Allotment List</ion-title>
    <ion-buttons slot="end">
      <ion-icon name="notifications-outline"></ion-icon>
    </ion-buttons>
  </ion-toolbar>
  <div class="content">
    <div>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select City"
          [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option value="1">Delhi</ion-select-option>
          <ion-select-option value="2">Mumbai</ion-select-option>
          <ion-select-option value="3">Kolkata</ion-select-option>
          <ion-select-option value="4">Chennai</ion-select-option>
        </ion-select>
      </ion-item>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select Guest House"
          [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option value="1">Odisha Bhawan,Delhi</ion-select-option>
          <ion-select-option value="2">Odisha Bhawan,Mumbai</ion-select-option>
          <ion-select-option value="3">Odisha Bhawan,Kolkata</ion-select-option>
          <ion-select-option value="4">Odisha Bhawan,Chennai</ion-select-option>
        </ion-select>
      </ion-item>
    </div>
    <div class="cardHeight">
      <ion-card *ngFor="let data of cardData " class="mt-1">
        <ion-card-content>
          <ion-row style="padding-left: 46px;" *ngFor="let d of data.bookingDetails" class="mt-1">
            <ion-col size="6">
              <ion-label class="label-key">{{d.key}}</ion-label><br>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-value">{{d.val}}</ion-label>
            </ion-col>
          </ion-row>

          <div class="guestCls">
            <ion-label class="user_Name">Guest Details</ion-label>
            <ion-row style="padding-left: 46px;" *ngFor="let item of data.guestList">
              <ion-col size="6">
                <ion-label class="label-key">{{item.key}}</ion-label><br>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-value">{{item.val}}</ion-label>
              </ion-col>
            </ion-row>
          </div>
          <div class="guestCls">
            <ion-label class="user_Name">Vehicle Request Details From</ion-label>
            <ion-row style="padding-left: 46px;" *ngFor="let item of data.vehicleRequestDetailsFrom">
              <ion-col size="6">
                <ion-label class="label-key">{{item.key}}</ion-label><br>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-value">{{item.val}}</ion-label>
              </ion-col>
            </ion-row>
          </div>
          <div class="guestCls">
            <ion-label class="user_Name">Vehicle Request Details To</ion-label>
            <ion-row style="padding-left: 46px;" *ngFor="let item of data.vehicleRequestDetailsTo">
              <ion-col size="6">
                <ion-label class="label-key">{{item.key}}</ion-label><br>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-value">{{item.val}}</ion-label>
              </ion-col>
            </ion-row>
          </div>
          <div class="text-center mb-2">
            <ion-button *ngFor="let btn of btnData index as i"
              [ngStyle]="{'color':btn.color,'--background':btn.background,'font-size':'72%','width':'34%'}"
              (click)="getbutton(btn.btnName,data.title)">
              <!-- <ion-icon [name]="btn.btnIcon" style="padding: 5px;"></ion-icon> -->
              {{btn.btnName}}
            </ion-button>
          </div>
        </ion-card-content>
      </ion-card>
    </div>
  </div>

</ion-content>