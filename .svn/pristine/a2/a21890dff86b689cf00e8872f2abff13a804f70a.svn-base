<ion-toolbar>
  <ion-buttons slot="start">
    <ion-menu-button auto-hide="false"></ion-menu-button>
  </ion-buttons>
  <ion-title>{{headingName}}</ion-title>
  <ion-button slot="end" id="filtermodal-modal"  (click)="openFilterModal()">
    <ion-icon name="filter-outline"></ion-icon>&nbsp;Filter
  </ion-button>
</ion-toolbar>
<ion-content [scrollEvents]="true" (ionScroll)="getScrollPos($event)">
  <ion-refresher slot="fixed" (ionRefresh)="filterHandleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>
  <div class="content">
    <div>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select City" [(ngModel)]="selectCity"
          (ionChange)="getGuestHouseList($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.cityId
            *ngFor="let item of getAllCityList">{{item.cityName}}</ion-select-option>
        </ion-select>
      </ion-item>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select Guest House" [(ngModel)]="selectGH"
          (ionChange)="getBhawanName($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.id *ngFor="let item of guestHouseList">{{item.name}}</ion-select-option>
        </ion-select>
      </ion-item>
    </div>
    <!-- <div class="mt-1 filterCls">
        <ion-row>
          <ion-col size="6" class=" mt-2" class="lebel">
            Data Entry List
          </ion-col>
          <ion-col size="6" class="ion-text-end ">
            <ion-button ><ion-icon name="reload-circle-sharp"></ion-icon></ion-button>
            <ion-button (click)="presentPopover($event)"><ion-icon name="search-circle-sharp"></ion-icon></ion-button>
          </ion-col>
        </ion-row>
      </div> -->
    <div class="cardHeight">
      <div *ngIf="selectedValue=='Billing'">
        <div *ngIf="getBillingListData?.length">
          <ion-card *ngFor="let data of getBillingListData " class="mt-1">
            <ion-card-content>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Name</ion-label><br>
                  <ion-label class="label-value">{{data.name}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Category</ion-label><br>
                  <ion-label class="label-value">{{data.catgId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Designation</ion-label><br>
                  <ion-label class="label-value">{{data.category}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data.toDate}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Purpose</ion-label><br>
                  <ion-label class="label-value">{{data.purpose}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Advance Amount</ion-label><br>
                  <ion-label class="label-value">{{data.advanceAmount}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Total Amount</ion-label><br>
                  <ion-label class="label-value">{{data.totalAmt}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-grid>
                <ion-row class="text-center">
                  <ion-col>
                    <ion-button (click)="createBill(data.bookingId)"
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Billing
                    </ion-button>
                  </ion-col>
                  <ion-col>
                    <ion-button (click)="cancelCheckOut(data.bookingId)"
                      [ngStyle]="{'color':'rgb(233, 30, 52)','--background':'#FFE2E5','font-size':'smaller','font-weight':'600','width': '-webkit-fill-available'}">
                      Cancel Check Out
                    </ion-button>
                  </ion-col>
                </ion-row>
              </ion-grid>
            </ion-card-content>
          </ion-card>
          <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
            <ion-icon name="chevron-up-outline"></ion-icon>
          </div>

          <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Billing')" [threshold]="250">
            <ion-infinite-scroll-content loadingSpinner="bubbles"
              loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll>
        </div>
        <div *ngIf="!getBillingListData?.length">
          <div class="img-wrapper">
            <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
            <p>No Data Available</p>
          </div>
        </div>
      </div>
      <div *ngIf="selectedValue=='Bill List'">
        <div *ngIf="showBillingListData?.length">
          <ion-card *ngFor="let data of showBillingListData " class="mt-1">
            <ion-card-content>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Booking Id</ion-label><br>
                  <ion-label class="label-value">{{data.bookingId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Name</ion-label><br>
                  <ion-label class="label-value">{{data.name}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Category</ion-label><br>
                  <ion-label class="label-value">{{data.catgId}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Designation</ion-label><br>
                  <ion-label class="label-value">{{data.category}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">From Date</ion-label><br>
                  <ion-label class="label-value">{{data.fromDate}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">To Date</ion-label><br>
                  <ion-label class="label-value">{{data.toDate}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Purpose</ion-label><br>
                  <ion-label class="label-value">{{data.purpose}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-label class="label-key">Bill Date</ion-label><br>
                  <ion-label class="label-value">{{data.billingDt}}</ion-label>
                </ion-col>
              </ion-row>
              <ion-row style="padding-left: 6px;">
                <ion-col size="6">
                  <ion-label class="label-key">Total Amount</ion-label><br>
                  <ion-label class="label-value">{{data.totalAmt}}</ion-label>
                </ion-col>
                <ion-col size="6">
                  <ion-button (click)="showBillDetails(data,'Bill List')"
                    [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}">Bill
                    Details</ion-button>
                </ion-col>
              </ion-row>
              <!-- <ion-grid>
                  <ion-row class="text-center">
                    <ion-button
                      [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Allotment
                    </ion-button>
                  </ion-row>
                </ion-grid> -->
            </ion-card-content>
          </ion-card>
          <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
            <ion-icon name="chevron-up-outline"></ion-icon>
          </div>

          <ion-infinite-scroll (ionInfinite)="onIonInfinite($event,'Bill List')" [threshold]="250">
            <ion-infinite-scroll-content loadingSpinner="bubbles"
              loadingText="Loading more data..."></ion-infinite-scroll-content>
          </ion-infinite-scroll>
        </div>
        <div *ngIf="!showBillingListData?.length">
          <div class="img-wrapper">
            <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
            <p>No Data Available</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="btnCss text-center">
    <ion-button class="" *ngFor="let btn of splitBtnClass" class="actionBtn"
      [class.selected]="selectedValue == btn.btnName" (click)="getButtonName(btn)">
      {{btn.btnName}}</ion-button>
  </div>


  <ion-modal #filtermodal>
    <ng-template>
      <ion-header>
        <ion-toolbar>
          <ion-buttons slot="start">
            <ion-button (click)="cancel()">
              <ion-icon name="arrow-back"></ion-icon>
            </ion-button>
          </ion-buttons>
          <ion-title>Search</ion-title>
        </ion-toolbar>
      </ion-header>
      <ion-content class="ion-padding">
        <form [formGroup]="filterForm" (ngSubmit)="submitFilterForm(filterForm.value)">
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Booking ID</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Booking ID" formControlName="bookingId" (keyup)="transformText($event)"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">From Date</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="date" formControlName="fromDate"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Bill Date</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="date" formControlName="billDate"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Category</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-select interface="action-sheet" placeholder="Select Category"
                [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}" formControlName="category">
                <ion-select-option [value]=list.purposeId
                  *ngFor="let list of categoryList">{{list.purposeName}}</ion-select-option>
              </ion-select>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Purpose</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-select interface="action-sheet" placeholder="Select Purpose"
                [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}" formControlName="purpose">
                <ion-select-option value='1'>Official</ion-select-option>
                <ion-select-option value='2'>Private</ion-select-option>
                <ion-select-option value='3'>Patient</ion-select-option>
                <ion-select-option value='4'>Student</ion-select-option>
              </ion-select>
            </ion-item>
          </div>

          
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Mobile Number</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="Number" placeholder="Mobile Number" formControlName="mobNo"></ion-input>
            </ion-item>
          </div>
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Guest Name</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Guest Name" formControlName="name"></ion-input>
            </ion-item>
          </div>
          <ion-button type="submit" expand="block" style="margin: 20px 0px 0px 6px !important;
          width: 96% !important; --background: green !important;">Submit</ion-button>
        </form>
      </ion-content>
    </ng-template>
  </ion-modal>
</ion-content>