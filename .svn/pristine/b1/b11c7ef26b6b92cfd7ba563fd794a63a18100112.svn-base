package com.stl.ngms.admin.model;


public class CheckinRoom {
private String resWlId;
private String resWl;
private String roomNo;
private String type;
private String bedNo;
public String getResWlId() {
	return resWlId;
}
public void setResWlId(String resWlId) {
	this.resWlId = resWlId;
}
public String getResWl() {
	return resWl;
}
public void setResWl(String resWl) {
	this.resWl = resWl;
}
public String getRoomNo() {
	return roomNo;
}
public void setRoomNo(String roomNo) {
	this.roomNo = roomNo;
}
public String getType() {
	return type;
}
public void setType(String type) {
	this.type = type;
}
public String getBedNo() {
	return bedNo;
}
public void setBedNo(String bedNo) {
	this.bedNo = bedNo;
}
@Override
public String toString() {
	return "CheckinRoom [resWlId=" + resWlId + ", resWl=" + resWl + ", roomNo=" + roomNo + ", type=" + type + ", bedNo="
			+ bedNo + "]";
}




}
