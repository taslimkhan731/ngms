ul.login-panel {
	list-style: none;
	margin-left: 15%;
}

ul.login-panel li {
	float: left;
	padding-right: 10px;
	padding-top: 2px;
	border-right: 1px solid #a8ab92bd;
}

ul.login-panel li:last-child {
	border-right: none;
}

ul.login-panel li>a {
	text-decoration: none;
	color: white;
	font-size: 15px;
	padding-left: 10px;
	font-weight: 500;
}

ul.login-panel li a>img {
	width: 15px;
}
