ion-toolbar {
    --background: darkgreen;
    color: white;
    letter-spacing: 2px;
    font-size: 16px;

    ion-icon {
        font-size: xx-large;
        // background: white;
        // color: green;
        padding: 3px;
        // border-radius: 32px;
    }
}

ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

    .containerr {
        // padding: 2% 2%;

        ion-card {
            background: #FFFFFF;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            padding-bottom: 10px;
            

            ion-card-content {
                padding: 2px;
        
                .label-value {
                //   font-family: "Helvetica";
                  font-weight: 600 !important;
                  color: black;
                }
                
                ion-textarea {
                    border: 0.892779px solid #A2E6A7;
                    box-shadow: inset 1.78556px 1.78556px 2.67834px rgba(86, 103, 113, 0.29);
                    border-radius: 4.46389px;
                }

                .view-btn {
                    background: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
                    border: 1px solid #549f08;
                    color: #ffffff;
                    padding: 0.25rem 1rem;
                    font-size: .875rem;
                    line-height: 1.5;
                    border-radius: 0.2rem;
                }

      
                input:focus {
                    outline: none;
                }
            }


        }

        .submit-btn {
            --background: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
        }

        .cancel-btn {
            --background: linear-gradient(180deg, #deb224 0%, #da9417 100%);
        }
        .close-btn {
            --background: linear-gradient(180deg, #dc3545 0%, #c73644 100%);
        }
    }
}