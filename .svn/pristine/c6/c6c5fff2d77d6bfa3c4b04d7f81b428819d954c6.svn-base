<ion-toolbar>
  <ion-buttons slot="start">
    <ion-menu-button></ion-menu-button>
  </ion-buttons>
  <ion-title class="logo-text">Conference List</ion-title>
  <!-- <ion-buttons slot="end">
    <ion-icon name="notifications-outline"></ion-icon>
  </ion-buttons> -->
</ion-toolbar>
<ion-content [scrollEvents]="true" (ionScroll)="getScrollPos($event)">
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>
  <div *ngIf="confList?.length">
    <ion-card *ngFor="let data of confList">
      <ion-card-header>
        <ion-card-title>{{data.guestHouseName}} ,{{data.cityName}}</ion-card-title>
      </ion-card-header>
      <ion-card-content>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6">
            <ion-label class="label-key">Booking Id</ion-label><br>
            <ion-label class="label-value">{{data.bookingId}}</ion-label>
          </ion-col>
          <ion-col size="6">
            <ion-label class="label-key">Booking Date</ion-label><br>
            <ion-label class="label-value">{{data.bookingDt}}</ion-label>
          </ion-col>
        </ion-row>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6">
            <ion-label class="label-key">From Date</ion-label><br>
            <ion-label class="label-value">{{data.fromDate}}</ion-label>
          </ion-col>
          <ion-col size="6">
            <ion-label class="label-key">To Date</ion-label><br>
            <ion-label class="label-value">{{data.toDate}}</ion-label>
          </ion-col>
        </ion-row>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6">
            <ion-label class="label-key">Name</ion-label><br>
            <ion-label class="label-value">{{data.name}}</ion-label>
          </ion-col>
          <ion-col size="6">
            <ion-label class="label-key">Mobile Number</ion-label><br>
            <ion-label class="label-value">{{data.mobile}}</ion-label>
          </ion-col>
        </ion-row>
        <ion-row style="padding-left: 6px;">
          <ion-col size="6">
            <ion-label class="label-key">Hall Type</ion-label><br>
            <ion-label class="label-value">{{data.confrenceDesc}}</ion-label>
          </ion-col>
          <ion-col size="6">
            <ion-label class="label-key">Status</ion-label><br>
            <ion-label class="label-value">{{data.statusDesc}}</ion-label>
          </ion-col>
        </ion-row>
        <div class="buttons">
          <ion-grid>
            <ion-row>
              <ion-col >
                <ion-button
                  [ngStyle]="{'color':'#FFFFFF','--background':'rgb(7 192 96)','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('View',data)">
                  <!-- <ion-icon slot="start" name="eye-outline" style="font-size: 20px"></ion-icon> -->
                  View
                </ion-button>
              </ion-col>
              <ion-col *ngIf="data.status == 'REQ'">
                <ion-button
                  [ngStyle]="{'color':'#FFFFFF','--background':'#0a8787','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Edit',data)">
                  Edit
                </ion-button>
              </ion-col>
              <ng-container *ngIf="data.billStatus == 'P' || data.billStatus == 'FB' || data.billStatus == 'F'">
                <!-- <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#c32232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                    (click)="getbutton('Delete',data)">
                    Cancel
                  </ion-button>
                </ion-col> -->
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#2c41af','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                    (click)="getbutton('Bill View',data)">
                    Bill
                  </ion-button>
                </ion-col>
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#0b614a','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                    (click)="getbutton('Receipt View',data)">
                    Receipt
                  </ion-button>
                </ion-col>
              </ng-container>
              <!-- <ng-container *ngIf="data.billStatus == 'FB'">
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#2c41af','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                    (click)="getbutton('Bill View',data)">
                    Bill
                  </ion-button>
                </ion-col>
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#0b614a','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                    (click)="getbutton('Receipt View',data)">
                    Receipt
                  </ion-button>
                </ion-col>
              </ng-container>
              <ng-container *ngIf="data.billStatus == 'F'">
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#2c41af','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                    (click)="getbutton('Bill View',data)">
                    Bill
                  </ion-button>
                </ion-col>
                <ion-col>
                  <ion-button
                    [ngStyle]="{'color':'#FFFFFF','--background':'#0b614a','font-size':'smaller','font-weight':'600', 'width': 'auto'}"
                    (click)="getbutton('Receipt View',data)">
                    Receipt
                  </ion-button>
                </ion-col>
              </ng-container> -->
              <!-- <ion-col size="3">
                <ion-button [disabled]="data.billStatus !== 'P'"
                  [ngStyle]="{'color':'#FFFFFF','--background':'#0a8787','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Edit',data)">
                  Edit
                </ion-button>
              </ion-col>

              <ion-col size="4">
                <ion-button [disabled]="data.billStatus !== 'P'"
                  [ngStyle]="{'color':'#FFFFFF','--background':'#c32232','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Delete',data)">
                  Delete
                </ion-button>
              </ion-col>
              <ion-col size="6">
                <ion-button [disabled]="data.billStatus !== 'P' && data.billStatus !== 'F' "
                  [ngStyle]="{'color':'#FFFFFF','--background':'#2c41af','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Bill View',data)">
                  Bill View
                </ion-button>
              </ion-col>
              <ion-col size="6">
                <ion-button [disabled]="data.billStatus !== 'P' && data.billStatus !== 'F'"
                  [ngStyle]="{'color':'#FFFFFF','--background':'#0b614a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                  (click)="getbutton('Receipt View',data)">
                  Receipt View
                </ion-button>
              </ion-col> -->
            </ion-row>
          </ion-grid>
        </div>
      </ion-card-content>
    </ion-card>
    <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
      <ion-icon name="chevron-up-outline"></ion-icon>
    </div>
  </div>
  <ion-infinite-scroll (ionInfinite)="onIonInfinite($event)">
    <ion-infinite-scroll-content></ion-infinite-scroll-content>
  </ion-infinite-scroll>
  <ng-container *ngIf="! confList?.length" lines="none">
    <!-- <ion-label class="textCss">No Data Exist</ion-label> -->
    <div class="img-wrapper">
      <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
      <p>No Data Available</p>
    </div>
  </ng-container>
  <!-- <ion-item *ngIf="! confList?.length" lines="none">
    <ion-label class="textCss">No Data Exist</ion-label>
  </ion-item> -->
</ion-content>