package com.stl.ngms.admin.model;

public class TrConfBill {
	
	private String confBillId;
	private String reqId;
	private String charge;
	private String status;
	private String entryDate;
	private String ghId;
	private String additionalCharge;
	private String advanceAmount;
	private String ModeOfpayment;
	private String orderId;
	
	public String getConfBillId() {
		return confBillId;
	}
	public void setConfBillId(String confBillId) {
		this.confBillId = confBillId;
	}
	public String getReqId() {
		return reqId;
	}
	public void setReqId(String reqId) {
		this.reqId = reqId;
	}
	public String getCharge() {
		return charge;
	}
	public void setCharge(String charge) {
		this.charge = charge;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getEntryDate() {
		return entryDate;
	}
	public void setEntryDate(String entryDate) {
		this.entryDate = entryDate;
	}
	public String getGhId() {
		return ghId;
	}
	public void setGhId(String ghId) {
		this.ghId = ghId;
	}
	public String getAdditionalCharge() {
		return additionalCharge;
	}
	public void setAdditionalCharge(String additionalCharge) {
		this.additionalCharge = additionalCharge;
	}
	public String getAdvanceAmount() {
		return advanceAmount;
	}
	public void setAdvanceAmount(String advanceAmount) {
		this.advanceAmount = advanceAmount;
	}
	public String getModeOfpayment() {
		return ModeOfpayment;
	}
	public void setModeOfpayment(String modeOfpayment) {
		ModeOfpayment = modeOfpayment;
	}
	public String getOrderId() {
		return orderId;
	}
	public void setOrderId(String orderId) {
		this.orderId = orderId;
	}
	
	@Override
	public String toString() {
		return "TrConfBill [confBillId=" + confBillId + ", reqId=" + reqId + ", charge=" + charge + ", status=" + status
				+ ", entryDate=" + entryDate + ", ghId=" + ghId + ", additionalCharge=" + additionalCharge
				+ ", advanceAmount=" + advanceAmount + ", ModeOfpayment=" + ModeOfpayment + ", orderId=" + orderId
				+ "]";
	}
	
	
}
