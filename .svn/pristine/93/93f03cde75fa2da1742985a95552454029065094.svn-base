package com.stl.ngms.admin.model;

import java.util.List;

public class RoomDetails {
    private String allotId;
	private String bookingId;
    private String mrrId;
    private String roomNo;
    private String bedNo;
    private String roomRent;
    private String blockName;
    private String fromDate;
    private String toDate;
    private String guestName;
    private boolean occupied;
    private String type;
    private String roomBed;
	private String cityId;
	private String blockId;
	private String modifiedRoomNo;
	private String modifiedBedNo;
	private String modifiedRoomRent;
	private String prevOrderNo;
	private String prevOrderDate;
	private String reason;
	private String name;
	private String processId;
	private String status;
	private String periodOfStay;
	private String address;
	private int maxBeds;
	private List<RoomDetails> roomDetails;
	
	public String getPrevOrderDate() {
		return prevOrderDate;
	}
	public void setPrevOrderDate(String prevOrderDate) {
		this.prevOrderDate = prevOrderDate;
	}
	public String getAddress() {
		return address;
	}
	public void setAddress(String address) {
		this.address = address;
	}
	public String getPeriodOfStay() {
		return periodOfStay;
	}
	public void setPeriodOfStay(String periodOfStay) {
		this.periodOfStay = periodOfStay;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getProcessId() {
		return processId;
	}
	public void setProcessId(String processId) {
		this.processId = processId;
	}
	public String getAllotId() {
		return allotId;
	}
	public void setAllotId(String allotId) {
		this.allotId = allotId;
	}
	public String getMrrId() {
		return mrrId;
	}
	public void setMrrId(String mrrId) {
		this.mrrId = mrrId;
	}
	public String getRoomNo() {
		return roomNo;
	}
	public void setRoomNo(String roomNo) {
		this.roomNo = roomNo;
	}
	public String getBedNo() {
		return bedNo;
	}
	public void setBedNo(String bedNo) {
		this.bedNo = bedNo;
	}
	public String getRoomRent() {
		return roomRent;
	}
	public void setRoomRent(String roomRent) {
		this.roomRent = roomRent;
	}
	public String getBlockName() {
		return blockName;
	}
	public void setBlockName(String blockName) {
		this.blockName = blockName;
	}
	public String getFromDate() {
		return fromDate;
	}
	public void setFromDate(String fromDate) {
		this.fromDate = fromDate;
	}
	public String getToDate() {
		return toDate;
	}
	public void setToDate(String toDate) {
		this.toDate = toDate;
	}
	public String getGuestName() {
		return guestName;
	}
	public void setGuestName(String guestName) {
		this.guestName = guestName;
	}
	public boolean isOccupied() {
		return occupied;
	}
	public void setOccupied(boolean occupied) {
		this.occupied = occupied;
	}
	public String getType() {
		return type;
	}
	public void setType(String type) {
		this.type = type;
	}
	public String getRoomBed() {
		return roomBed;
	}
	public void setRoomBed(String roomBed) {
		this.roomBed = roomBed;
	}

	public String getBookingId() {
		return bookingId;
	}

	public void setBookingId(String bookingId) {
		this.bookingId = bookingId;
	}

	public String getCityId() {
		return cityId;
	}

	public void setCityId(String cityId) {
		this.cityId = cityId;
	}

	public String getBlockId() {
		return blockId;
	}

	public void setBlockId(String blockId) {
		this.blockId = blockId;
	}
		
	public String getModifiedRoomNo() {
		return modifiedRoomNo;
	}
	public void setModifiedRoomNo(String modifiedRoomNo) {
		this.modifiedRoomNo = modifiedRoomNo;
	}
	public String getModifiedRoomRent() {
		return modifiedRoomRent;
	}
	public void setModifiedRoomRent(String modifiedRoomRent) {
		this.modifiedRoomRent = modifiedRoomRent;
	}
	public String getPrevOrderNo() {
		return prevOrderNo;
	}
	public void setPrevOrderNo(String prevOrderNo) {
		this.prevOrderNo = prevOrderNo;
	}
	public String getReason() {
		return reason;
	}
	public void setReason(String reason) {
		this.reason = reason;
	}	
	public String getModifiedBedNo() {
		return modifiedBedNo;
	}
	public void setModifiedBedNo(String modifiedBedNo) {
		this.modifiedBedNo = modifiedBedNo;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}

	public int getMaxBeds() {
		return maxBeds;
	}

	public void setMaxBeds(int maxBeds) {
		this.maxBeds = maxBeds;
	}

	public List<RoomDetails> getRoomDetails() {
		return roomDetails;
	}

	public void setRoomDetails(List<RoomDetails> roomDetails) {
		this.roomDetails = roomDetails;
	}

	@Override
	public String toString() {
		return "RoomDetails [allotId=" + allotId + ", bookingId=" + bookingId + ", mrrId=" + mrrId + ", roomNo="
				+ roomNo + ", bedNo=" + bedNo + ", roomRent=" + roomRent + ", blockName=" + blockName + ", fromDate="
				+ fromDate + ", toDate=" + toDate + ", guestName=" + guestName + ", occupied=" + occupied + ", type="
				+ type + ", roomBed=" + roomBed + ", cityId=" + cityId + ", blockId=" + blockId + ", modifiedRoomNo="
				+ modifiedRoomNo + ", modifiedBedNo=" + modifiedBedNo + ", modifiedRoomRent=" + modifiedRoomRent
				+ ", prevOrderNo=" + prevOrderNo + ", reason=" + reason + ", name=" + name + ", processId=" + processId
				+ ", status=" + status + ", periodOfStay=" + periodOfStay + ", address=" + address
				+ ", maxBeds=" + maxBeds + "]";
	}
	
	
	
	
}
