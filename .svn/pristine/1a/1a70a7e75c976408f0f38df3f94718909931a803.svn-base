ion-content {
    .containerr {
        // padding: 2% 2%;

        ion-card {
            background: #FFFFFF;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            padding-bottom: 10px;

            ion-card-content {
                padding: 2px !important;

                // .label-value {
                //     font-family: "Exo 2";
                //     font-weight: 600 !important;
                //     color: black;
                // }

                table {
                    .thead th {
                        border: none !important;
                        border-left: 1px solid white !important;
                        background: linear-gradient(156.81deg, #50CB89 -22.76%, #109851 108.33%) ! important;
                        color: white;
                        padding: 4px 12px;
                    }

                    .tbody {
                        border: 1px solid #bebebe;

                        td {
                            padding: 7px;
                        }
                    }
                }

                input:focus {
                    outline: none;
                }
            }


        }
    }
}