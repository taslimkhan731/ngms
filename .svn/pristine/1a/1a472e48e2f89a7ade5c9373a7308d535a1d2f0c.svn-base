        //         font-size: xx-large;
        //         background: white;
        //         color: green;
        //         padding: 3px;
        //         border-radius: 32px;
        //     }
        // }
    }
}


::ng-deep .action-sheet-selected.sc-ion-action-sheet-ios {
  white-space: nowrap;       /* Prevent text from wrapping */
  // overflow: hidden;         /* Hide text that overflows the container */
  text-overflow: ellipsis;
  color: #000000 !important;
  font-size: 13px !important;
}

::ng-deep .action-sheet-button.sc-ion-action-sheet-ios {
  color: #000000 !important;
  font-size: 13px !important;
}

::ng-deep .action-sheet-cancel.sc-ion-action-sheet-ios {
  color: red !important;
  font-size: 13px !important;
}