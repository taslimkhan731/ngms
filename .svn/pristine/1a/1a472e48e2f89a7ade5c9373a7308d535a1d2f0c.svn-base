ion-toolbar {
    ion-title {
      position: relative;
      top: -2px;
      padding-left: 0px;
    }
  #filtermodal-modal{
    --background: green;
    --background-activated: green;
  }
    ion-button {
     
      font-size: 14px;
      position: relative;
      right: 10px;
  
      ion-icon {
        font-size: 21px;
      }
     
    }
   
  
  }
ion-content {
    --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

    .filterCls {
        margin: 0px 9px 0 11px;
        border-radius: 2px;
        background-color: #067e06;
        color: white;
        font-size: 95%;

        .lebel {
            padding: 14px
        }

        // ion-button {
