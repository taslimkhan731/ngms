<!-- <div class="background-img"></div> -->
<ion-content class="background-img">
    <div class="content">
        <ion-grid class="header-logo">
            <ion-row>
                <ion-col style="text-align: center;">
                    <img src="../../../assets/beforelogin/Logo.svg" class="mt-3" width="40%" height="46%">
                    <h3>e-bhawan</h3>
                    <p>Home Department, Government of Odisha</p>
                </ion-col>
            </ion-row>
        </ion-grid>
        <form [formGroup]="firstLogin" (ngSubmit)="FirstLoginDoc(firstLogin.value)">
            <ion-card class="my-card">
                <ion-card-header class="my-cardheader">
                    <ion-card-title class="my-cardtitle">Upload Document</ion-card-title>
                </ion-card-header>

                <ion-card-content class="my-cardcontent">
                    <ion-label class="label required">Identity Proof</ion-label>
                    <ion-select interface="action-sheet" placeholder="Select Identity Proof "
                        formControlName="selectDocType">
                        <ion-select-option value="Aadhar">Aadhar</ion-select-option>
                        <ion-select-option value="Pan No">Pan Card</ion-select-option>
                        <ion-select-option value="Passport">Passport</ion-select-option>
                        <ion-select-option value="DL">Driving Licence</ion-select-option>
                        <ion-select-option value="Bank Passbook with photo attached">Bank passbook with photo
                            attached</ion-select-option>
                        <ion-select-option value="Voter ID Card">Voter ID Card with photo</ion-select-option>
                        <ion-select-option value="Office ID Card with Photo">Office ID Card with
                            Photo</ion-select-option>
                    </ion-select>
                    <div class="text-error text-danger"
                        *ngIf="(firstLogin.controls.selectDocType.touched || firstLogin.controls.selectDocType.dirty) && firstLogin.controls.selectDocType.invalid">
                        <span class="text-danger" *ngIf="firstLogin.controls.selectDocType.errors?.required">*This field
                            is
                            mandatory</span>
                    </div>
                    <ion-label class="label required">Upload Proof(jpg/png/pdf-2MB)</ion-label>
                    <ion-input placeholder="Enter Office Address" type="file" clearInput="true"
                        formControlName="uploadDoc" (change)="handleUpload($event)"></ion-input>
                    <div class="text-error text-danger"
                        *ngIf="(firstLogin.controls.uploadDoc.touched || firstLogin.controls.uploadDoc.dirty) && firstLogin.controls.uploadDoc.invalid">
                        <span class="text-danger" *ngIf="firstLogin.controls.uploadDoc.errors?.required">*This fieldis
                            mandatory</span>
                    </div>
                    <ion-button type="submit" expand="block">Upload</ion-button>
                </ion-card-content>
            </ion-card>
        </form>
    </div>
</ion-content>