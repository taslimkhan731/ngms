ion-toolbar {
  ion-title {
    position: relative;
    top: -2px;
    padding-left: 0px;
  }
#filtermodal-modal{
  --background: green;
}
  ion-button {
   
    font-size: 14px;
    position: relative;
    right: 10px;

    ion-icon {
      font-size: 21px;
    }
   
  }
 

}


ion-content {
  .content {
    .cardHeight {
      height: calc(92vh - 100% - 83.29px);
      overflow-y: scroll;
    }

    .sticky-elements {
      position: sticky;
      top: 0;
      z-index: 1;
      /* Optionally, you can adjust the z-index if needed */
      background-color: white;
      /* Optionally, you can set a background color to make it visually distinct */
    }

    ion-grid {
      padding-bottom: 0px;

      .filter {

        .date {
          position: relative;
          top: 11px;
          color: white;
          display: flex;
          justify-content: center;
          font-size: 16px;
          font-weight: 100 !important;
        }

        ion-button {
          --background: green;
        }
      }
    }
  }


}