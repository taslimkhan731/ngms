<ion-content [scrollEvents]="true" (ionScroll)="getScrollPos($event)">
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>
  <!-- <ion-toolbar>
    <ion-buttons slot="start" (click)="goBack()">
      <ion-icon name="chevron-back-outline"></ion-icon>
    </ion-buttons>
    <ion-title>Cancel Reservation</ion-title>
  </ion-toolbar> -->
  <ion-header>
    <ion-toolbar>
      <ion-buttons slot="start" (click)="goBack()">
        <ion-icon name="chevron-back-outline"></ion-icon>
      </ion-buttons>
      <ion-title>Cancel Reservation</ion-title>
    </ion-toolbar>
  </ion-header>
  <div class="content">
    <div class="cardHeight" *ngIf="cancelReservationList?.length">
      <ion-card *ngFor="let data of cancelReservationList">
        <!-- <ion-card-header>
          <ion-card-title>{{data.ghName}},{{data.cityName}}</ion-card-title>
        </ion-card-header> -->
        <ion-card-content>
          <ion-row style="padding-left: 6px;">
            <ion-col size="6">
              <ion-label class="label-key">Booking Id</ion-label><br>
              <ion-label class="label-value">{{data.bookingId}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key">Booking Date</ion-label><br>
              <ion-label class="label-value">{{data.bookingDt}}</ion-label>
            </ion-col>
          </ion-row>
          <ion-row style="padding-left: 6px;">
            <ion-col size="6">
              <ion-label class="label-key">Name</ion-label><br>
              <ion-label class="label-value">{{data.name}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key">Designation</ion-label><br>
              <ion-label class="label-value">{{data.desg ? data.desg : 'NA'}}</ion-label>
            </ion-col>
          </ion-row>
          <ion-row style="padding-left: 6px;">
            <ion-col size="6">
              <ion-label class="label-key">From Date</ion-label><br>
              <ion-label class="label-value">{{data.fromDate}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key">To Date</ion-label><br>
              <ion-label class="label-value">{{data.toDate}}</ion-label>
            </ion-col>
          </ion-row>
          <ion-row style="padding-left: 6px;">
            <ion-col size="6">
              <ion-label class="label-key">Mobile No.</ion-label><br>
              <ion-label class="label-value">{{data.mobile}}</ion-label>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-key">Status</ion-label><br>
              <ion-label class="label-value">{{data.statusDesc}}</ion-label>
            </ion-col>
          </ion-row>
          <ion-row style="padding-left: 6px;">
            <ion-col size="12">
              <ion-label class="label-key">Email ID</ion-label><br>
              <ion-label class="label-value">{{data.email ? data.email : 'NA'}}</ion-label>
            </ion-col>

          </ion-row>
          <div>
            <ion-grid>
              <ion-row>
                <ng-container *ngIf="data.status == 'PRO';else content">
                  <ion-col>
                    <ion-button (click)="cancelReservation('cancel',data)"
                      [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','--background-activated':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Cancel
                    </ion-button>
                  </ion-col>
                  <ion-col *ngIf="checkIfOneDay(data) !== 1">
                    <ion-button (click)="cancelReservation('partialCan',data)"
                      [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','--background-activated':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Partial Cancel
                    </ion-button>
                  </ion-col>
                </ng-container>
                <ng-template #content>
                  <ion-col size="12">
                    <ion-button (click)="cancelReservation('partialCan',data)"
                      [ngStyle]="{'color':'#E91E34','--background':'#FFE2E5','--background-activated':'#FFE2E5','font-size':'83%','font-weight':'600', 'width': '-webkit-fill-available'}">
                      Partial Cancel
                    </ion-button>
                  </ion-col>
                </ng-template>

              </ion-row>
            </ion-grid>
          </div>
        </ion-card-content>
      </ion-card>
      <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
        <ion-icon name="chevron-up-outline"></ion-icon>
      </div>
    </div>
    <ng-container *ngIf="! cancelReservationList?.length">
      <div class="img-wrapper">
        <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
        <p>No Data Available</p>
      </div>
    </ng-container>
    <!-- <ion-item *ngIf="! cancelReservationList?.length" lines="none" style=" height: 63vh;overflow: scroll;">
      <ion-label class="textCss">No Data Exist</ion-label>
    </ion-item> -->
  </div>
  <!-- <div class="btnCss text-center">
    <ion-button class="" *ngFor="let btn of splitBtnClass"
      [ngStyle]="{'color':'white','--background':'#067e06','font-size':'12px','width':'25%','text-transform': 'initial'}"
      (click)="getButtonName(btn.btnName)">
      {{btn.btnName}}</ion-button>
  </div> -->
</ion-content>