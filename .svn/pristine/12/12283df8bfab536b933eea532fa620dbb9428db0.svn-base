ion-header {
  ion-img {
    border-radius: 10px;
  }
}

ion-menu.ios ion-item.profile {
  // border-radius: 6px;
  --background: #ffdfdb;
}

ion-menu.ios {
  margin-top: 44px;

  ion-content {
    --padding-start: 8px;
    --padding-end: 8px;
    --padding-top: 0px;
    --padding-bottom: 0px;
    --background: linear-gradient(#0B512CE5, #07750B);
   ion-accordian{
    --background: green;
   }

    ion-item {
      --padding-start: 8px;
      // --padding-top: 12px ;
      // --padding-bottom:12px;
      --padding-end: 5px;
      // border-radius: 13px;
      // --background: linear-gradient(#FFC107, #FF8A00);
      --background: linear-gradient(#64c17e, #B6EDBA);
      color: #46664F;
      font-size: 16px;
      // margin: 7px 0px 2px 0px;

      ion-icon {
        color: whitesmoke;
      }

      ion-label {
        font-family: 'lato', sans-serif;
        font-weight: 600;
      }
    }

    ion-item.selected {
      --background: linear-gradient(to top, #27a049, #06660d);
      color: white;

      ion-icon {
        color: whitesmoke;
      }

      ion-label {
        font-weight: 600;
        --color: white;
        font-size: 16px;
      }
    }
  }

  ion-note {
    display: inline-block;
    font-size: 16px;
    color: var(--ion-color-medium-shade);
  }
}

ion-menu-button {
  color: white;
}

ion-menu.ios ion-note {
  margin-bottom: 30px;
}

ion-menu.ios ion-list-header,
ion-menu.ios ion-note {
  padding-left: 10px;
}

ion-menu.ios ion-list#inbox-list {
  border-bottom: 1px solid var(--ion-color-step-150, #d7d8da);
}

ion-menu.ios ion-list#inbox-list ion-list-header {
  font-size: 22px;
  font-weight: 600;
  min-height: 20px;
}

ion-menu.ios ion-list#labels-list ion-list-header {
  font-size: 16px;
  margin-bottom: 18px;
  color: #757575;
  min-height: 26px;
}

ion-modal {
  ion-label {
    font-weight: 500;
    font-size: large;
  }
}

//////////////////////////////////////// ios ////////////////////////////////////////
ion-menu.ios ion-content {
  --padding-bottom: 20px;
}

ion-menu.ios ion-list {
  padding: 20px 0 0 0;
}

ion-menu.ios ion-note {
  line-height: 24px;
  margin-bottom: 20px;
}

ion-menu.ios ion-item {
  --padding-start: 16px;
  --padding-end: 16px;
  --min-height: 50px;
}

ion-menu.ios ion-item.selected ion-icon {
  color: var(--ion-color-primary);
}

ion-menu.ios ion-item ion-icon {
  font-size: 24px;
  color: #73849a;
}

ion-menu.ios ion-list#labels-list ion-list-header {
  margin-bottom: 8px;
}

ion-menu.ios ion-list-header,
ion-menu.ios ion-note {
  padding-left: 16px;
  padding-right: 16px;
}

ion-menu.ios ion-note {
  margin-bottom: 8px;
}

#container {
  text-align: center;
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

#container strong {
  font-size: 20px;
  line-height: 26px;
}

#container p {
  font-size: 16px;
  line-height: 22px;
  color: #8c8c8c;
  margin: 0;
}

#container a {
  text-decoration: none;
}

.imgdsgn {
  align-items: center;
}
@media(max-width: 380px){
  .ios ion-menu{
    padding-top: 40px;
    
  }
}