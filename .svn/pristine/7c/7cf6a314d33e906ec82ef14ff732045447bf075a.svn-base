/*
 * App Global CSS
 * ----------------------------------------------------------------------------
 * Put style rules here that you want to apply globally. These styles are for
 * the entire app and not just one component. Additionally, this file can be
 * used as an entry point to import other CSS/Sass files to be included in the
 * output CSS.
 * For more information on global stylesheets, visit the documentation:
 * https://ionicframework.com/docs/layout/global-stylesheets
 */

/* Core CSS required for Ionic components to work properly */
@import "~@ionic/angular/css/core.css";

/* Basic CSS for apps built with Ionic */
@import "~@ionic/angular/css/normalize.css";
@import "~@ionic/angular/css/structure.css";
@import "~@ionic/angular/css/typography.css";
@import "~@ionic/angular/css/display.css";

/* Optional CSS utils that can be commented out */
@import "~@ionic/angular/css/padding.css";
@import "~@ionic/angular/css/float-elements.css";
@import "~@ionic/angular/css/text-alignment.css";
@import "~@ionic/angular/css/text-transformation.css";
@import "~@ionic/angular/css/flex-utils.css";

/* css utils added after bootstrap installation */
@import "~bootstrap/dist/css/bootstrap.css";
@import "../node_modules/bootstrap/scss/functions";
@import "../node_modules/bootstrap/scss/variables";
@import "../node_modules/bootstrap/scss/mixins";
// @import "../node_modules/ngx-toastr/toastr-bs4-alert";
// @import "../node_modules/font-awesome/scss/font-awesome";
// @import "../node_modules/font-awesome-animation/dist/font-awesome-animation.min.css";
// @import "../node_modules/font-awesome/css/font-awesome.css";
// from old project.
// @import '~ngx-toastr/toastr';

@font-face {
  font-family: 'lato';
  /* Choose a suitable font-family name */
  src: url('../src/assets/font/Lato/Lato-Light.ttf') format('truetype');
  /* Adjust the path to your font file */
  font-weight: 500;
  // font-style: normal;
}

.required::after {
  content: "*";
  color: red;
  margin-right: 5px;
}

ion-toolbar {
  --background: darkgreen;
  color: white;
  letter-spacing: 2px;
  font-size: 16px;

  ion-title {
    position: relative;
    // top: -2px;
    font-size: 17px;
    width: 350px !important;
    padding-left: 0px !important;
  }

  ion-icon {
    font-size: xx-large;
    padding: 3px;
  }
}

ion-content {
  --background: linear-gradient(180deg, #ebf5ea, #c1e9d3);

  .cs-input ion-input {
    border-top-right-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
  }

  .datetime-button {
    padding-top: 5px;
    padding-bottom: 6px;
    background: #A2E6A7;
    width: 100%;

    ion-datetime-button,
    input[type="date"] {
      font-size: 100px;
      left: 0;
      opacity: 0;
      position: absolute;
      top: 0;
    }
  }

  .content {
    padding: 2px;

  }

  .containerr {
    margin-bottom: 10% !important;
  }

  .back-to-top-btn {
    background: #000000;
    position: fixed;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    left: 50%;
    transform: translateX(-50%);
    bottom: 87px;
    z-index: 99999;
  }

  .img-wrapper {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);

    .noDataAvail {
      height: 100px;
      width: 100px;
      margin-left: 15px;
    }

    p {
      font-family: 'Exo 2';
      color: #7d7d7d;
    }
  }

  .guestCls {
    padding: 0%;
    border: 1px solid green;
    margin: 1% 5%;
    border-radius: 4px;
  }

  ion-card {
    // background: #FFFFFF;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
    border: 1px solid #d6d6d6;
    border-radius: 10px;
    padding-bottom: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    background: #F5FEF9;

    ion-card-header {
      padding-top: 10px;
      padding-bottom: 2px;
      // margin-bottom: 15px;

      ion-label {
        font-family: 'Exo 2' !important;
        font-style: normal;
        font-weight: 600;
        font-size: 16px;
        line-height: 100%;
        display: flex;
        align-items: center;
        text-align: center;
        color: #0F8D4B;

        ion-icon {
          margin-right: 10px;
          color: #0F8D4B;
          font-weight: 600;
          font-size: 20px;
          // position: relative;
        }
      }

      ion-label::before {
        content: "";
        position: absolute;
        bottom: -6px;
        height: 3px;
        width: 87px;
        background: #0FA958;
        display: block;
        z-index: 2;
      }

      ion-card-title {
        font-family: 'Exo 2' !important;
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 22px;
        /* identical to box height */
        text-transform: uppercase;
        color: #108444;
      }
    }

    ion-card-content {
      padding: 0 10px !important;

      .guestClass {
        border: 1px solid green;
        margin: 4px;
        border-radius: 9px;
        padding: 11px;
      }

      .label-value {
        // font-family: "Helvetica";
        font-weight: 600 !important;
        color: black;
      }
    }

  }

  .filterCls {
    margin: 0px 9px 0 11px;
    border-radius: 2px;
    background-color: #067e06;
    color: white;
    font-size: 95%;

    .lebel {
      padding: 14px
    }

    ion-button {
      --background: white;
      --background-activated: white;
      color: rgb(4 114 4);
      border-radius: 4px;
      height: 32px;

      ion-icon {
        font-size: xx-large;
        background: white;
        color: green;
        padding: 3px;
        border-radius: 32px;
      }
    }
  }

  .cardHeight {
    margin-bottom: 20%;
  }

  .submit-btn {
    --background: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
    --background-activated: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
    text-transform: capitalize;
  }

  .cancel-btn {
    --background: linear-gradient(180deg, #deb224 0%, #da9417 100%);
    --background-activated: linear-gradient(180deg, #deb224 0%, #da9417 100%);
  }

  .close-btn {
    --background: linear-gradient(180deg, #dc3545 0%, #c73644 100%);
    --background-activated: linear-gradient(180deg, #dc3545 0%, #c73644 100%);
  }

  .view-btn {
    background: linear-gradient(180deg, #549f08 0%, #0f8d4b 100%);
    border: 1px solid #549f08;
    color: #ffffff;
    padding: 0.25rem 1rem;
    font-size: .875rem;
    line-height: 1.5;
    border-radius: 0.2rem;
  }
}


::ng-deep .action-sheet-selected.sc-ion-action-sheet-ios {
  white-space: nowrap;       /* Prevent text from wrapping */
  // overflow: hidden;         /* Hide text that overflows the container */
  text-overflow: ellipsis;
  color: #000000 !important;
  font-size: 13px !important;
}

::ng-deep .action-sheet-button.sc-ion-action-sheet-ios {
  color: #000000 !important;
  font-size: 13px !important;
}

::ng-deep .action-sheet-cancel.sc-ion-action-sheet-ios {
  color: red !important;
  font-size: 13px !important;
}
::ng-deep .native-input[disabled].sc-ion-input-ios , ::ng-deep .native-textarea[disabled].sc-ion-textarea-ios{
  opacity: 0.9 !important;
}

::ng-deep .mycomponent-wider-popover {
  --width: 95%;
  --max-width: 400px;
}

.btnCss {
  position: fixed;
  bottom: 0;
  height: 80.29px !important;
  background-color: #a9fbd2 !important;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 5px;
  z-index: 9999;

  .scroll-container {
    // border: 2px solid silver;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
}

.actionBtn {
  color: white;
  --background: rgb(7 192 96);
  --background-activated: rgb(7 192 96);
  font-size: 14px !important;
  // width: 22%;
  text-transform: initial;
}

.selected {
  color: white;
  --background: linear-gradient(#1b804a 90%, #226624 90%);
  --background-activated: linear-gradient(#1b804a 90%, #226624 90%);
  font-size: 14px !important;
  // width: 24%;
  text-transform: initial;
}

ion-menu-button {
  color: #ffffff !important;
}

