.card.profile-card{
margin: 0 auto;	
}

.cust-gr {
	margin-bottom: 0.5rem
}

.cust-gr .input-group-prepend {
	margin-right: 0rem;
}

.cust-gr .input-group-text {
	padding: 0 1rem;
	border-width: 0;
	border-radius: 0;
	background-color: #8ce38c;
}

.cust-gr img {
	width: 32px;
}

.cust-gr .form-control {
	background-color: transparent;
	border-radius: 0;
	border:none;
	box-shadow: 0 0 0 0;
}

.cust-gr .form-control:focus {
	box-shadow: 0 0 0 0;
	border:none;
}


/*____________________fieldset_______________________*/
.the-fieldset {
	background: linear-gradient(180deg, #FFFFFF 0%, #F7F8F7 80.21%);
	border: 0.892779px solid #A2A2A2;
	border-radius: 6px;
	padding: 0px 9px;
	/* position: relative; */
	/* width: 224.93px; */
	width: 100%;
	margin-bottom: 5px;
}
.the-legend {
	    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    display: flex;
    align-items: center;
    color: #414042;
    margin-bottom: -6px;
    width: auto;
    padding: 2px 4px;
}
.the-legend2 {
    /* font-family: 'Roboto'; */
    /* font-family: 'Roboto'; */
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 10px;
    display: flex;
    align-items: left;
    color: #414042;
    margin-bottom: 1px;
    width: auto;
    padding: -3px -1px !important;
}
.form-control {
    padding:0px !important;
   
} 

