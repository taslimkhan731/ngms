input[type],
input::placeholder {
        font-size: 15px;
}
.card-header {
    font-size: 16px;
    letter-spacing: 2px;
    padding: 0.5rem 1rem;
    text-transform: uppercase;
    font-weight: 500;
    background: linear-gradient(156.81deg, #109851 -22.76%, #50CB89 108.33%) !important;
    /* background: linear-gradient(156.81deg, #50CB89 -22.76%, #109851 108.33%) !important; */
    color: white !important;
    margin-right: -15px !important;
    margin-left: -15px !important;
}
fieldset input::file-selector-button {
	border: thin solid grey;
	border-radius: 3px;
}
input {
	border: none;
	padding: 4px;
	width: 100%;
	background-color: transparent;
}
label {
    display: inline-block;
    margin-bottom: 0rem !important;
    line-height: 1 !important;
}
.file-upload{
	font-size:13px !important;
}
select {
	border: none;
	background: transparent;
	width: 100%;
	padding: 2px !important;
	margin-bottom: 5px !important;
}
.btn-submit {
    background: linear-gradient(180deg, #549F08 0%, #0F8D4B 100%);
    box-shadow: 3px 2px 5px rgb(0 0 0 / 25%);
    border-radius: 6px;
    border: 1px solid transparent;
    font-family: 'Roboto';
    font-style: normal;
    font-weight: 500;
    font-size: 17px;
    line-height: 18px;
    /* display: flex; */
    text-align: center;
    text-transform: capitalize;
    color: #FFFFFF;
    padding: 8px 10px;
}
.btn.show{
	width: 130.64px;
    height: 39.66px;
	background: linear-gradient(to right, #ff0000 0%, #990000 100%);
	box-shadow: 3px 2px 5px rgb(0 0 0 / 25%);
    border-radius: 6px;
    border: 1px solid transparent;
    font-family: 'Roboto';
    font-style: normal;
    font-weight: 500;
    font-size: 17px;
    line-height: 18px;
    /* display: flex; */
    text-align: center;
    text-transform: capitalize;
    color: #FFFFFF;
}
.custom-file-label {
    border: none !important;
    background: none !important;
    height: calc(1.5rem + 0.3rem + 1px) !important;
    padding-top:16px !important;
}
.custom-file-label::after {
    height: calc(1.5em + 0.8rem) !important;
    padding: 0.4rem 1rem !important;
    margin-top: 6px;
}
.custom-file {
        height: calc(1.3em + 1.4rem + 1px) !important;
}