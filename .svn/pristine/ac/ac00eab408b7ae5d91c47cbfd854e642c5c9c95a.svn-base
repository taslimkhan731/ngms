<!-- <ion-toolbar>
  <ion-buttons slot="start">
    <ion-menu-button auto-hide="false"></ion-menu-button>
  </ion-buttons>
  <ion-title>{{headerName}}</ion-title>
  <ion-button slot="end" id="filtermodal-modal" (click)="openFilterModal()">
    <ion-icon name="filter-outline"></ion-icon>&nbsp;Filter
  </ion-button>
</ion-toolbar> -->
<ion-header>
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button auto-hide="false"></ion-menu-button>
    </ion-buttons>
    <ion-title>{{headerName}}</ion-title>
    <ion-button slot="end" id="filtermodal-modal" (click)="openFilterModal()">
      <ion-icon name="filter-outline"></ion-icon>&nbsp;Filter
    </ion-button>
  </ion-toolbar>
</ion-header>
<ion-content [scrollEvents]="true" (ionScroll)="getScrollPos($event)">

  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>
  <div class="content">
    <div>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select City" [(ngModel)]="selectCity"
          (ionChange)="getGuestHouseList($event)" [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.cityId *ngFor="let item of getAllCityList">{{item.cityName}}
          </ion-select-option>
        </ion-select>
      </ion-item>
      <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
        <ion-select interface="action-sheet" placeholder="Select Guest House" [(ngModel)]="selectGH"
          [interfaceOptions]="{'cssClass': 'mycomponent-wider-popover'}">
          <ion-select-option [value]=item.id *ngFor="let item of guestHouseList">{{item.name}}</ion-select-option>
        </ion-select>
      </ion-item>
    </div>
    <div class="cardHeight">
      <ng-container *ngIf="selectedValue=='VALLOT'">
        <ion-card *ngFor="let data of allotmentList " class="mt-1">
          <ion-card-content>
            <ion-row style="padding-left: 6px;" class="mt-1">
              <ion-col size="6">
                <ion-label class="label-key">Booking ID</ion-label><br>
                <ion-label class="label-value">{{data.reqId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Guest Name</ion-label><br>
                <ion-label class="label-value">{{data.guestDetails.name}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Gender</ion-label><br>
                <ion-label class="label-value">
                  <ng-container *ngIf="data.guestDetails.gender === 'F'">Female</ng-container>
                  <ng-container *ngIf="data.guestDetails.gender === 'M'">Male</ng-container>
                  <ng-container *ngIf="data.guestDetails.gender === 'O'">Others</ng-container>
                </ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Department</ion-label><br>
                <ion-label class="label-value">{{data.guestDetails.department ? data.guestDetails.department : 'NA' }}
                </ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Designation</ion-label><br>
                <ion-label class="label-value">{{data.guestDetails.designation ? data.guestDetails.designation : 'NA'}}
                </ion-label>
              </ion-col>
            </ion-row>

            <div class="guestCls">
              <!-- <ion-label class="user_Name">Guest Details</ion-label> -->
              <ion-accordion-group>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Vehicle Arrival Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.arrival != 0">
                      <ion-col size="6">
                        <ion-label class="label-key">Mode of Travel</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">
                          <ng-container *ngIf="data.arrivalDetails.modeOfTravel == 'F'">FLIGHT</ng-container>
                          <ng-container *ngIf="data.arrivalDetails.modeOfTravel == 'T'">TRAIN</ng-container>
                          <ng-container
                            *ngIf="data.arrivalDetails.modeOfTravel  !=='F' &&data.arrivalDetails.modeOfTravel != 'T'">
                            Other</ng-container>
                        </ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Train/Flight Number:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.arrivalDetails.vehNumber}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Arrival Place </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrivalDetails.place}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Arrival Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrivalDetails.stratTime}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.arrival == 0">
                      <ion-col class="label-key ion-padding">Vehicle for arrival not requested.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label>Vehicle Departure Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.departure != 0">
                      <ion-col size="6">
                        <ion-label class="label-key">Mode of Travel</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">
                          <ng-container *ngIf="data.departureDetails.modeOfTravel == 'F'">FLIGHT</ng-container>
                          <ng-container *ngIf="data.departureDetails.modeOfTravel == 'T'">TRAIN</ng-container>
                          <ng-container
                            *ngIf="data.departureDetails.modeOfTravel  !=='F' &&data.departureDetails.modeOfTravel != 'T'">
                            Other</ng-container>
                        </ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Train/Flight Number:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.departureDetails.vehNumber}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Departure Place </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.departureDetails.place}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Departure Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.departureDetails.stratTime}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.departure == 0">
                      <ion-col class="label-key ion-padding">Vehicle for departure not requested.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
              </ion-accordion-group>
            </div>

            <div class="text-center mb-2">
              <ion-grid>
                <ion-row>
                  <ion-col *ngIf="data.checkStatus == '0';else edit">
                    <ion-button
                      [ngStyle]="{'color':'#0078FF','text-transform':'capitalize','--background':'#E1EDFF','--background-activated':'#E1EDFF','font-size':'smaller','font-weight':'600', 'width': '50%'}"
                      (click)="getbutton(data,'ADD')">Allot Vehicle</ion-button>
                  </ion-col>

                  <ng-template #edit>
                    <ion-col>
                      <ion-button
                        [ngStyle]="{'color':'#0AA0A0','text-transform':'capitalize','--background':'#DAFEFE','--background-activated':'#DAFEFE','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton(data,'EDIT')">Edit Allot Vehicle</ion-button>
                    </ion-col>
                    <ion-col>
                      <ion-button
                        [ngStyle]="{'color':'#E91E34','text-transform':'capitalize','--background':'#FFE2E5','--background-activated':'#FFE2E5','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
                        (click)="getbutton(data,'CAN')">Cancel Vehicle</ion-button>
                    </ion-col>
                  </ng-template>
                </ion-row>
              </ion-grid>
            </div>
          </ion-card-content>
        </ion-card>
        <div *ngIf="!allotmentList?.length">
          <div class="img-wrapper">
            <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
            <p>No Data Available</p>
          </div>
        </div>
      </ng-container>
      <ng-container *ngIf="selectedValue=='VREPORT'">
        <ion-card *ngFor="let data of allotmentReportList " class="mt-1">
          <ion-card-content>
            <ion-row style="padding-left: 6px;" class="mt-1">
              <ion-col size="6">
                <ion-label class="label-key">Booking ID</ion-label><br>
                <ion-label class="label-value">{{data.reqId}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Guest Name</ion-label><br>
                <ion-label class="label-value">{{data.name}}</ion-label>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Department</ion-label><br>
                <ion-label class="label-value" *ngIf="data.department==null else showData">--</ion-label>
                <ng-template #showData>
                  <ion-label class="label-value">{{data.department}}</ion-label>
                </ng-template>
              </ion-col>
              <ion-col size="6">
                <ion-label class="label-key">Designation</ion-label><br>
                <ion-label class="label-value" *ngIf="data.designation==null else show">--</ion-label>
                <ng-template #show>
                  <ion-label class="label-value">{{data.designation}}</ion-label>
                </ng-template>
              </ion-col>
            </ion-row>

            <div class="guestCls">
              <!-- <ion-label class="user_Name">Guest Details</ion-label> -->
              <ion-accordion-group>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Arrival Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.arrtripSattus == 'A'">
                      <ion-col size="6">
                        <ion-label class="label-key">Place </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrivalPlace}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Time of Report </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrTimeOfReport}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Mode of Travel</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">
                          <ng-container *ngIf="data.arrModOfTravel == 'f'||data.arrModOfTravel == 'F'">FLIGHT
                          </ng-container>
                          <ng-container *ngIf="data.arrModOfTravel == 'T' || data.arrModOfTravel =='t'">TRAIN
                          </ng-container>
                        </ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Ft Number:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.arrFtNo}}</ion-label>
                      </ion-col>


                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.arrtripSattus == null">
                      <ion-col class="label-key ion-padding">Vehicle for arrival not requested.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Arrival Driver/Protocol Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.arrDriverName !== null">
                      <ion-col size="6">
                        <ion-label class="label-key">Protocol Name</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrProtocolNo}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Protocol No:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.arrProtocolName}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Driver Name </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrDriverName}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Driver No </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrDriverNo}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.arrDriverName == null">
                      <ion-col class="label-key ion-padding">No data available.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Arrival Vehicle Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.arrStrtTime !== null">
                      <ion-col size="6">
                        <ion-label class="label-key">Vehicle Name</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrVehDetails}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Vehicle No:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.arrVehNo}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Vehicle Start Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrStrtTime}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">End Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.arrEndTime}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.arrStrtTime == null">
                      <ion-col class="label-key ion-padding">No data available.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Departure Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.depTripSattus == 'D'">
                      <ion-col size="6">
                        <ion-label class="label-key">Mode of Travel</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">
                          <ng-container *ngIf="data.depModOfTravel == 'f'||data.depModOfTravel == 'F'">FLIGHT
                          </ng-container>
                          <ng-container *ngIf="data.depModOfTravel == 'T' || data.depModOfTravel =='t'">TRAIN
                          </ng-container>
                        </ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Train/Flight Number:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.depFtNo}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Departure Place </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.deparrivalPlace}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Departure Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depTimeOfReport}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.depTripSattus == null">
                      <ion-col class="label-key ion-padding">Vehicle for departure not requested.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Departure Driver/Protocol Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.depDriverName !== null">
                      <ion-col size="6">
                        <ion-label class="label-key">Protocol Name</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depProtocolName}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Protocol No:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.depProtocolNo}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Driver Name </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depDriverName}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Driver No </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depDriverNo}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.depDriverName == null">
                      <ion-col class="label-key ion-padding">No data available.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
                <ion-accordion>
                  <ion-item slot="header" style="--background: #e1ffef;">
                    <ion-label class="label-key">Departure Vehicle Details</ion-label>
                  </ion-item>
                  <div slot="content" class="insideAccordian">
                    <ion-row style="padding-left: 6px;" *ngIf="data.depStrtTime !== null">
                      <ion-col size="6">
                        <ion-label class="label-key">Vehicle Name</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depVehDetails}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Vehicle No:</ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <!-- <ion-label class="label-key">Train/Flight Number:</ion-label><br> -->
                        <ion-label class="label-value">{{data.depVehNo}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">Vehicle Start Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depStrtTime}}</ion-label>
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-key">End Time </ion-label><br>
                        <!-- <ion-label class="label-value">{{data.guestDetails.designation}}</ion-label> -->
                      </ion-col>
                      <ion-col size="6">
                        <ion-label class="label-value">{{data.depEndTime}}</ion-label>
                      </ion-col>
                    </ion-row>
                    <ion-row style="padding-left:6px;" *ngIf="data.depStrtTime == null">
                      <ion-col class="label-key ion-padding">No data available.</ion-col>
                    </ion-row>
                  </div>
                </ion-accordion>
              </ion-accordion-group>
            </div>
          </ion-card-content>
        </ion-card>
        <div *ngIf="!allotmentReportList?.length">
          <div class="img-wrapper">
            <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
            <p>No Data Available</p>
          </div>
        </div>
        <div class="back-to-top-btn" *ngIf="backToTop" (click)="gotToTop()">
          <ion-icon name="chevron-up-outline"></ion-icon>
        </div>
        <ion-infinite-scroll (ionInfinite)="onIonInfinite($event)" [threshold]="250">
          <ion-infinite-scroll-content loadingSpinner="bubbles" loadingText="Loading more data...">
          </ion-infinite-scroll-content>
        </ion-infinite-scroll>
      </ng-container>
    </div>
  </div>
  <ion-modal #filtermodal>
    <ng-template>
      <ion-header>
        <ion-toolbar>
          <ion-buttons slot="start">
            <ion-button (click)="cancel()">
              <ion-icon style="color:#ffffff" name="arrow-back"></ion-icon>
            </ion-button>
          </ion-buttons>
          <ion-title>Search</ion-title>
        </ion-toolbar>
      </ion-header>
      <ion-content class="ion-padding">
        <form [formGroup]="filterForm" (ngSubmit)="submitFilterForm(filterForm.value)">
          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Booking ID</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Booking ID" formControlName="bookingId"
                (keyup)="transformText($event)"></ion-input>
            </ion-item>
          </div>


          <div style="margin-top: 5px;">
            <div style="position: relative; left: 13px; font-size: 18px;">Guest Name</div>
            <ion-item class="mt-1" style="border: 2px solid green;margin: 0px 9px 0 10px;border-radius: 6px;">
              <ion-input type="text" placeholder="Guest Name" formControlName="name"></ion-input>
            </ion-item>
          </div>
          <ion-button type="submit" expand="block" style="margin: 20px 0px 0px 6px !important;
          width: 96% !important; --background: green !important;--background-activated: green !important;">Submit</ion-button>
        </form>
      </ion-content>
    </ng-template>
  </ion-modal>

</ion-content>
<div class="btnCss text-center">
  <div class="scroll-container" style="overflow: auto">
    <ion-button *ngFor="let btn of splitBtnClass" class="actionBtn" [class.selected]="selectedValue == btn.btn"
      (click)="getButtonName(btn.btnName)">{{btn.btnName}}</ion-button>
  </div>
</div>