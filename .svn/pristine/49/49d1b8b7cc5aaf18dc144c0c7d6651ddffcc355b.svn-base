/* Add fade animation to dropdown menus */

@keyframes fadeAnimation {
  from {
    opacity: 0;
    top: 120%;
  }

  to {
    opacity: 1;
    top: 100%;
  }
}

@-webkit-keyframes fadeAnimation {
  from {
    opacity: 0;
    top: 120%;
  }

  to {
    opacity: 1;
    top: 100%;
  }
}

