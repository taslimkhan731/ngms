  min-height: 100%;
  background: url("../img/background.png") repeat scroll 0 0 rgba(0, 0, 0, 0);
  font-size: 13px;
}

a {
  color: #3c8dbc;
}

a:hover,
a:active,
a:focus {
  outline: none;
  text-decoration: none;
  color: #72afd2;
  cursor: pointer;
}

