/* skin-nic navbar */

.skin-nic .maindiv .header {
  background: url("../img/bg2.png") repeat scroll 0 0 / contain  rgba(0, 0, 0, 0);
  border-bottom-left-radius: 7px;
  border-bottom-right-radius: 7px;
}

.skin-nic .menu {
  margin-top: 40px;
}

.skin-nic .navbar {
  margin-bottom: 10px;
  position: relative;
}

.skin-nic .navbar .nav a {
  color: #F0F4F6;
  font-weight: bold;
}



.skin-nic .navbar .nav > li > a:hover,
.skin-nic .navbar .nav > li > a:active,
.skin-nic .navbar .nav > li > a:focus {
  /* background: url("../img/btnbg.png") repeat scroll 0 0 / contain  #3c729d; */
  text-decoration: none;
  color: #abed96;
  background: transparent;
}

.skin-nic .navbar .sidebar-toggle .icon-bar {
  background: rgba(255, 255, 255, 0.8);
}

.skin-nic .navbar .sidebar-toggle:hover .icon-bar {
  background: #f6f6f6 !important;
}

/* skin-nic logo */

.skin-nic .logo {
  background-color: #2A394F;
  color: #f9f9f9;
  position: fixed;
}



/* skin-nic content header */

/* skin-nic user panel */

/* skin-nic sidebar */

.min-height {
  min-height: 200px;
}

.maindiv {
  margin: 0 auto;
  width: 95%;
}

.content-header {
  background: none repeat scroll 0 0 #ffffff;
  border: 1px solid #cccccc;
  height: 70px;
  padding: 10px 15px 10px 20px;
  position: relative;
  text-align: center;
}

.content-header > .breadcrumb {
  background: none repeat scroll 0 0 rgba(0, 0, 0, 0);
  border-radius: 2px;
  float: right;
  font-size: 12px;
  margin-bottom: 0;
  margin-top: 0;
  padding: 7px 5px;
  position: absolute;
  right: 10px;
  top: 15px;
}

.content-header > .breadcrumb > li > a {
  color: #fffbfb;
  margin-right: 3px;
  text-decoration: none;
}

.skin-nic .logo {
  background: url("../img/logo.png") no-repeat scroll 10px center rgba(0, 0, 0, 0);
  color: #f9f9f9;
  height: 90px;
  position: absolute;
  width: 390px;
}

.info {
  color: #dddddd;
  font-size: 11px;
  font-weight: bold;
  position: absolute;
  right: 20px;
  text-align: right;
  top: 9px;
}

.info-menu {
  display: table;
  list-style: outside none none;
  margin: 1px 0 0;
  padding: 4px 0;
  width: auto;
  z-index: 1000;
}

.user-info {
  display: table;
  list-style: outside none none;
  margin: 1px 0 0;
  padding: 4px 0;
  width: auto;
  z-index: 1000;
}

.user-info h4 {
  margin: 0px;
}

.user-info p {
  color: #97d7f5;
  margin: 5px 0;
}

.user-img {
  display: table-cell;
  text-align: right;
  vertical-align: top;
  width: 90px;
}

.user-img img {
  border: 3px solid #ffffff;
  border-radius: 4px;
  width: 60px;
}

input,
textarea {
  background-color: #ffffff;
  background-image: none;
  border: 1px solid #cccccc;
  border-radius: 4px;
  box-shadow: 0 1px 1px rgba(0, 0, 0, 0.075) inset;
  color: #555555;
  display: block;
  font-size: 13px;
  line-height: 1.42857;
  padding: 6px;
  transition: border-color 0.15s ease-in-out 0s, box-shadow 0.15s ease-in-out 0s;
}

.full {
  width: 100%;
}

.md {
  width: 50%;
}

.lg {
  width: 75%;
}

.xs {
  width: 20%;
}

.blue-table tr td {
  background: url("../img/gradback.png") repeat-x scroll 0 0 #e8edff;
  border-bottom: 1px solid #ffffff;
  border-top: 1px solid #ffffff;
  color: #666699;
  padding: 8px;
}

.blue-table tr th {
  background: url("../img/gradhead.png") repeat-x scroll 0 0 #b9c9fe;
  border-bottom: 1px solid #ffffff;
  border-top: 2px solid #d3ddff;
  color: #003399;
  font-size: 13px;
  font-weight: normal;
  padding: 8px;
}

.min-height {
  min-height: 200px;
}

.center {
  float: none;
  margin: 0 auto;
}

