<ion-content>
  <!-- <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button></ion-menu-button>
    </ion-buttons>
    <ion-title class="logo-text">Change Password</ion-title>
  </ion-toolbar> -->
  <ion-header>
    <ion-toolbar>
      <ion-buttons slot="start">
        <ion-menu-button></ion-menu-button>
      </ion-buttons>
      <ion-title>Change Password</ion-title>
    </ion-toolbar>
  </ion-header>
  <div class="content">
    <form [formGroup]="changePasswordForm" class="mt-2" (submit)="changePassword(changePasswordForm.value)">
      <ion-card style="margin: 10px;">
        <ion-item>
          <ion-label position="stacked">Current Password</ion-label>
          <ion-input type="password" placeholder=" Current Password" focus="true" formControlName="old_password"
            autocomplete="off"></ion-input>
        </ion-item>
        <div class="text-error text-danger"
          *ngIf="((changePasswordForm.controls.old_password.touched || changePasswordForm.controls.old_password.dirty) && changePasswordForm.controls.old_password.invalid) || isSubmitBtnClicked == true">
          <span class="text-danger" *ngIf="changePasswordForm.controls.old_password.errors?.required">*Please enter
            current password.</span>
        </div>
        <ion-item class="mt-3">
          <ion-label position="stacked">Enter New Password</ion-label>
          <ion-input type="password" placeholder=" New Password" formControlName="password" autocomplete="off">
          </ion-input>
        </ion-item>
        <div class="text-error text-danger"
          *ngIf="((changePasswordForm.controls.password.touched || changePasswordForm.controls.password.dirty) && changePasswordForm.controls.password.invalid) || isSubmitBtnClicked == true">
          <span class="text-danger" *ngIf="changePasswordForm.controls.password.errors?.required">*Please enter new
            password.</span>
            <span class="text-danger" *ngIf="changePasswordForm.controls.password.errors?.invalidPassword">*Password should be atleast 8 Characters which contains atleast 1 upper Character, 1 lower Character, 1 digit and 1 special Character</span>
        </div>
        <ion-item>
          <ion-label position="stacked">Confirm Password</ion-label>
          <ion-input type="password" placeholder=" New Password" formControlName="cpassword" autocomplete="off">
          </ion-input>
        </ion-item>
        <div class="text-error text-danger"
          *ngIf="((changePasswordForm.controls.cpassword.touched || changePasswordForm.controls.cpassword.dirty) && changePasswordForm.controls.cpassword.invalid) || isSubmitBtnClicked == true">
          <span class="text-danger" *ngIf="changePasswordForm.controls.cpassword.errors?.required">*Please enter new
            password again.</span>
          <span class="text-danger" *ngIf="changePasswordForm.controls.cpassword.errors?.mismatchedPasswords">*New password and confirm password must match.</span>
        </div>

      </ion-card>
      <ion-row class="ion-justify-content-center mt-3">
        <ion-button color="red" class="submitBtn" type="submit" expand="block">Change Password <ion-icon name="log-in">
          </ion-icon>
        </ion-button>
      </ion-row>
    </form>
  </div>
</ion-content>