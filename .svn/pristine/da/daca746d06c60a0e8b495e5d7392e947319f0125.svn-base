<ion-content >
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button auto-hide="false"></ion-menu-button>
    </ion-buttons>
    <ion-title class="logo-text">Split Reservation</ion-title>
    <ion-buttons slot="end">
      <ion-icon name="notifications-outline"></ion-icon>
    </ion-buttons>
  </ion-toolbar>
  <div class="content">
   
    <div class="cardHeight">
      <ion-card *ngFor="let data of cardData " class="mt-1">
        <ion-card-content>
          <ion-row style="padding-left: 46px;" *ngFor="let d of data.bookingDetails">
            <ion-col size="6">
              <ion-label class="label-key">{{d.key}}</ion-label><br>
            </ion-col>
            <ion-col size="6">
              <ion-label class="label-value">{{d.val}}</ion-label>
            </ion-col>
          </ion-row>
          <div class="guestCls">
            <ion-label class="user_Name">Guest Details</ion-label>
            <ion-item *ngFor="let item of data.guestList">
              <ion-label>{{item.key}}</ion-label>
              <ion-checkbox slot="end"></ion-checkbox>
            </ion-item>
          </div>
          <div class="text-center mb-2">
            <ion-button  [ngStyle]="{'color':'#0078FF','--background':'#E1EDFF','font-size':'72%','width':'23%'}">Split</ion-button>
          </div>
        </ion-card-content>
      </ion-card>
    </div>
  </div>
 
</ion-content>