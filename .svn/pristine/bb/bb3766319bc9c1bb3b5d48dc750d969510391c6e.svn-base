.background-img {
    --background: url('../../../../assets/beforelogin/background-img.svg') no-repeat center center/cover;
    height: 100vh;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    // filter: blur(8px);
}

.content {

    position: relative;

    .header-logo {
        width: 58vw;

        h1 {
            font-family: 'Exo 2';
            font-weight: 700;
            font-size: 26px;
            line-height: 34px;
            letter-spacing: 0.085em;
            text-transform: uppercase;
            color: #0F8D4B;
        }

        p {
            font-weight: 500;
            font-size: 16px;
            line-height: 19px;
            text-transform: capitalize;
            color: #FF8A00;
        }
    }

    .my-card {
        background: #F5FEF9;
        border: 0.957234px solid #A0E6A4;
        border-radius: 9px;
        margin-left: 20px;
        margin-right: 20px;
        margin-top: 0 !important;

        .my-cardheader {
            .my-cardtitle {
                font-weight: 600;
                font-family: 'lato' !important;
                font-size: 20px;
                line-height: 23px;
                color: #000000;
                text-transform: capitalize;
            }
        }

        .my-cardcontent {
            .card-field {
                height: auto;
                overflow-y: scroll;
                padding: 0px 5px;
            }

            .label {
                font-size: 17px;
                line-height: 16px;
                display: flex;
                color: #414042;
                margin-top: 14px;

                a {
                    font-weight: 600;
                    font-size: 15px;
                    line-height: 16px;
                    color: #0C7E40;
                }
            }

            ion-select,
            ion-input {
                background: linear-gradient(180deg, #FFFFFF 0%, #E9EEEA 80.21%);
                border: 0.892779px solid #A2E6A7;
                border-radius: 4.46389px;
                margin: 5px 0px;
            }

            ion-text {
                text-align: end;
                font-weight: 500;
                font-size: 13px;
                line-height: 15px;
                color: #22B263;
            }

            ion-button {
                --background: linear-gradient(180deg, #11BD63 0%, #077D3F 100%);
                box-shadow: 0px 1.78556px 3.57111px rgb(142 185 221 / 60%);
                border-radius: 4px;
                margin: 0px 0px 0px 0px;
            }

            .datetime-button {
                padding-top: 6px;
                padding-bottom: 6px;
                background: #A2E6A7;
                width: 100%;

                ion-datetime-button,
                input[type="date"] {
                    font-size: 100px;
                    left: 0;
                    opacity: 0;
                    position: absolute;
                    top: 0;
                }
            }

            .cd {
                ion-grid {
                    --ion-grid-padding: 0px !important;
                }

                ion-col {
                    --ion-grid-column-padding: 0px !important;
                }

                .captchaImg {
                    // border-radius: 5px;
                    height: calc(1.9em + 0.75rem + 2px);
                    width: 100%;
                    margin-top: 3px;
                    border-radius: 6px;
                }

                .refresh {
                    height: calc(1.9em + 0.75rem + 2.5px);
                    margin-top: 1px;
                    border-radius: 8px;
                    --background: rgb(227, 227, 227);
                    padding: 2px 0px 1px 0px;
                    margin-left: 6px;
                    box-shadow: none !important;

                    ion-icon {
                        font-weight: bold;
                        font-size: 25px;
                        color: #000000;
                    }
                }


            }
        }

    }
}