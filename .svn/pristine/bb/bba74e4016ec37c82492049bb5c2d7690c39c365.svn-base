<ion-toolbar>
  <ion-buttons slot="start">
    <ion-menu-button></ion-menu-button>
  </ion-buttons>
  <ion-title class="logo-text">Feedback List</ion-title>

  <!-- <ion-buttons slot="end">
    <ion-icon name="notifications-outline"></ion-icon>
  </ion-buttons> -->
</ion-toolbar>
<ion-content>
  <ion-card class="my-card" *ngFor="let item of FeedbackList">
    <ion-card-content class="contentClass">
      <ion-row style="padding-left: 6px;">
        <ion-col size="6">
          <ion-label class="label-key">Feedback Id</ion-label><br>
          <ion-label class="label-value">{{item.feedbackId}}</ion-label>
        </ion-col>
        <ion-col size="6">
          <ion-label class="label-key">Booking Id</ion-label><br>
          <ion-label class="label-value">{{item.bookingId}}</ion-label>
        </ion-col>
      </ion-row>
      <ion-row style="padding-left: 6px;">
        <ion-col size="6">
          <ion-label class="label-key">Name</ion-label><br>
          <ion-label class="label-value">{{item.name}}</ion-label>
        </ion-col>
        <ion-col size="6">
          <ion-label class="label-key">From Date</ion-label><br>
          <ion-label class="label-value">{{item.fromDate}}</ion-label>
        </ion-col>
      </ion-row>
      <ion-row style="padding-left: 6px;">
        <ion-col size="6">
          <ion-label class="label-key">To Date</ion-label><br>
          <ion-label class="label-value">{{item.toDate}}</ion-label>
        </ion-col>
        <ion-col size="6">
          <ion-label class="label-key">Guest House</ion-label><br>
          <ion-label class="label-value">{{item.ghName}}</ion-label>
        </ion-col>
      </ion-row>
      <ion-row style="padding-left: 6px;">
        <ion-col size="6">
          <ion-label class="label-key">Feedback Status</ion-label><br>
          <ion-label class="label-value">{{item.feedbackstatus}}</ion-label>
        </ion-col>
        <ion-col size="6">
          <ion-button
          [ngStyle]="{'color':'#FFFFFF','--background':'#083c8a','font-size':'smaller','font-weight':'600', 'width': '-webkit-fill-available'}"
          (click)="viewDetails(item)">
          View
        </ion-button>
        </ion-col>
      </ion-row>
    </ion-card-content>
  </ion-card>
  <!-- <div *ngIf="FeedbackList.length ==0">
    No data exist
  </div> -->
  <ng-container *ngIf="! FeedbackList?.length" lines="none">
    <div class="img-wrapper">
      <img class="noDataAvail" src="../../../../../../../assets/afterlogin/no-data-img.png" alt="">
      <p>No Data Available</p>
    </div>
  </ng-container>

</ion-content>