<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

	<!-- ============================== -->

	<!-- Append error messages to the file -->

	<!-- ============================== -->

	<appender name="FILE_ERROR" class="org.apache.log4j.DailyRollingFileAppender">
		<param name="File" value="/opt/apache-tomcat-7.0.34/logs/ngms_log/ngms_error.log" />
		<param name="datePattern" value="'.'yyyy-MM-dd" />
		<param name="encoding" value="UTF-8" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d{yyyy/MM/dd HH:mm:ss} %-5p [%t] [%C][%M] - %m%n" />
		</layout>
		<filter class="org.apache.log4j.varia.LevelRangeFilter">
			<param name="LevelMin" value="ERROR" />
		</filter>
	</appender>


	<!-- ============================== -->

	<!-- Append messages to the file -->

	<!-- ============================== -->

	<appender name="FILE_DEFAULT" class="org.apache.log4j.DailyRollingFileAppender">
		<param name="File" value="/var/www/html/essusr/logs/ess-log/ess_report.log" />
		<param name="encoding" value="UTF-8" />
		<param name="datePattern" value="'.'yyyy-MM-dd" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d{ABSOLUTE} %-5p [%c] %m%n" />
		</layout>
		<filter class="org.apache.log4j.varia.LevelRangeFilter">
			<param name="LevelMin" value="INFO" />
		</filter>
	</appender>

	<!-- ============================== -->

	<!-- Append info only messages to the file -->

	<!-- ============================== -->

	<appender name="FILE_REPORT" class="org.apache.log4j.DailyRollingFileAppender">
		<param name="File" value="/var/www/html/essusr/logs/ess-log/ess_info.log" />
		<param name="encoding" value="UTF-8" />
		<param name="datePattern" value="'.'yyyy-MM-dd" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d{ABSOLUTE} %-5p [%c] %m%n" />
		</layout>
		<filter class="org.apache.log4j.varia.LevelRangeFilter">
			<param name="LevelMin" value="INFO" />
			<param name="LevelMax" value="WARN" />
		</filter>
	</appender>


	<!-- ============================== -->

	<!-- Append messages to the console -->

	<!-- ============================== -->

	<appender name="CONSOLE_OUT" class="org.apache.log4j.ConsoleAppender">
		<param name="Target" value="System.out" />
		<param name="Threshold" value="TRACE" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%-5p %c{1} - %m%n" />
		</layout>
	</appender>


	<!-- ======================= -->

	<!-- Setup the Root category -->

	<!-- ======================= -->

	<root>
		<!-- <priority value="INFO" /> -->
		<!-- <appender-ref ref="MAIL" /> -->
		<appender-ref ref="CONSOLE_OUT" />
		<appender-ref ref="FILE_DEFAULT" />
		<appender-ref ref="FILE_ERROR" />
		<appender-ref ref="FILE_REPORT" />
	</root>

</log4j:configuration>