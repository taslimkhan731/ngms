<?xml version="1.0" encoding="iso-8859-1"?>
<project name="ngms" default="war" basedir=".">
    <description>Builds, tests, and runs the project ngms.</description>
                 
	<property name="projectname" value="ngms"/>
	<property name="src.dir" value="src"/>
	<property name="web.dir" value="web"/>
	<property name="class.dir" value="${web.dir}/WEB-INF/classes"/>
	<property name="lib.dir" value="lib"/>
	<property name="build.dir" value="dist"/>
                   <property file="${src.dir}/conf/D6.properties"/>
	<path id="master-classpath">
		<fileset dir="${web.dir}/WEB-INF/lib">
			<include name="*.jar"/>
		</fileset>
		<pathelement path="${class.dir}"/>
	</path>
                   <target name="clean" description="Clean output directories">
		<delete>
			<fileset dir="${build.dir}">
				<include name="**/*.class"/>
			</fileset>
		</delete>
	</target>
	<target name="war" description="Compile source tree java files">		
		<mkdir dir="dist"/>
		<delete>
			<fileset dir="${class.dir}">
				<include name="**/*.class"/>
                                                                          
			</fileset>
			<fileset dir="dist">
				<include name="*.war"/>
			</fileset>
		</delete>
		<javac destdir="${class.dir}" includeantruntime="false">
			<src path="${src.dir}"/>
			<classpath refid="master-classpath"/>
		</javac>
		
		
		<war destfile="dist/ngms.war" webxml="${web.dir}/WEB-INF/web.xml">
			<fileset dir="${web.dir}">
				<include name="**/*.*"/>
                                                                 
			</fileset>	
			<classes dir="${class.dir}/conf"  includes="D6.properties"/>		
			<classes dir="${class.dir}"/>
		</war>

	</target>
	
	<target name="compile" >
		<echo message="Compiling source code"/>
	</target>
	
</project>	